{
  "name": "bartelby",
  "version": "1.0.0",
  "description": "Bartelby — Historical Document Transcription",
  "main": "server.js",
  "engines": {
    "node": ">=25.9.0 <26"
  },
  "scripts": {
    "start": "node server.js",
    "setup:python": "python3 -m venv .venv && ./.venv/bin/python -m pip install --upgrade pip setuptools wheel && ./.venv/bin/python -m pip install -r requirements.txt",
    "seed": "node database/seed.js",
    "import": "node utils/import.js",
    "backfill:exact-authority-suggestions": "node scripts/backfill-exact-authority-suggestions.js",
    "migrate:turso": "node scripts/migrate-to-turso.js",
    "migrate:s3": "node scripts/migrate-uploads-to-s3.js",
    "lint": "eslint . --quiet",
    "lint:all": "eslint .",
    "test": "npm run test:hygiene && npm run lint && npm run test:unit && npm run test:integration",
    "test:hygiene": "node scripts/check-repo-hygiene.js",
    "test:curator-ui": "jest tests/integration/curator-ui-contracts.test.js --runInBand",
    "test:ux": "playwright test",
    "test:unit": "jest tests/unit --maxWorkers=50%",
    "test:integration": "jest tests/integration --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.venv/",
      "<rootDir>/.claude/",
      "<rootDir>/.claire/",
      "<rootDir>/.worktrees/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.venv/",
      "<rootDir>/.claude/",
      "<rootDir>/.claire/",
      "<rootDir>/.worktrees/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/.venv/",
      "<rootDir>/.claude/",
      "<rootDir>/.claire/",
      "<rootDir>/.worktrees/"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "database/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^2.0.14",
    "@ai-sdk/google-vertex": "^4.0.112",
    "@ai-sdk/openai": "^3.0.41",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@huggingface/transformers": "3.8.1",
    "@libsql/client": "^0.17.2",
    "@smithy/node-http-handler": "^4.5.0",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.1",
    "chart.js": "^4.5.1",
    "compression": "^1.8.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^5.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "ollama-ai-provider": "^1.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.1",
    "sharp": "^0.35.5",
    "sql.js": "^1.10.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "pdfjs-dist": {
      "canvas": "$canvas"
    },
    "@huggingface/transformers": {
      "sharp": "$sharp"
    }
  }
}
