{
  "name": "bartelby",
  "version": "1.0.0",
  "description": "Bartelby — Historical Document Transcription",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "setup:python": "python3 -m venv .venv && ./.venv/bin/python -m pip install --upgrade pip setuptools wheel && ./.venv/bin/python -m pip install -r requirements.txt",
    "seed": "node database/seed.js",
    "import": "node utils/import.js",
    "migrate:turso": "node scripts/migrate-to-turso.js",
    "migrate:s3": "node scripts/migrate-uploads-to-s3.js",
    "test": "npm run test:hygiene && jest",
    "test:hygiene": "node scripts/check-repo-hygiene.js",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.venv/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/.venv/"
    ],
    "collectCoverageFrom": [
      "utils/**/*.js",
      "routes/**/*.js",
      "middleware/**/*.js",
      "database/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^2.0.14",
    "@ai-sdk/google-vertex": "^4.0.112",
    "@ai-sdk/openai": "^3.0.41",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@libsql/client": "^0.17.2",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.1",
    "chart.js": "^4.5.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^5.0.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.5",
    "ollama-ai-provider": "^1.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "sharp": "^0.34.5",
    "sql.js": "^1.10.3",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
