# Copy this file to .env and fill in the values you want to use locally.

# Used to sign session cookies.
SESSION_SECRET=replace-with-a-random-secret

# Used to encrypt sensitive values stored in the database, such as provider API keys.
DATA_ENCRYPTION_KEY=replace-with-a-random-secret

# Optional runtime settings
# PORT=3000
# NODE_ENV=development
# DISABLE_BACKGROUND_WORKER=false

# Infrastructure drivers
# STORAGE_DRIVER=local
# DATABASE_DRIVER=sqljs
# PUBLIC_APP_URL=http://localhost:3000

# S3-compatible storage (required when STORAGE_DRIVER=s3)
# S3_BUCKET=bartelby
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# Turso database (required when DATABASE_DRIVER=turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token

# Optional provider credentials
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Optional SMTP settings for invitation emails and email-based MFA
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Bartelby <no-reply@example.com>
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
