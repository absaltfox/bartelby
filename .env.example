# Copy this file to .env and fill in the values you want to use locally.

# Used to sign session cookies.
SESSION_SECRET=replace-with-a-random-secret

# Used to encrypt sensitive values stored in the database, such as provider API keys.
DATA_ENCRYPTION_KEY=replace-with-a-random-secret

# One-time token required to create the initial administrator at /setup.
# Remove or rotate it after initial setup is complete.
BOOTSTRAP_ADMIN_TOKEN=replace-with-a-one-time-bootstrap-token

# Optional runtime settings
# PORT=3000
# NODE_ENV=development
# DISABLE_BACKGROUND_WORKER=false

# Infrastructure drivers
# STORAGE_DRIVER=local
# Database: unset picks better-sqlite3 (a local SQLite file) when it is
# installed. Other values: better-sqlite3, sqljs, turso.
# DATABASE_DRIVER=better-sqlite3

# Public base URL for absolute links in invite/reset emails.
# Set this in production so email links always use the canonical app URL.
# PUBLIC_APP_URL=http://localhost:3000

# Reverse proxy trust.
# In production, Bartelby assumes it is behind a trusted proxy or TLS terminator,
# so set TRUST_PROXY=1 (or another non-zero trusted proxy value that matches
# your topology).
# TRUST_PROXY=0 is only for direct local listeners outside production.
# TRUST_PROXY=1

# Single-machine plain-http installs only (docker-compose.yml sets it): lets
# NODE_ENV=production run without TLS by not marking cookies Secure. Never set
# it on anything reachable from a network.
# ALLOW_INSECURE_HTTP_IN_PRODUCTION=0

# Optional session store
# SESSION_STORE=memory
# REDIS_URL=redis://default:password@your-redis-host.upstash.io:6379

# S3-compatible storage (required when STORAGE_DRIVER=s3)
# S3_BUCKET=bartelby
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.example.com
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# Set to true for stores that need path-style URLs (most self-hosted ones).
# S3_FORCE_PATH_STYLE=false

# Turso database (required when DATABASE_DRIVER=turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-auth-token
# Reuse idle HTTPS connections between Turso requests. Defaults to false in
# processes that run the background worker and true in web-only processes.
# See DEPLOY.md (Turso connection reuse).
# TURSO_HTTP_KEEP_ALIVE=

# Lifetime of the in-process cache of public application settings, read by the
# page shell on every HTML request and every /uploads thumbnail. Admin settings
# writes invalidate it immediately, so this only bounds staleness when a second
# web machine performs the write. Set to 0 to disable the cache.
# SETTINGS_CACHE_TTL_MS=30000

# Optional provider credentials
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Worker heartbeat timeout — how long a job can go without a heartbeat before
# being considered abandoned and requeued. Defaults to 300000ms (5 minutes).
# WORKER_HEARTBEAT_TIMEOUT_MS=300000

# Optional SMTP settings for invitation emails and email-based MFA
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_FROM=Bartelby <no-reply@example.com>
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
