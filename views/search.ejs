<%- include('partials/header', { pageTitle: 'Search Results', query: query }) %>

<div class="search-page">
  <h1>Search Results</h1>
  <p class="search-advanced-link-row"><a href="/search/advanced">Open Advanced Search</a></p>

  <% if (query) { %>
    <p class="search-summary">Found <%= resultCount %> result<%= resultCount !== 1 ? 's' : '' %> for "<%= query %>"</p>
  <% } else { %>
    <p class="search-summary">Enter a search term to find documents by transcript content.</p>
  <% } %>

  <section class="entity-results-panel" data-graph-search data-search-query="<%= query %>" hidden>
    <div class="kg-panel-header">
      <div>
        <p class="kg-panel-eyebrow">Knowledge Graph</p>
        <h2>Matching entities</h2>
      </div>
      <p class="kg-panel-meta" data-entity-results-count>Loading...</p>
    </div>
    <div class="kg-panel-empty" data-entity-results-empty>
      No entity matches yet.
    </div>
    <div class="entity-results-list" data-entity-results-list hidden></div>
  </section>

  <% if (results.length > 0) { %>
    <div class="search-results">
      <% results.forEach(result => { %>
        <article class="search-result">
          <h2><a href="/documents/<%= result.document_id %>?transcript=<%= result.id %>"><%= result.document_title %></a></h2>
          <p class="result-transcriber">Transcribed by: <%= result.transcriber || 'Unknown' %> (v<%= result.version %>)</p>
          <p class="result-snippet"><%- result.snippet %></p>
        </article>
      <% }) %>
    </div>
  <% } else if (query) { %>
    <div class="no-results">
      <p>No documents found matching your search.</p>
      <p>Try different keywords or check your spelling.</p>
    </div>
  <% } %>
</div>

<script src="/js/graph-explorer.js"></script>

<%- include('partials/footer') %>
