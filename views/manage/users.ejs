<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page">
  <%- include('../partials/manage-nav') %>
  <%- include('../partials/manage-collection-nav', {
    collection,
    heading: 'User Access — ' + collection.name,
    subtitle: 'Manage who can access this collection and what they can do.',
    activePage: 'users'
  }) %>

  <% if (saved) { %>
    <div class="alert alert-success">Access updated successfully.</div>
  <% } %>

  <div class="settings-section">
    <h2>Current Access</h2>

    <% if (grantedUsers.length > 0) { %>
      <div class="users-table-wrap">
        <table class="users-table">
          <thead>
            <tr>
              <th scope="col">User</th>
              <th scope="col">Role</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% grantedUsers.forEach(function(u) { %>
              <tr>
                <td>
                  <strong><%= u.username %></strong>
                  <% if (u.email) { %><br><small class="muted"><%= u.email %></small><% } %>
                </td>
                <td>
                  <span class="role-badge role-<%= u.collection_role || 'viewer' %> manage-users-role-badge"><%= u.collection_role || 'viewer' %></span>
                </td>
                <td>
                  <% if (u.id !== currentUser.id) { %>
                    <button type="button" class="btn-action btn-sm edit-role-btn"
                      data-user-id="<%= u.id %>"
                      data-username="<%= u.username %>"
                      data-role="<%= u.collection_role || 'viewer' %>">Edit</button>
                    <form method="POST" action="/manage/collections/<%= collection.id %>/users/<%= u.id %>/revoke" class="inline-form" data-confirm="Revoke access for <%= u.username %>?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn-action btn-delete btn-sm">Revoke</button>
                    </form>
                  <% } else { %>
                    <span class="muted manage-users-self">you</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted manage-users-empty">No users have been granted access to this collection.</p>
    <% } %>

    <% if (eligible.length > 0) { %>
      <h2 class="manage-users-grant-title">Grant Access</h2>
      <form method="POST" action="/manage/collections/<%= collection.id %>/users/grant" class="access-grant-form manage-users-grant-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="user_id" required class="manage-users-grant-select">
          <option value="">Select a user</option>
          <% eligible.forEach(function(u) { %>
            <option value="<%= u.id %>"><%= u.username %><% if (u.email) { %> (<%= u.email %>)<% } %></option>
          <% }) %>
        </select>
        <select name="role">
          <option value="viewer">Viewer</option>
          <option value="editor">Editor</option>
        </select>
        <button type="submit" class="btn-primary btn-sm">Grant Access</button>
      </form>
    <% } else { %>
      <p class="muted manage-users-note">All eligible users already have access.</p>
    <% } %>

    <p class="field-hint manage-users-hint">
      Users with <em>Access All</em> or the <em>admin</em> role always have access regardless of these grants.
      As a collection manager, you can grant Viewer or Editor access.
    </p>
  </div>
</div>

<!-- Edit Role Modal -->
<div class="tag-modal-overlay is-hidden" id="role-modal">
  <div class="tag-modal tag-modal--wide">
    <div class="tag-modal-header">
      <h3 id="role-modal-title">Edit Role</h3>
      <button type="button" class="tag-modal-close" id="role-modal-close">&times;</button>
    </div>
    <form method="POST" action="/manage/collections/<%= collection.id %>/users/grant" id="role-modal-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="user_id" id="role-modal-user-id" value="">
      <div class="tag-modal-body tag-modal-body--spacious">
        <p class="manage-users-modal-intro">Choose a permission level for <strong id="role-modal-username"></strong>:</p>

        <label class="role-option manage-users-role-choice">
          <input type="radio" name="role" value="viewer">
          <strong>Viewer</strong>
          <p class="field-hint manage-users-role-copy">Can browse documents and read transcriptions in this collection. Cannot edit or create content.</p>
        </label>

        <label class="role-option manage-users-role-choice">
          <input type="radio" name="role" value="editor">
          <strong>Editor</strong>
          <p class="field-hint manage-users-role-copy">Can browse, edit, and create transcriptions for documents in this collection. Cannot manage users or collection settings.</p>
        </label>
      </div>
      <div class="tag-modal-footer">
        <button type="button" class="btn-action btn-sm" id="role-modal-cancel">Cancel</button>
        <button type="submit" class="btn-primary btn-sm">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/manage-users.js"></script>

<%- include('../partials/footer') %>
