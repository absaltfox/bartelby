<%#
  Collection-scoped authority-link suggestions queue (manage surface).

  Wraps partials/knowledge/authority-suggestions-list.ejs.

  Per docs/superpowers/specs/2026-06-26-collection-scoped-knowledge-workbench-design.md
  (List + queue pages) and docs/superpowers/plans/2026-06-26-collection-
  scoped-knowledge-workbench.md (Task 3.6).
%>
<%- include('../../../partials/header', { pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../../../partials/manage-collection-nav', { collection, heading: collection.name, activePage: 'knowledge' }) %>
  <%- include('../../../partials/knowledge-nav', { activeKnowledgePage, urlPrefix, isAdmin }) %>

  <section class="manage-knowledge-page">
    <header class="manage-knowledge-page-header">
      <a href="<%= urlPrefix %>" class="back-link">&larr; Knowledge dashboard</a>
      <h2><%= surfaceTitle %></h2>
      <p class="subtitle">Pending authority-link suggestions for entities cited in this collection.</p>
    </header>

    <%- include('../../../partials/knowledge/authority-suggestions-list', {
      suggestions,
      decisionUnits,
      status,
      matchMethodFilter,
      nextCursor,
      groupedTruncated,
      groupedTotalUnits,
      urlPrefix
    }) %>
  </section>
</div>

<%#
  authority-suggestions-list carries bulk toolbar + per-card decision
  buttons wired by /js/admin-authority-suggestions.js. Without the
  bootstrap + script tags the queue renders but clicks silently no-op.
  Bulk POSTs land on the admin endpoints, which PR 4 relaxed to accept
  collection managers.
%>
<script type="application/json" id="suggestions-bootstrap">
  <%- JSON.stringify({ status: status, matchMethodFilter: matchMethodFilter, pageSize: pageSize }) %>
</script>
<script src="/js/admin-authority-suggestions.js"></script>

<%- include('../../../partials/footer') %>
