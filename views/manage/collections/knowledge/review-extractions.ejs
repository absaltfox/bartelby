<%#
  Collection-scoped review-extractions queue (manage/curator surface).

  Wraps the shared partials/knowledge/review-extractions-list.ejs partial
  with a manage-collection-nav + knowledge-workbench-rail composition.

  Per docs/superpowers/specs/2026-06-26-collection-scoped-knowledge-workbench-design.md
  (List + queue pages, Shell composition) and
  docs/superpowers/plans/2026-06-26-collection-scoped-knowledge-workbench.md
  (Task 3.6).
%>
<%- include('../../../partials/header', { pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../../../partials/manage-collection-nav', { collection, heading: collection.name, activePage: 'knowledge' }) %>
  <%- include('../../../partials/knowledge-nav', { activeKnowledgePage, urlPrefix, isAdmin }) %>

  <section class="manage-knowledge-page">
    <header class="manage-knowledge-page-header">
      <a href="<%= urlPrefix %>" class="back-link">&larr; Knowledge dashboard</a>
      <h2><%= surfaceTitle %></h2>
      <p class="subtitle">Approve, reject, or revisit extracted evidence scoped to this collection.</p>
    </header>

    <%- include('../../../partials/knowledge/review-extractions-list', {
      reviewItems,
      approvalStatus,
      reviewKind,
      reviewKindLabel,
      totalCount,
      totalPages,
      currentPage,
      csrfToken,
      urlPrefix
    }) %>
  </section>
</div>

<%#
  The review-extractions list partial carries data-attribute hooks
  (data-review-preview-trigger, data-review-action-form) and the bulk
  toolbar that /js/review-extractions.js and /js/review-extractions-bulk.js
  drive. Without these scripts the preview overlay never opens and bulk
  selection is a dead UI. Bulk URLs point at the admin endpoints because
  the manage router does not (yet) mount its own bulk routes — PR 4
  relaxed the admin endpoints to accept collection managers, so a
  manager's request lands on the same handler an admin would hit.
%>
<script id="review-extractions-config" type="application/json"><%- JSON.stringify({
  bulkApproveUrl: '/admin/knowledge/review-extractions/bulk/approve',
  bulkRejectUrl: '/admin/knowledge/review-extractions/bulk/reject',
  bulkDeleteUrl: '/admin/knowledge/review-extractions/bulk/delete',
  csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : null
}).replace(/</g, '\\u003c') %></script>
<script src="/js/review-extractions.js"></script>
<script src="/js/review-extractions-bulk.js"></script>

<%- include('../../../partials/footer') %>
