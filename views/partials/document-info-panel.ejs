<%
  var hasDocumentImages = Array.isArray(comparisonPages) && comparisonPages.some(function(page) { return page && page.imagePath; });
%>
<div class="side-by-side <%= hasDocumentImages ? '' : 'side-by-side--text-first' %>">
  <% if (hasDocumentImages) { %>
  <div class="image-panel">
    <h2>Original Document</h2>
    <div class="comparison-page-stack image-page-stack" id="image-page-stack">
      <% if (comparisonPages && comparisonPages.length > 0) { %>
        <% comparisonPages.forEach(function(page, index) { %>
          <section class="comparison-page-block <%= index === 0 ? 'active' : 'is-hidden' %>" data-page-number="<%= page.pageNumber %>">
            <% if (comparisonPages.length > 1) { %>
              <div class="comparison-page-label">Page <%= page.pageNumber %></div>
            <% } %>
            <div class="image-container">
              <% if (page.imagePath) { %>
                <img
                  <% if (index === 0) { %>src="<%= page.imagePath %>"<% } else { %>data-src="<%= page.imagePath %>"<% } %>
                  alt="<%= document.title %> — Page <%= page.pageNumber %>"
                  class="document-image"
                  loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                  decoding="async"
                  data-fallback-message="Image not available">
              <% } else { %>
                <div class="no-image">No image available</div>
              <% } %>
            </div>
          </section>
        <% }) %>
      <% } else { %>
        <div class="image-container">
          <div class="no-image">No image available</div>
        </div>
      <% } %>
    </div>

    <%- include('document-metadata-section') %>
  </div>
  <% } else { %>
    <section class="document-text-first-metadata">
      <%- include('document-metadata-section') %>
    </section>
  <% } %>

  <div class="transcript-panel">
    <%- include('document-transcript-panel') %>
  </div>
</div>
