<%
  // Shared sentiment chip set. Renders the typed chips for an annotation:
  // label (curator vocabulary), polarity, intensity, voice role, and a quiet
  // register chip when the annotation is marked conventional (F1 of
  // docs/2026-07-05-epistolary-register-design.md — no chip for 'personal'
  // or NULL/unclassified).
  // Per docs/sentiment-design.md non-negotiables: voice role is first-class,
  // Plutchik is never surfaced.
  //
  // Locals:
  //   annotation { label_name, polarity, intensity, voice_role, register }
  //   showLabel  (optional, default true)  — set false in contexts that already show the label
  //   compact    (optional, default false) — reduced size for inline use
  var ann = typeof annotation !== 'undefined' && annotation ? annotation : {};
  var includeLabel = typeof showLabel === 'undefined' ? true : showLabel;
  var isCompact = typeof compact !== 'undefined' && compact;
  var labelText = ann.label_name || 'Unlabeled';
  var labelTone = ann.label_name ? 'set' : 'unset';
  var polarity = ann.polarity || 'neutral';
  var intensity = ann.intensity || 'low';
  var voiceRole = ann.voice_role || 'author';
  var voiceLabel = voiceRole === 'described_subject' ? 'described subject'
                  : voiceRole === 'speaker' ? 'speaker'
                  : 'author';
  var voiceTitle = voiceRole === 'author'
    ? "Writer's own feeling"
    : voiceRole === 'speaker'
      ? 'Feeling reported by someone the writer quotes'
      : "Feeling the writer ascribes to a third party";
%>
<span class="s-chipset <%= isCompact ? 's-chipset--compact' : '' %>">
  <% if (includeLabel) { %>
    <span class="s-chip s-chip--label s-chip--label-<%= labelTone %>"><%= labelText %></span>
  <% } %>
  <span class="s-chip s-chip--polarity s-chip--polarity-<%= polarity %>"><%= polarity %></span>
  <span class="s-chip s-chip--intensity s-chip--intensity-<%= intensity %>"><%= intensity %></span>
  <span class="s-chip s-chip--voice s-chip--voice-<%= voiceRole %>" title="<%= voiceTitle %>"><%= voiceLabel %></span>
  <% if (ann.register === 'conventional') { %>
    <span class="s-chip s-chip--register s-chip--register-conventional"
          title="Formulaic epistolary performance (prescribed opening, deference marker, closing, or stock formula) — register describes the form, not sincerity">conventional</span>
  <% } %>
</span>
