<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' — ' : '' %><%= appName || 'Bartelby' %></title>
  <link rel="icon" type="image/svg+xml" href="<%= appFaviconDataUri || '' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">
        <span class="logo-mark">
          <img src="<%= appLogoDataUri || '' %>" alt="" aria-hidden="true">
        </span>
        <%= appName || 'Bartelby' %>
      </a>
      <div class="header-controls">
        <nav class="main-nav header-primary-nav">
          <a href="/" class="nav-pill" data-section="collection">Collections</a>
          <% if (typeof isManager !== 'undefined' && isManager && !isAdmin) { %>
            <a href="/manage" class="nav-pill" data-section="manage">Manage</a>
          <% } %>
          <% if (isAdmin) { %>
            <a href="/admin" class="nav-pill" data-section="admin">Admin</a>
          <% } %>
        </nav>

        <div class="header-utility-nav">
          <div class="header-search-tools">
            <form action="/search" method="GET" class="search-form">
              <input type="search" name="q" placeholder="Search transcripts…" value="<%= typeof query !== 'undefined' ? query : '' %>">
              <button type="submit">Search</button>
            </form>
            <a href="/search/advanced" class="nav-search-link">Advanced Search</a>
          </div>

          <% if (currentUser) { %>
            <div class="user-menu" id="user-menu">
              <button type="button" class="user-menu-toggle" id="user-menu-toggle" aria-expanded="false" aria-controls="user-menu-panel">
                <span class="user-menu-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" role="img" focusable="false">
                    <path d="M12 12.2a4.1 4.1 0 1 0-4.1-4.1 4.1 4.1 0 0 0 4.1 4.1Zm0 2c-4 0-7.2 2.1-7.2 4.7 0 .5.4.9.9.9h12.6a.9.9 0 0 0 .9-.9c0-2.6-3.2-4.7-7.2-4.7Z" fill="currentColor"/>
                  </svg>
                </span>
                <span class="sr-only">Account</span>
                <span class="user-menu-name"><%= currentUser.username %></span>
              </button>
              <div class="user-menu-panel" id="user-menu-panel" hidden>
                <a href="/account" class="user-menu-link">Profile</a>
                <form method="POST" action="/logout" class="user-menu-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="user-menu-link user-menu-button">Sign out</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <a href="/login" class="nav-login-link">Sign in</a>
          <% } %>
        </div>
      </div>
    </div>
  </header>
  <main class="container">
