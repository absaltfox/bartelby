<%
  const knowledgeGroups = [
    {
      label: 'Overview',
      items: [
        { key: 'overview', href: '/admin/knowledge', label: 'Overview' }
      ]
    },
    {
      label: 'Review',
      items: [
        { key: 'review-extractions', href: '/admin/knowledge/review-extractions', label: 'Entity Evidence Review' },
        { key: 'authority-suggestions', href: '/admin/knowledge/authorities/suggestions', label: 'Authority-Entity Review' },
        { key: 'sentiment-review', href: '/admin/knowledge/sentiment/review', label: 'Sentiment Review' }
      ]
    },
    {
      label: 'Correct',
      items: [
        { key: 'entities', href: '/admin/knowledge/entities', label: 'Entities' },
        { key: 'merge-entities', href: '/admin/knowledge/entities/merge', label: 'Entity Merge' },
        { key: 'authorities', href: '/admin/knowledge/authorities', label: 'Authorities' }
      ]
    },
    {
      label: 'Reconcile',
      items: [
        { key: 'sentiment-phrase-targets', href: '/admin/knowledge/sentiment/phrase-targets', label: 'Phrase Targets' },
        { key: 'authority-generic-terms', href: '/admin/knowledge/authorities/generic-terms', label: 'Generic Terms' },
        { key: 'sentiment-clusters', href: '/admin/knowledge/sentiment/clusters', label: 'Sentiment Clusters' }
      ]
    },
    {
      label: 'Maintain',
      items: [
        { key: 'vocabularies', href: '/admin/knowledge/vocabularies/relationship-types', label: 'Vocabularies' },
        { key: 'authority-backfill', href: '/admin/knowledge/authorities/backfill', label: 'Authority Backfill' }
      ]
    }
  ];
%>
<nav class="knowledge-workbench-rail" aria-label="Knowledge workbench">
  <% knowledgeGroups.forEach(function(group) { %>
    <section class="knowledge-workbench-group" aria-labelledby="knowledge-workbench-<%= group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>">
      <h2 class="knowledge-workbench-group-title" id="knowledge-workbench-<%= group.label.toLowerCase().replace(/[^a-z0-9]+/g, '-') %>"><%= group.label %></h2>
      <div class="knowledge-workbench-links">
        <% group.items.forEach(function(item) { %>
          <a href="<%= item.href %>" class="knowledge-workbench-link <%= activeKnowledgePage === item.key ? 'active' : '' %>" <%= activeKnowledgePage === item.key ? 'aria-current="page"' : '' %>><%= item.label %></a>
        <% }) %>
      </div>
    </section>
  <% }) %>
</nav>
