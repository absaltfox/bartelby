<script>
(function() {
  var p = window.location.pathname;
  document.querySelectorAll('.admin-subnav-link').forEach(function(a) {
    var page = a.dataset.page;
    if (page === 'dashboard' && p === '/admin') a.classList.add('active');
    else if (page === 'dashboard') return;
    else if (p.startsWith('/admin/' + page)) a.classList.add('active');
  });
})();
</script>
