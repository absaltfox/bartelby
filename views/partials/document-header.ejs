<div class="document-topbar">
  <a href="<%= backHref %>" class="back-link">&larr; Back to Documents</a>
</div>

<div class="document-title-row">
  <div class="document-title-content">
    <h1 id="doc-title-display"><%= document.title %></h1>
    <% const documentLocation = document.metadata && document.metadata.location ? document.metadata.location : ''; %>
    <% if (document.date_created || documentLocation) { %>
      <p class="document-date">
        <% if (document.date_created) { %>
          <span id="doc-date-display"><%= document.date_created %></span>
        <% } %>
        <% if (document.date_created && documentLocation) { %>, <% } %>
        <% if (documentLocation) { %>
          <span id="doc-location-display"><%= documentLocation %></span>
        <% } %>
      </p>
    <% } %>
    <% if (typeof allowExport !== 'undefined' && allowExport) { %>
      <p class="export-context-note">
        Export is enabled for this document through
        <strong><%= exportEnabledCollections.length === 1 ? exportEnabledCollections[0] : exportEnabledCollections.join(', ') %></strong>.
      </p>
    <% } %>
  </div>
  <div class="document-title-actions">
    <% if (typeof allowExport !== 'undefined' && allowExport) { %>
      <div class="export-dropdown">
        <button type="button" class="btn-action btn-sm export-dropdown-toggle">Export &darr;</button>
        <div class="export-dropdown-menu">
          <a href="/export/documents/<%= document.id %>/pdf">Export PDF</a>
          <a href="/export/documents/<%= document.id %>/tei">Export TEI XML</a>
        </div>
      </div>
    <% } %>
    <% if (typeof canEdit !== 'undefined' && canEdit) { %>
      <div class="mode-toggle" id="mode-toggle">
        <button type="button" class="mode-toggle-btn active" data-mode="view">View</button>
        <button type="button" class="mode-toggle-btn" data-mode="edit">Edit</button>
      </div>
    <% } %>
  </div>
</div>

<% if (pendingJob) { %>
  <div
    class="transcription-pending-banner"
    id="transcription-pending-banner"
    data-job-status-url="<%= jobStatusUrl || '' %>"
    data-jobs-href="<%= jobsHref || '' %>">
    <span class="pending-icon">&#9203;</span>
    <strong>Transcription <%= pendingJob.status === 'running' ? 'in progress' : 'queued' %>.</strong>
    This document is being transcribed in the background.<% if (jobsHref) { %>
    <a href="<%= jobsHref %>">View jobs</a><% } %>
  </div>
<% } %>

<div class="doc-tabs" id="doc-tabs">
  <button type="button" class="doc-tab active" data-tab="info">Document</button>
  <button type="button" class="doc-tab" data-tab="history">History</button>
</div>

<% if (comparisonPages && comparisonPages.length > 1) { %>
  <div class="comparison-toolbar" id="comparison-toolbar">
    <div class="comparison-toolbar-copy">
      <strong>Page Comparison</strong>
      <span>View one page at a time, or switch to all pages for a full-document read-through.</span>
    </div>
    <div class="comparison-toolbar-controls">
      <div class="comparison-page-nav" id="comparison-page-nav">
        <% comparisonPages.forEach(function(page, index) { %>
          <button
            type="button"
            class="comparison-page-chip <%= index === 0 ? 'active' : '' %>"
            data-page-number="<%= page.pageNumber %>">
            Page <%= page.pageNumber %>
          </button>
        <% }) %>
      </div>
      <button type="button" class="btn-secondary btn-sm" id="comparison-toggle-view">Show All Pages</button>
    </div>
  </div>
<% } %>
