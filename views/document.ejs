<%- include('partials/header', { pageTitle: document.title, query: '' }) %>

<div class="document-detail" id="document-detail" data-doc-id="<%= document.id %>" data-can-edit="<%= (typeof canEdit !== 'undefined' && canEdit) ? '1' : '' %>" data-can-manage="<%= (typeof canManage !== 'undefined' && canManage) ? '1' : '' %>">
  <%- include('partials/document-header') %>

  <div class="doc-tab-content active" id="tab-info">
    <% if (comparisonPages && comparisonPages.length > 1) { %>
      <div class="comparison-toolbar" id="comparison-toolbar">
        <div class="comparison-toolbar-copy">
          <strong>Page Comparison</strong>
          <span>View one page at a time, or switch to all pages for a full-document read-through.</span>
        </div>
        <div class="comparison-toolbar-controls">
          <div class="comparison-page-nav" id="comparison-page-nav">
            <% comparisonPages.forEach(function(page, index) { %>
              <button
                type="button"
                class="comparison-page-chip <%= index === 0 ? 'active' : '' %>"
                data-page-number="<%= page.pageNumber %>">
                Page <%= page.pageNumber %>
              </button>
            <% }) %>
          </div>
          <button type="button" class="btn-secondary btn-sm" id="comparison-toggle-view">Show All Pages</button>
        </div>
      </div>
    <% } %>
    <%- include('partials/document-info-panel') %>
  </div>

  <div class="doc-tab-content is-hidden" id="tab-knowledge">
    <%- include('partials/document-knowledge-tab') %>
  </div>

  <% if (hasSentiment) { %>
    <div class="doc-tab-content is-hidden" id="tab-sentiment">
      <%- include('partials/document-sentiment-tab', {
        document: document,
        summary: sentimentSummary
      }) %>
    </div>
  <% } %>

  <%- include('partials/document-history-tab') %>
</div>

<%- include('partials/document-new-transcript-modal') %>

<script src="/js/document-page.js"></script>
<script src="/js/graph-explorer.js"></script>
<script src="/js/document-selection-prefill.js"></script>
<% if (hasSentiment) { %>
  <script>
    window.__sentimentDocumentTab = {
      documentId: <%= document.id %>,
      isAdmin: <%= (typeof canManage !== 'undefined' && canManage) ? 'true' : 'false' %>
    };
  </script>
  <script src="/js/sentiment-card-renderer.js"></script>
  <script src="/js/sentiment-document-tab.js"></script>
<% } %>

<%- include('partials/footer') %>
