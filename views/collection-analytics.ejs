<%- include('partials/header', { pageTitle: pageTitle, query: '' }) %>
<%
function formatBytes(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1024 * 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
}
%>

<%- include('partials/collection-hero', {
  collection: collection,
  latestAnalytics: latestAnalytics,
  activeTab: 'analytics',
  showGraphTab: !!currentUser,
  currentUser: currentUser
}) %>

<%
  var hasAnalytics = !!analytics;
  var hasSentiment = sentimentSummary && sentimentSummary.length > 0;
  // Per the Phase 4 plan, the Sentiment subtab does not require a
  // BERTopic analytics run — sentiment can be the only analytics-view
  // tab if that's what the collection has.
%>
<% if (!hasAnalytics && !hasSentiment) { %>
  <div class="analytics-empty">
    <p>No analytics have been computed for this collection yet.</p>
    <p class="muted">Analytics run on a schedule. An admin can trigger a manual run from
      <a href="/admin/analytics-settings">Admin → Analytics</a>.</p>
  </div>
<% } else { %>

  <div class="analytics-toolbar">
    <div class="analytics-toolbar-nav">
      <div class="analytics-toolbar-label">Analytics View</div>
      <div class="analytics-subtabs" role="tablist" aria-label="Analytics views">
        <% if (hasAnalytics) { %>
          <button type="button" class="analytics-subtab analytics-subtab-active" data-tab="dashboard" aria-selected="true">Dashboard</button>
          <button type="button" class="analytics-subtab" data-tab="topics" aria-selected="false">Topics</button>
        <% } %>
        <% if (hasSentiment) { %>
          <button type="button" class="analytics-subtab <%= hasAnalytics ? '' : 'analytics-subtab-active' %>" data-tab="sentiment" aria-selected="<%= hasAnalytics ? 'false' : 'true' %>">Sentiment</button>
        <% } %>
      </div>
    </div>
    <% if (hasAnalytics) { %>
      <div class="analytics-updated">
        Last computed: <%= new Date(analytics.computed_at).toLocaleString() %>
      </div>
    <% } %>
  </div>

  <% if (hasAnalytics) { %>
  <!-- Dashboard tab -->
  <div class="analytics-tab-panel" id="tab-dashboard">
    <div class="analytics-stat-grid">
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.document_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Documents</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= formatBytes(analytics.storage_bytes) %></div>
        <div class="analytics-stat-label">Storage</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.transcribed_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Transcribed</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.untranscribed_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Untranscribed</div>
      </div>
      <% if (currentUser) { %>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.total_cost_usd != null) { %>
            $<%= analytics.total_cost_usd.toFixed(4) %>
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Total Transcription Cost</div>
      </div>
      <% } %>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.avg_confidence != null) { %>
            <%= Math.round(analytics.avg_confidence) %>%
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Avg. Confidence</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.avg_unknown_words != null) { %>
            <%= analytics.avg_unknown_words.toFixed(1) %>
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Avg. Unknown Words / Doc</div>
      </div>
    </div>
  </div>

  <!-- Topics tab -->
  <div class="analytics-tab-panel" id="tab-topics" hidden>
    <% if (!analytics.topics_computed || topics.length === 0) { %>
      <div class="analytics-empty">
        <p>Topics have not been computed for this collection.</p>
        <p class="muted">Topics require at least 5 transcribed documents and are generated during the scheduled analytics run.</p>
      </div>
    <% } else { %>

      <!-- Document Similarity Cluster Chart -->
      <section class="analytics-section">
        <h2>Document Similarity Clusters</h2>
        <p class="analytics-section-subtitle">Documents positioned by semantic similarity. Colour indicates topic.</p>
        <div id="cluster-chart" class="analytics-chart-container"></div>
      </section>

      <!-- Topic Hierarchy -->
      <section class="analytics-section">
        <h2>Topic Groups</h2>
        <p class="analytics-section-subtitle">Topics grouped by similarity — related topics are shown together.</p>
        <div id="topic-hierarchy-tree"></div>
      </section>

      <!-- Topic Evolution -->
      <% if (evolution.length > 0) { %>
      <section class="analytics-section">
        <h2>Topic Evolution Over Time</h2>
        <p class="analytics-section-subtitle">How topic prevalence has changed across document dates.</p>
        <canvas id="evolution-chart" class="analytics-chart-canvas"></canvas>
      </section>
      <% } %>

    <% } %>
  </div>
  <% } %>

  <!-- Sentiment tab -->
  <% if (hasSentiment) { %>
    <div class="analytics-tab-panel" id="tab-sentiment" <%= hasAnalytics ? 'hidden' : '' %>>
      <section class="analytics-section">
        <h2 class="analytics-section-title">Sentiment in this collection</h2>
        <p class="analytics-section-subtitle">Approved emotion annotations across the collection's documents. Click any evidence quote to open it in the source document.</p>
        <%- include('partials/sentiment-panel', {
          summary: sentimentSummary,
          heading: 'Label distribution',
          maxRows: 12
        }) %>
        <% if (sentimentList && sentimentList.length > 0) { %>
          <h3 class="analytics-section-subheading">Recent evidence</h3>
          <ol class="s-card-list">
            <% sentimentList.forEach(function(ann) { %>
              <li class="s-card-list-item">
                <%- include('partials/sentiment-card', {
                  annotation: ann,
                  showDocument: true,
                  canFlag: (currentUser && currentUser.role === 'admin')
                }) %>
              </li>
            <% }) %>
          </ol>
          <p class="analytics-section-more">
            <a href="/sentiment?collection=<%= collectionId %>">View all in research workbench &rarr;</a>
          </p>
        <% } %>
      </section>
    </div>
  <% } %>

<% } %>

<!-- Inline data for charts (chart code is defensive — initCharts no-ops
     when topics aren't computed; tab-switching JS lives in the same file
     and is needed any time we render the toolbar). -->
<% if (analytics && analytics.topics_computed) { %>
  <script id="analytics-data" type="application/json"><%- JSON.stringify({
    assignments: assignments,
    topics: topics,
    hierarchyData: hierarchyData || [],
    evolution: evolution
  }).replace(/</g, '\\u003c') %></script>
  <script src="/chart.umd.min.js"></script>
<% } %>
<% if (hasAnalytics || hasSentiment) { %>
  <script src="/js/collection-analytics.js"></script>
<% } %>

<% if (hasSentiment && currentUser && currentUser.role === 'admin') { %>
  <script src="/js/sentiment-card-renderer.js"></script>
<% } %>

<%- include('partials/footer') %>
