<%- include('partials/header', { pageTitle: pageTitle, query: '' }) %>
<%
function formatBytes(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1024 * 1024 * 1024) return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  return (bytes / (1024 * 1024 * 1024)).toFixed(2) + ' GB';
}
%>

<%- include('partials/collection-hero', {
  collection: collection,
  latestAnalytics: latestAnalytics,
  activeTab: 'analytics'
}) %>

<% if (!analytics) { %>
  <div class="analytics-empty">
    <p>No analytics have been computed for this collection yet.</p>
    <p class="muted">Analytics run on a schedule. An admin can trigger a manual run from
      <a href="/admin/analytics-settings">Admin → Analytics</a>.</p>
  </div>
<% } else { %>

  <div class="analytics-toolbar">
    <div class="analytics-toolbar-nav">
      <div class="analytics-toolbar-label">Analytics View</div>
      <div class="analytics-subtabs" role="tablist" aria-label="Analytics views">
        <button type="button" class="analytics-subtab analytics-subtab-active" data-tab="dashboard" aria-selected="true">Dashboard</button>
        <button type="button" class="analytics-subtab" data-tab="topics" aria-selected="false">Topics</button>
      </div>
    </div>
    <div class="analytics-updated">
      Last computed: <%= new Date(analytics.computed_at).toLocaleString() %>
    </div>
  </div>

  <!-- Dashboard tab -->
  <div class="analytics-tab-panel" id="tab-dashboard">
    <div class="analytics-stat-grid">
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.document_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Documents</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= formatBytes(analytics.storage_bytes) %></div>
        <div class="analytics-stat-label">Storage</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.transcribed_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Transcribed</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value"><%= analytics.untranscribed_count.toLocaleString() %></div>
        <div class="analytics-stat-label">Untranscribed</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.total_cost_usd != null) { %>
            $<%= analytics.total_cost_usd.toFixed(4) %>
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Total Transcription Cost</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.avg_confidence != null) { %>
            <%= Math.round(analytics.avg_confidence) %>%
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Avg. Confidence</div>
      </div>
      <div class="analytics-stat-card">
        <div class="analytics-stat-value">
          <% if (analytics.avg_unknown_words != null) { %>
            <%= analytics.avg_unknown_words.toFixed(1) %>
          <% } else { %>—<% } %>
        </div>
        <div class="analytics-stat-label">Avg. Unknown Words / Doc</div>
      </div>
    </div>
  </div>

  <!-- Topics tab -->
  <div class="analytics-tab-panel" id="tab-topics" hidden>
    <% if (!analytics.topics_computed || topics.length === 0) { %>
      <div class="analytics-empty">
        <p>Topics have not been computed for this collection.</p>
        <p class="muted">Topics require at least 5 transcribed documents and are generated during the scheduled analytics run.</p>
      </div>
    <% } else { %>

      <!-- Document Similarity Cluster Chart -->
      <section class="analytics-section">
        <h2>Document Similarity Clusters</h2>
        <p class="analytics-section-subtitle">Documents positioned by semantic similarity. Colour indicates topic.</p>
        <div id="cluster-chart" class="analytics-chart-container"></div>
      </section>

      <!-- Topic Hierarchy -->
      <section class="analytics-section">
        <h2>Topic Hierarchy</h2>
        <p class="analytics-section-subtitle">Hierarchical clustering of collection topics based on topical similarity.</p>
        <% if (hierarchyPlot && hierarchyPlot.leaf_topic_ids && hierarchyPlot.leaf_topic_ids.length > 1) { %>
          <div id="topic-hierarchy-chart" class="topic-hierarchy-chart"></div>
        <% } else { %>
          <div class="topic-hierarchy-container">
            <% topics.forEach(function(topic) { %>
              <div class="topic-card">
                <div class="topic-card-header">
                  <span class="topic-card-label"><%= topic.topic_label %></span>
                  <span class="topic-card-count"><%= topic.document_count %> docs</span>
                </div>
                <div class="topic-card-words">
                  <% topic.topic_words.slice(0, 6).forEach(function(w) { %>
                    <span class="topic-word" style="opacity: <%= topic.topic_words[0].weight ? (0.5 + 0.5 * (w.weight / topic.topic_words[0].weight)).toFixed(3) : 1 %>"><%= w.word %></span>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>

      <!-- Topic Evolution -->
      <% if (evolution.length > 0) { %>
      <section class="analytics-section">
        <h2>Topic Evolution Over Time</h2>
        <p class="analytics-section-subtitle">How topic prevalence has changed across document dates.</p>
        <canvas id="evolution-chart" class="analytics-chart-canvas"></canvas>
      </section>
      <% } %>

    <% } %>
  </div>

<% } %>

<!-- Inline data for charts -->
<% if (analytics && analytics.topics_computed) { %>
<script>
window.__analyticsData = {
  assignments: <%- JSON.stringify(assignments) %>,
  topics: <%- JSON.stringify(topics) %>,
  hierarchyPlot: <%- JSON.stringify(hierarchyPlot || null) %>,
  evolution: <%- JSON.stringify(evolution) %>
};
</script>
<script src="/chart.umd.min.js"></script>
<script>
// Helper: generate N distinct colours
function topicColours(n) {
  const palette = [
    '#6366f1','#f59e0b','#10b981','#ef4444','#3b82f6',
    '#8b5cf6','#ec4899','#14b8a6','#f97316','#84cc16'
  ];
  const out = [];
  for (let i = 0; i < n; i++) out.push(palette[i % palette.length]);
  return out;
}

// ── Cluster chart (scatter) ────────────────────────────────────────────────
(function() {
  const { assignments, topics } = window.__analyticsData;
  if (!assignments.length) return;

  const topicIds = [...new Set(assignments.map(a => a.topic_id))].sort((a,b)=>a-b);
  const colours = topicColours(topicIds.length);
  const topicColourMap = {};
  topicIds.forEach((tid, i) => { topicColourMap[tid] = colours[i]; });

  const topicLabelMap = {};
  topics.forEach(t => { topicLabelMap[t.topic_id] = t.topic_label; });

  // Group assignments by topic for separate datasets (for legend)
  const datasets = topicIds.map((tid, i) => {
    const pts = assignments.filter(a => a.topic_id === tid);
    return {
      label: topicLabelMap[tid] || `Topic ${tid}`,
      data: pts.map(a => ({
        x: a.x_coord,
        y: a.y_coord,
        title: a.title,
        topic: topicLabelMap[tid] || `Topic ${tid}`
      })),
      backgroundColor: colours[i] + 'aa',
      pointRadius: 6,
      pointHoverRadius: 8
    };
  });

  const ctx = document.getElementById('cluster-chart');
  if (!ctx) return;
  ctx.innerHTML = ''; // clear placeholder
  const canvas = document.createElement('canvas');
  canvas.height = 400;
  ctx.appendChild(canvas);

  new Chart(canvas, {
    type: 'scatter',
    data: { datasets },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right' },
        tooltip: {
          callbacks: {
            label: ctx => `${ctx.raw.title || 'Untitled'} (${ctx.raw.topic})`
          }
        }
      },
      scales: {
        x: { display: false },
        y: { display: false }
      }
    }
  });
})();

// ── Evolution chart (line) ─────────────────────────────────────────────────
(function() {
  const { evolution, topics } = window.__analyticsData;
  const canvas = document.getElementById('evolution-chart');
  if (!canvas || !evolution.length) return;

  const periods = [...new Set(evolution.map(e => e.time_period))].sort();
  const topicIds = [...new Set(evolution.map(e => e.topic_id))];
  const colours = topicColours(topicIds.length);
  const topicLabelMap = {};
  topics.forEach(t => { topicLabelMap[t.topic_id] = t.topic_label; });

  const datasets = topicIds.map((tid, i) => ({
    label: topicLabelMap[tid] || `Topic ${tid}`,
    data: periods.map(p => {
      const row = evolution.find(e => e.topic_id === tid && e.time_period === p);
      return row ? row.document_count : 0;
    }),
    borderColor: colours[i],
    backgroundColor: colours[i] + '33',
    fill: true,
    tension: 0.3
  }));

  new Chart(canvas, {
    type: 'line',
    data: { labels: periods, datasets },
    options: {
      responsive: true,
      plugins: { legend: { position: 'right' } },
      scales: {
        y: { beginAtZero: true, title: { display: true, text: 'Documents' } },
        x: { title: { display: true, text: 'Period' } }
      }
    }
  });
})();

// ── Topic hierarchy chart (SVG dendrogram) ────────────────────────────────
(function() {
  const { hierarchyPlot, topics } = window.__analyticsData;
  const container = document.getElementById('topic-hierarchy-chart');
  if (!container || !hierarchyPlot || !Array.isArray(hierarchyPlot.leaf_topic_ids) || hierarchyPlot.leaf_topic_ids.length < 2) {
    return;
  }

  const topicMap = new Map(topics.map(topic => [topic.topic_id, topic]));
  const leaves = hierarchyPlot.leaf_topic_ids;
  const icoord = hierarchyPlot.icoord || [];
  const dcoord = hierarchyPlot.dcoord || [];
  const colours = hierarchyPlot.color_list || [];
  const maxDistance = Math.max(Number(hierarchyPlot.max_distance) || 0, 1);

  const labelWidth = 280;
  const chartWidth = 720;
  const headerHeight = 28;
  const footerHeight = 24;
  const leafSpacing = 28;
  const height = Math.max(260, headerHeight + footerHeight + leaves.length * leafSpacing + 10);
  const totalWidth = labelWidth + chartWidth;
  const plotHeight = height - headerHeight - footerHeight;

  const yMax = Math.max(...icoord.flat(), leaves.length * 10 + 5, 10);
  const xScale = (value) => labelWidth + (Number(value) / maxDistance) * (chartWidth - 18);
  const yScale = (value) => headerHeight + ((Number(value) - 5) / Math.max(yMax - 5, 1)) * plotHeight;

  const ns = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(ns, 'svg');
  svg.setAttribute('viewBox', `0 0 ${totalWidth} ${height}`);
  svg.setAttribute('class', 'topic-hierarchy-svg');
  svg.setAttribute('role', 'img');
  svg.setAttribute('aria-label', 'Hierarchical clustering of topics');

  const bg = document.createElementNS(ns, 'rect');
  bg.setAttribute('x', labelWidth - 8);
  bg.setAttribute('y', headerHeight - 8);
  bg.setAttribute('width', chartWidth + 8);
  bg.setAttribute('height', plotHeight + 16);
  bg.setAttribute('rx', '10');
  bg.setAttribute('fill', '#e8edf1');
  svg.appendChild(bg);

  const tickCount = 5;
  for (let i = 0; i < tickCount; i += 1) {
    const ratio = tickCount === 1 ? 0 : i / (tickCount - 1);
    const x = labelWidth + ratio * (chartWidth - 18);
    const grid = document.createElementNS(ns, 'line');
    grid.setAttribute('x1', x);
    grid.setAttribute('x2', x);
    grid.setAttribute('y1', headerHeight - 10);
    grid.setAttribute('y2', headerHeight - 2);
    grid.setAttribute('stroke', '#313131');
    grid.setAttribute('stroke-width', '1');
    svg.appendChild(grid);
  }

  leaves.forEach((topicId, index) => {
    const y = yScale(5 + index * 10);
    const topic = topicMap.get(topicId);
    const label = topic ? topic.topic_label : `Topic ${topicId}`;
    const text = document.createElementNS(ns, 'text');
    text.setAttribute('x', labelWidth - 14);
    text.setAttribute('y', y + 5);
    text.setAttribute('text-anchor', 'end');
    text.setAttribute('class', 'topic-hierarchy-leaf-label');
    text.textContent = label.length > 34 ? `${label.slice(0, 31)}...` : label;
    svg.appendChild(text);
  });

  icoord.forEach((coords, index) => {
    const distances = dcoord[index] || [0, 0, 0, 0];
    const points = coords.map((coord, coordIndex) => `${xScale(distances[coordIndex])},${yScale(coord)}`).join(' ');
    const line = document.createElementNS(ns, 'polyline');
    line.setAttribute('points', points);
    line.setAttribute('fill', 'none');
    line.setAttribute('stroke', colours[index] || '#1f6fd6');
    line.setAttribute('stroke-width', '2');
    line.setAttribute('stroke-linecap', 'round');
    line.setAttribute('stroke-linejoin', 'round');
    svg.appendChild(line);

    const dot = document.createElementNS(ns, 'circle');
    dot.setAttribute('cx', xScale(distances[1]));
    dot.setAttribute('cy', yScale((coords[1] + coords[2]) / 2));
    dot.setAttribute('r', '3.8');
    dot.setAttribute('fill', '#111');
    svg.appendChild(dot);
  });

  container.innerHTML = '';
  container.appendChild(svg);
})();
</script>
<% } %>

<!-- Tab switching -->
<script>
document.querySelectorAll('.analytics-subtab').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.analytics-subtab').forEach(function(b) {
      b.classList.remove('analytics-subtab-active');
      b.setAttribute('aria-selected', 'false');
    });
    document.querySelectorAll('.analytics-tab-panel').forEach(p => p.hidden = true);
    btn.classList.add('analytics-subtab-active');
    btn.setAttribute('aria-selected', 'true');
    document.getElementById('tab-' + btn.dataset.tab).hidden = false;
  });
});
</script>

<%- include('partials/footer') %>
