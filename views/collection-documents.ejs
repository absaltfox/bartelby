<%- include('partials/header', { pageTitle: pageTitle, query: '' }) %>

<%
  var basePath = '/collections/' + collectionId;
  var safeCurrentListUrl = typeof currentListUrl !== 'undefined' && currentListUrl ? currentListUrl : basePath;
  var docTypeOptions = docTypes.map(function(type) {
    return { value: type, label: type };
  });
  var locationOptions = locations.map(function(loc) {
    return { value: loc, label: loc };
  });

  // Build query string helper — preserves all current filters except the one being changed
  function filterQs(overrides) {
    var p = {};
    if (filters.docTypes && filters.docTypes.length) p.type = filters.docTypes.join(',');
    if (filters.locations && filters.locations.length) p.location = filters.locations.join(',');
    if (filters.dateFrom) p.dateFrom = filters.dateFrom;
    if (filters.dateTo) p.dateTo = filters.dateTo;
    Object.assign(p, overrides || {});
    Object.keys(p).forEach(function(k) { if (!p[k]) delete p[k]; });
    var qs = Object.keys(p).map(function(k) { return k + '=' + encodeURIComponent(p[k]); }).join('&');
    return basePath + (qs ? '?' + qs : '');
  }
%>

<% if (!isAll && !isUncollected) { %>
  <%- include('partials/collection-hero', {
    collection: collection,
    totalCount: totalCount,
    latestAnalytics: latestAnalytics,
    activeTab: 'documents'
  }) %>
<% } else { %>
  <div class="page-header">
    <div class="breadcrumb">
      <a href="/">Collections</a> <span class="breadcrumb-sep">/</span>
    </div>
    <h1><%= pageTitle %></h1>
    <p class="subtitle"><%= totalCount %> document<%= totalCount !== 1 ? 's' : '' %><% if (!isAll && !isUncollected && collection && collection.description) { %> &mdash; <%= collection.description %><% } %></p>
  </div>
<% } %>

<div class="collection-layout">
  <!-- Sidebar filters -->
  <aside class="filter-sidebar" id="filter-sidebar">
    <form id="filter-form" method="GET" action="<%= basePath %>" data-filter-sidebar="1">
      <div class="filter-sidebar-header">
        <h3>Filters</h3>
        <% if (hasActiveFilters) { %>
          <a href="<%= basePath %>" class="filter-clear-all">Clear all</a>
        <% } %>
      </div>

      <!-- Document type filter (multi-select) -->
      <% if (docTypes.length > 0) { %>
        <%- include('partials/filter-multiselect', {
          id: 'type',
          name: 'type',
          label: 'Document Type',
          allLabel: 'All types',
          selectedValues: filters.docTypes || [],
          options: docTypeOptions
        }) %>
      <% } %>

      <!-- Location filter (multi-select) -->
      <% if (locations.length > 0) { %>
        <%- include('partials/filter-multiselect', {
          id: 'location',
          name: 'location',
          label: 'Location',
          allLabel: 'All locations',
          selectedValues: filters.locations || [],
          options: locationOptions
        }) %>
      <% } %>

      <!-- Date range filter -->
      <%- include('partials/filter-date-range', {
        label: 'Date Range',
        nameFrom: 'dateFrom',
        nameTo: 'dateTo',
        fromValue: filters.dateFrom,
        toValue: filters.dateTo
      }) %>

      <button type="submit" class="btn-primary btn-sm filter-apply-btn">Apply Filters</button>
    </form>

    <% if (hasActiveFilters) { %>
      <div class="filter-active-tags">
        <% if (filters.docTypes && filters.docTypes.length) { %>
          <a href="<%= filterQs({ type: '' }) %>" class="filter-active-tag">
            <%= filters.docTypes.length === 1 ? filters.docTypes[0] : filters.docTypes.length + ' types' %> &times;
          </a>
        <% } %>
        <% if (filters.locations && filters.locations.length) { %>
          <a href="<%= filterQs({ location: '' }) %>" class="filter-active-tag">
            <%= filters.locations.length === 1 ? filters.locations[0] : filters.locations.length + ' locations' %> &times;
          </a>
        <% } %>
        <% if (filters.dateFrom || filters.dateTo) { %>
          <a href="<%= filterQs({ dateFrom: '', dateTo: '' }) %>" class="filter-active-tag">
            <%= filters.dateFrom || '...' %> &ndash; <%= filters.dateTo || '...' %> &times;
          </a>
        <% } %>
      </div>
    <% } %>
  </aside>

  <!-- Main content -->
  <div class="collection-main">
    <% if (typeof allowExport !== 'undefined' && allowExport) { %>
      <div class="export-context-banner">
        Exports are enabled for this collection. Use the list to select one or more documents for batch export, or open a document to export it individually.
      </div>
    <% } %>
    <% if (typeof allowExport !== 'undefined' && allowExport && documents.length > 0) { %>
      <div id="export-bar" class="export-bar is-hidden">
        <span id="export-count" class="export-bar-count">0 selected</span>
        <select id="export-format" class="export-bar-format">
          <option value="pdf">PDF</option>
          <option value="tei">TEI (XML)</option>
          <option value="both">Both (PDF + TEI)</option>
        </select>
        <button type="button" id="export-btn" class="btn-primary btn-sm">Export</button>
        <button type="button" id="export-deselect-btn" class="btn-secondary btn-sm">Deselect All</button>
      </div>
    <% } %>

    <% if (documents.length === 0) { %>
      <div class="empty-state">
        <% if (hasActiveFilters) { %>
          <p>No documents match the current filters.</p>
          <a href="<%= basePath %>" class="btn-secondary">Clear filters</a>
        <% } else { %>
          <h2>No documents yet</h2>
          <p>This collection is empty.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="document-list">
        <% documents.forEach(doc => { %>
          <article class="document-card<%= (typeof allowExport !== 'undefined' && allowExport) ? ' document-card-exportable' : '' %>">
            <% if (typeof allowExport !== 'undefined' && allowExport) { %>
              <div class="document-card-select">
                <input type="checkbox" class="export-cb" data-id="<%= doc.id %>" title="Select for export">
              </div>
            <% } %>
            <div class="document-thumbnail">
              <% if (doc.image_path) { %>
                <img src="<%= doc.image_path %>" alt="<%= doc.title %>" data-hide-on-image-error>
              <% } %>
              <div class="placeholder-image">&#128220;</div>
            </div>
            <div class="document-info">
              <h2><a href="/documents/<%= doc.id %>?back=<%= encodeURIComponent(safeCurrentListUrl) %>"><%= doc.title %></a></h2>
              <%
                var meta = doc.metadata || {};
                if (typeof meta === 'string') { try { meta = JSON.parse(meta); } catch(e) { meta = {}; } }
                var chips = [];
                if (meta.author) chips.push({ label: 'Author', value: meta.author });
                if (meta.document_type) chips.push({ label: 'Type', value: meta.document_type });
                if (meta.location) chips.push({ label: 'Location', value: meta.location });
                if (doc.date_created) chips.push({ label: 'Date', value: doc.date_created });
              %>
              <% if (chips.length > 0) { %>
                <div class="doc-meta-row">
                  <% chips.forEach(function(chip) { %>
                    <span class="doc-meta-chip"><span class="doc-meta-label"><%= chip.label %></span> <%= chip.value %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if (doc.description) { %>
                <p class="document-description"><%= doc.description.substring(0, 200) %><%= doc.description.length > 200 ? '...' : '' %></p>
              <% } %>
              <p class="document-meta">
                <span class="transcript-count"><%= doc.transcript_count %> transcript<%= doc.transcript_count !== 1 ? 's' : '' %></span>
              </p>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination">
          <%
            var paginationQs = {};
            if (filters.docTypes && filters.docTypes.length) paginationQs.type = filters.docTypes.join(',');
            if (filters.locations && filters.locations.length) paginationQs.location = filters.locations.join(',');
            if (filters.dateFrom) paginationQs.dateFrom = filters.dateFrom;
            if (filters.dateTo) paginationQs.dateTo = filters.dateTo;
            function pageHref(p) {
              var params = Object.assign({}, paginationQs, { page: p });
              return basePath + '?' + Object.keys(params).map(function(k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
            }
          %>
          <% if (currentPage > 1) { %>
            <a href="<%= pageHref(currentPage - 1) %>" class="prev">&larr; Previous</a>
          <% } %>
          <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="<%= pageHref(currentPage + 1) %>" class="next">Next &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>
</div>

<% if (typeof allowExport !== 'undefined' && allowExport && documents.length > 0) { %>
<script src="/js/collection-documents.js"></script>
<% } %>
<script src="/js/filter-sidebar.js"></script>

<%- include('partials/footer') %>
