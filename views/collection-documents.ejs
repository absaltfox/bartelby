<%- include('partials/header', { pageTitle: pageTitle, query: '' }) %>

<%
  var basePath = '/collections/' + collectionId;
  var safeCurrentListUrl = typeof currentListUrl !== 'undefined' && currentListUrl ? currentListUrl : basePath;

  // Build query string helper — preserves all current filters except the one being changed
  function filterQs(overrides) {
    var p = {};
    if (filters.docTypes && filters.docTypes.length) p.type = filters.docTypes.join(',');
    if (filters.locations && filters.locations.length) p.location = filters.locations.join(',');
    if (filters.dateFrom) p.dateFrom = filters.dateFrom;
    if (filters.dateTo) p.dateTo = filters.dateTo;
    Object.assign(p, overrides || {});
    Object.keys(p).forEach(function(k) { if (!p[k]) delete p[k]; });
    var qs = Object.keys(p).map(function(k) { return k + '=' + encodeURIComponent(p[k]); }).join('&');
    return basePath + (qs ? '?' + qs : '');
  }
%>

<div class="page-header">
  <div class="breadcrumb">
    <a href="/">Collections</a> <span class="breadcrumb-sep">/</span>
  </div>
  <h1><%= pageTitle %></h1>
  <p class="subtitle"><%= totalCount %> document<%= totalCount !== 1 ? 's' : '' %><% if (!isAll && !isUncollected && collection && collection.description) { %> &mdash; <%= collection.description %><% } %></p>
</div>

<div class="collection-layout">
  <!-- Sidebar filters -->
  <aside class="filter-sidebar" id="filter-sidebar">
    <form id="filter-form" method="GET" action="<%= basePath %>">
      <div class="filter-sidebar-header">
        <h3>Filters</h3>
        <% if (hasActiveFilters) { %>
          <a href="<%= basePath %>" class="filter-clear-all">Clear all</a>
        <% } %>
      </div>

      <!-- Document type filter (multi-select) -->
      <% if (docTypes.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label">Document Type</label>
          <div class="filter-multiselect" id="type-multiselect">
            <button type="button" class="filter-multiselect-toggle" id="type-toggle">
              <span id="type-toggle-text">
                <% if (filters.docTypes && filters.docTypes.length) { %>
                  <%= filters.docTypes.length === 1 ? filters.docTypes[0] : filters.docTypes.length + ' selected' %>
                <% } else { %>
                  All types
                <% } %>
              </span>
              <span class="filter-multiselect-arrow">&#9662;</span>
            </button>
            <div class="filter-multiselect-dropdown" id="type-dropdown">
              <% docTypes.forEach(function(t) { %>
                <label class="filter-multiselect-option">
                  <input type="checkbox" name="type" value="<%= t %>"
                    <%= (filters.docTypes && filters.docTypes.indexOf(t) !== -1) ? 'checked' : '' %>>
                  <span><%= t %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Location filter (multi-select) -->
      <% if (locations.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label">Location</label>
          <div class="filter-multiselect" id="location-multiselect">
            <button type="button" class="filter-multiselect-toggle" id="location-toggle">
              <span id="location-toggle-text">
                <% if (filters.locations && filters.locations.length) { %>
                  <%= filters.locations.length %> selected
                <% } else { %>
                  All locations
                <% } %>
              </span>
              <span class="filter-multiselect-arrow">&#9662;</span>
            </button>
            <div class="filter-multiselect-dropdown" id="location-dropdown">
              <% locations.forEach(function(loc) { %>
                <label class="filter-multiselect-option">
                  <input type="checkbox" name="location" value="<%= loc %>"
                    <%= (filters.locations && filters.locations.indexOf(loc) !== -1) ? 'checked' : '' %>>
                  <span><%= loc %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Date range filter -->
      <div class="filter-group">
        <label class="filter-label">Date Range</label>
        <div class="filter-date-row">
          <input type="date" name="dateFrom" class="filter-date" value="<%= filters.dateFrom || '' %>" placeholder="From">
          <span class="filter-date-sep">&ndash;</span>
          <input type="date" name="dateTo" class="filter-date" value="<%= filters.dateTo || '' %>" placeholder="To">
        </div>
      </div>

      <button type="submit" class="btn-primary btn-sm filter-apply-btn">Apply Filters</button>
    </form>

    <% if (hasActiveFilters) { %>
      <div class="filter-active-tags">
        <% if (filters.docTypes && filters.docTypes.length) { %>
          <a href="<%= filterQs({ type: '' }) %>" class="filter-active-tag">
            <%= filters.docTypes.length === 1 ? filters.docTypes[0] : filters.docTypes.length + ' types' %> &times;
          </a>
        <% } %>
        <% if (filters.locations && filters.locations.length) { %>
          <a href="<%= filterQs({ location: '' }) %>" class="filter-active-tag">
            <%= filters.locations.length === 1 ? filters.locations[0] : filters.locations.length + ' locations' %> &times;
          </a>
        <% } %>
        <% if (filters.dateFrom || filters.dateTo) { %>
          <a href="<%= filterQs({ dateFrom: '', dateTo: '' }) %>" class="filter-active-tag">
            <%= filters.dateFrom || '...' %> &ndash; <%= filters.dateTo || '...' %> &times;
          </a>
        <% } %>
      </div>
    <% } %>
  </aside>

  <!-- Main content -->
  <div class="collection-main">
    <% if (typeof allowExport !== 'undefined' && allowExport) { %>
      <div class="export-context-banner">
        Exports are enabled for this collection. Use the list to select one or more documents for batch export, or open a document to export it individually.
      </div>
    <% } %>
    <% if (typeof allowExport !== 'undefined' && allowExport && documents.length > 0) { %>
      <div id="export-bar" class="export-bar" style="display:none;">
        <span id="export-count" class="export-bar-count">0 selected</span>
        <select id="export-format" class="export-bar-format">
          <option value="pdf">PDF</option>
          <option value="tei">TEI (XML)</option>
          <option value="both">Both (PDF + TEI)</option>
        </select>
        <button type="button" id="export-btn" class="btn-primary btn-sm">Export</button>
        <button type="button" id="export-deselect-btn" class="btn-secondary btn-sm">Deselect All</button>
      </div>
    <% } %>

    <% if (documents.length === 0) { %>
      <div class="empty-state">
        <% if (hasActiveFilters) { %>
          <p>No documents match the current filters.</p>
          <a href="<%= basePath %>" class="btn-secondary">Clear filters</a>
        <% } else { %>
          <h2>No documents yet</h2>
          <p>This collection is empty.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="document-list">
        <% documents.forEach(doc => { %>
          <article class="document-card<%= (typeof allowExport !== 'undefined' && allowExport) ? ' document-card-exportable' : '' %>">
            <% if (typeof allowExport !== 'undefined' && allowExport) { %>
              <div class="document-card-select">
                <input type="checkbox" class="export-cb" data-id="<%= doc.id %>" title="Select for export">
              </div>
            <% } %>
            <div class="document-thumbnail">
              <% if (doc.image_path) { %>
                <img src="<%= doc.image_path %>" alt="<%= doc.title %>" onerror="this.style.display='none'">
              <% } %>
              <div class="placeholder-image">&#128220;</div>
            </div>
            <div class="document-info">
              <h2><a href="/documents/<%= doc.id %>?back=<%= encodeURIComponent(safeCurrentListUrl) %>"><%= doc.title %></a></h2>
              <%
                var meta = doc.metadata || {};
                if (typeof meta === 'string') { try { meta = JSON.parse(meta); } catch(e) { meta = {}; } }
                var chips = [];
                if (meta.author) chips.push({ label: 'Author', value: meta.author });
                if (meta.document_type) chips.push({ label: 'Type', value: meta.document_type });
                if (meta.location) chips.push({ label: 'Location', value: meta.location });
                if (doc.date_created) chips.push({ label: 'Date', value: doc.date_created });
              %>
              <% if (chips.length > 0) { %>
                <div class="doc-meta-row">
                  <% chips.forEach(function(chip) { %>
                    <span class="doc-meta-chip"><span class="doc-meta-label"><%= chip.label %></span> <%= chip.value %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if (doc.description) { %>
                <p class="document-description"><%= doc.description.substring(0, 200) %><%= doc.description.length > 200 ? '...' : '' %></p>
              <% } %>
              <p class="document-meta">
                <span class="transcript-count"><%= doc.transcript_count %> transcript<%= doc.transcript_count !== 1 ? 's' : '' %></span>
              </p>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination">
          <%
            var paginationQs = {};
            if (filters.docTypes && filters.docTypes.length) paginationQs.type = filters.docTypes.join(',');
            if (filters.locations && filters.locations.length) paginationQs.location = filters.locations.join(',');
            if (filters.dateFrom) paginationQs.dateFrom = filters.dateFrom;
            if (filters.dateTo) paginationQs.dateTo = filters.dateTo;
            function pageHref(p) {
              var params = Object.assign({}, paginationQs, { page: p });
              return basePath + '?' + Object.keys(params).map(function(k) { return k + '=' + encodeURIComponent(params[k]); }).join('&');
            }
          %>
          <% if (currentPage > 1) { %>
            <a href="<%= pageHref(currentPage - 1) %>" class="prev">&larr; Previous</a>
          <% } %>
          <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="<%= pageHref(currentPage + 1) %>" class="next">Next &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>
</div>

<% if (typeof allowExport !== 'undefined' && allowExport && documents.length > 0) { %>
<script>
(function() {
  var exportBar = document.getElementById('export-bar');
  var exportCount = document.getElementById('export-count');
  var exportFormat = document.getElementById('export-format');
  var exportBtn = document.getElementById('export-btn');
  var deselectBtn = document.getElementById('export-deselect-btn');
  var checkboxes = document.querySelectorAll('.export-cb');
  var csrfToken = document.querySelector('meta[name="csrf-token"]').content;

  function updateExportUI() {
    var checked = document.querySelectorAll('.export-cb:checked');
    var count = checked.length;
    exportBar.style.display = count > 0 ? 'flex' : 'none';
    exportCount.textContent = count + ' selected';
  }

  checkboxes.forEach(function(cb) { cb.addEventListener('change', updateExportUI); });

  deselectBtn.addEventListener('click', function() {
    checkboxes.forEach(function(cb) { cb.checked = false; });
    updateExportUI();
  });

  exportBtn.addEventListener('click', async function() {
    var ids = Array.from(document.querySelectorAll('.export-cb:checked')).map(function(cb) {
      return parseInt(cb.dataset.id);
    });
    if (ids.length === 0) return;

    // Single document — direct download
    if (ids.length === 1 && exportFormat.value !== 'both') {
      var ext = exportFormat.value === 'tei' ? 'tei' : 'pdf';
      window.location.href = '/export/documents/' + ids[0] + '/' + ext;
      return;
    }

    // Bulk — POST for ZIP
    exportBtn.disabled = true;
    exportBtn.textContent = 'Exporting...';
    try {
      var res = await fetch('/export/documents/bulk', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ ids: ids, format: exportFormat.value })
      });
      if (!res.ok) {
        var err = await res.json();
        throw new Error(err.error || 'Export failed');
      }
      var blob = await res.blob();
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'export.zip';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } catch (err) {
      alert(err.message);
    } finally {
      exportBtn.disabled = false;
      exportBtn.textContent = 'Export';
    }
  });
})();
</script>
<% } %>

<script>
(function() {
  // Reusable multi-select dropdown setup
  function initMultiSelect(id, fieldName, allLabel) {
    var wrap = document.getElementById(id + '-multiselect');
    var toggle = document.getElementById(id + '-toggle');
    var dropdown = document.getElementById(id + '-dropdown');
    if (!wrap || !toggle || !dropdown) return;

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelectorAll('.filter-multiselect.open').forEach(function(el) {
        if (el !== wrap) el.classList.remove('open');
      });
      wrap.classList.toggle('open');
    });

    document.addEventListener('click', function(e) {
      if (!wrap.contains(e.target)) wrap.classList.remove('open');
    });

    var checkboxes = dropdown.querySelectorAll('input[type="checkbox"]');
    var toggleText = document.getElementById(id + '-toggle-text');

    checkboxes.forEach(function(cb) {
      cb.addEventListener('change', function() {
        var checked = dropdown.querySelectorAll('input:checked');
        if (checked.length === 0) {
          toggleText.textContent = allLabel;
        } else if (checked.length === 1) {
          toggleText.textContent = checked[0].parentElement.querySelector('span').textContent;
        } else {
          toggleText.textContent = checked.length + ' selected';
        }
      });
    });
  }

  initMultiSelect('type', 'type', 'All types');
  initMultiSelect('location', 'location', 'All locations');

  // On form submit, combine multi-select checkboxes into comma-separated hidden inputs
  document.getElementById('filter-form').addEventListener('submit', function(e) {
    ['type', 'location'].forEach(function(fieldName) {
      var dropdown = document.getElementById(fieldName + '-dropdown');
      if (!dropdown) return;
      var allCbs = dropdown.querySelectorAll('input[type="checkbox"]');
      var checked = dropdown.querySelectorAll('input[type="checkbox"]:checked');
      allCbs.forEach(function(cb) { cb.removeAttribute('name'); });
      if (checked.length > 0) {
        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = fieldName;
        hidden.value = Array.from(checked).map(function(cb) { return cb.value; }).join(',');
        e.target.appendChild(hidden);
      }
    });
  });
})();
</script>

<%- include('partials/footer') %>
