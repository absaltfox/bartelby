<%- include('partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="terms-page">
  <div class="page-header">
    <h1><%= title %></h1>
    <p class="subtitle"><%= subtitle %></p>
  </div>

  <div class="terms-card policy-card">
    <% String(content || '').split(/\n\s*\n/).forEach(function(paragraph) { %>
      <% if (paragraph.trim()) { %>
        <p><%= paragraph.trim() %></p>
      <% } %>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
