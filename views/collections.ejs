<%- include('partials/header', { pageTitle: 'Collections', query: '' }) %>

<div class="page-header">
  <h1>Collections</h1>
  <p class="subtitle"><%= totalDocCount %> document<%= totalDocCount !== 1 ? 's' : '' %> across <%= collections.length %> collection<%= collections.length !== 1 ? 's' : '' %></p>
</div>

<div class="collections-grid">
  <% if (currentUser && collections.length > 1) { %>
    <!-- All Documents card -->
    <a href="/collections/all" class="collection-card collection-card--special">
      <div class="collection-card-thumb collection-card-thumb--icon">
        <span class="collection-card-icon">&#128218;</span>
      </div>
      <div class="collection-card-body">
        <h2 class="collection-card-title">All Documents</h2>
        <p class="collection-card-desc">Browse every document across all collections.</p>
        <div class="collection-card-stats">
          <span class="collection-card-count"><%= totalDocCount %> document<%= totalDocCount !== 1 ? 's' : '' %></span>
        </div>
      </div>
    </a>
  <% } %>

  <% collections.forEach(function(c, idx) { %>
    <a href="/collections/<%= c.id %>" class="collection-card">
      <div class="collection-card-thumb">
          <% if (c.thumbnail) { %>
            <% if (idx === 0) { %>
              <img src="<%= c.thumbnail %>" alt="<%= c.name %>" data-hide-on-image-error fetchpriority="high" decoding="async" width="400" height="300">
            <% } else { %>
              <img src="<%= c.thumbnail %>" alt="<%= c.name %>" data-hide-on-image-error loading="lazy" decoding="async" width="400" height="300">
            <% } %>
          <% } %>
        <div class="collection-card-placeholder">&#128220;</div>
      </div>
      <div class="collection-card-body">
        <h2 class="collection-card-title"><%= c.name %></h2>
        <% if (c.description) { %>
          <p class="collection-card-desc"><%= c.description.length > 120 ? c.description.substring(0, 120) + '...' : c.description %></p>
        <% } %>
        <div class="collection-card-stats">
          <span class="collection-card-count"><%= c.document_count %> document<%= c.document_count !== 1 ? 's' : '' %></span>
          <% if (c.is_world_public) { %>
            <span class="collection-card-badge">Public</span>
          <% } else if (c.is_public) { %>
            <span class="collection-card-badge">All Users</span>
          <% } %>
        </div>
      </div>
    </a>
  <% }) %>

  <% if (isAdmin && uncollectedCount > 0) { %>
    <a href="/collections/uncollected" class="collection-card collection-card--special">
      <div class="collection-card-thumb collection-card-thumb--icon">
        <span class="collection-card-icon">&#128451;</span>
      </div>
      <div class="collection-card-body">
        <h2 class="collection-card-title">Uncollected</h2>
        <p class="collection-card-desc">Documents not yet assigned to any collection.</p>
        <div class="collection-card-stats">
          <span class="collection-card-count"><%= uncollectedCount %> document<%= uncollectedCount !== 1 ? 's' : '' %></span>
        </div>
      </div>
    </a>
  <% } %>
</div>

<%- include('partials/footer') %>
