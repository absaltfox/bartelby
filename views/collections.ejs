<%- include('partials/header', { pageTitle: 'Collections', query: '' }) %>

<div class="page-header collections-home-header">
  <div class="page-header-main">
    <div class="page-eyebrow">Reading Room</div>
    <h1>Collections</h1>
    <p class="subtitle collections-meta">
      <%= collections.length %> collection<%= collections.length !== 1 ? 's' : '' %>
      <span aria-hidden="true">&middot;</span>
      <% if (currentUser && collections.length > 1) { %>
        <a href="/collections/all"><%= totalDocCount.toLocaleString() %> document<%= totalDocCount !== 1 ? 's' : '' %></a>
      <% } else { %>
        <%= totalDocCount.toLocaleString() %> document<%= totalDocCount !== 1 ? 's' : '' %>
      <% } %>
      <% if (isAdmin && uncollectedCount > 0) { %>
        <span aria-hidden="true">&middot;</span>
        <a href="/collections/uncollected"><%= uncollectedCount.toLocaleString() %> uncollected</a>
      <% } %>
    </p>
  </div>
  <% if (isAdmin) { %>
    <div class="page-header-actions">
      <a href="/admin/collections" class="btn-primary btn-sm">New collection</a>
    </div>
  <% } %>
</div>

<% if (collections.length === 0) { %>
  <div class="empty-state">
    <h2>No collections yet</h2>
    <% if (isAdmin) { %>
      <p>Create a collection before adding documents to the reading room.</p>
      <a href="/admin/collections" class="btn-primary">Manage collections</a>
    <% } else { %>
      <p>No collections are available to your account yet.</p>
    <% } %>
  </div>
<% } else { %>
  <div class="shelf-wrap">
    <table class="shelf" data-collections-shelf>
      <thead>
        <tr>
          <th class="shelf-thumb-col"><span class="sr-only">Preview</span></th>
          <th scope="col" data-sort-key="name" data-sort-first="asc">Collection</th>
          <th scope="col" class="shelf-col-dated" data-sort-key="dated" data-sort-first="asc">Date range</th>
          <th scope="col" class="shelf-num" data-sort-key="documents" data-sort-first="desc">Documents</th>
          <th scope="col" class="shelf-num shelf-col-added" data-sort-key="added" data-sort-first="desc">Last added</th>
        </tr>
      </thead>
      <tbody>
        <% collections.forEach(function(c) { %>
        <tr <% if (c.docCount === 0) { %>class="is-empty"<% } %>
            data-sort-name="<%= c.name %>"
            data-sort-dated="<%= c.sortYear == null ? '' : c.sortYear %>"
            data-sort-documents="<%= c.docCount %>"
            data-sort-added="<%= c.sortAdded == null ? '' : c.sortAdded %>">
          <td class="shelf-thumb-col">
            <% if (c.thumbnail && c.docCount > 0) { %>
              <img class="shelf-thumb" src="<%= c.thumbnail %>" alt="" data-hide-on-image-error loading="lazy" decoding="async" width="84" height="56">
            <% } %>
          </td>
          <th scope="row" class="shelf-main">
            <a class="shelf-name" href="/collections/<%= c.id %>"><%= c.name %></a>
            <% if (c.visibility === 'public') { %>
              <span class="shelf-vis">Public</span>
            <% } else if (c.visibility === 'shared') { %>
              <span class="shelf-vis">Shared</span>
            <% } %>
            <% if (c.desc) { %>
              <div class="shelf-desc"><%= c.desc %></div>
            <% } %>
          </th>
          <td class="shelf-col-dated"><%= c.dateRange %></td>
          <td class="shelf-num">
            <% if (c.docCount === 0) { %>
              <span class="shelf-none">None yet</span>
            <% } else { %>
              <%= c.docCount.toLocaleString() %>
            <% } %>
          </td>
          <td class="shelf-num shelf-col-added"><%= c.lastAddedLabel %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<script src="/js/collections-shelf.js"></script>

<%- include('partials/footer') %>
