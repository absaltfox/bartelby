<%- include('partials/header', { pageTitle: 'Advanced Search', query: query }) %>

<%
  function advancedQs(overrides) {
    var p = {};
    if (query) p.q = query;
    if (filters.collectionId) p.collection = filters.collectionId;
    if (filters.docTypes && filters.docTypes.length) p.type = filters.docTypes.join(',');
    if (filters.locations && filters.locations.length) p.location = filters.locations.join(',');
    if (filters.authors && filters.authors.length) p.author = filters.authors.join(',');
    if (filters.dateFrom) p.dateFrom = filters.dateFrom;
    if (filters.dateTo) p.dateTo = filters.dateTo;
    Object.assign(p, overrides || {});
    Object.keys(p).forEach(function(k) { if (!p[k]) delete p[k]; });
    var qs = Object.keys(p).map(function(k) { return k + '=' + encodeURIComponent(p[k]); }).join('&');
    return '/search/advanced' + (qs ? '?' + qs : '');
  }
  var hasActiveFilters = query || filters.collectionId || (filters.docTypes && filters.docTypes.length) || (filters.locations && filters.locations.length) || (filters.authors && filters.authors.length) || filters.dateFrom || filters.dateTo;
%>

<div class="page-header">
  <h1>Advanced Search</h1>
  <p class="subtitle">Search across transcript text and document metadata.</p>
</div>

<div class="advanced-search-layout">
  <aside class="filter-sidebar advanced-search-sidebar">
    <form method="GET" action="/search/advanced" class="advanced-search-form">
      <div class="filter-sidebar-header">
        <h3>Search Filters</h3>
        <% if (hasActiveFilters) { %>
          <a href="/search/advanced" class="filter-clear-all">Clear all</a>
        <% } %>
      </div>

      <div class="filter-group">
        <label class="filter-label" for="advanced-query">Keywords</label>
        <input id="advanced-query" type="search" name="q" class="filter-select" value="<%= query %>" placeholder="Search transcript text, title, description...">
      </div>

      <% if (availableCollections.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label" for="advanced-collection">Collection</label>
          <select name="collection" id="advanced-collection" class="filter-select">
            <option value="">All accessible collections</option>
            <% availableCollections.forEach(function(collection) { %>
              <option value="<%= collection.id %>" <%= filters.collectionId === collection.id ? 'selected' : '' %>><%= collection.name %></option>
            <% }) %>
          </select>
        </div>
      <% } %>

      <% if (docTypes.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label">Document Types</label>
          <div class="filter-multiselect" id="type-multiselect">
            <button type="button" class="filter-multiselect-toggle" id="type-toggle">
              <span id="type-toggle-text">
                <% if (filters.docTypes && filters.docTypes.length) { %>
                  <%= filters.docTypes.length === 1 ? filters.docTypes[0] : filters.docTypes.length + ' selected' %>
                <% } else { %>
                  All types
                <% } %>
              </span>
              <span class="filter-multiselect-arrow">&#9662;</span>
            </button>
            <div class="filter-multiselect-dropdown" id="type-dropdown">
              <% docTypes.forEach(function(type) { %>
                <label class="filter-multiselect-option">
                  <input type="checkbox" name="type" value="<%= type %>" <%= filters.docTypes.indexOf(type) !== -1 ? 'checked' : '' %>>
                  <span><%= type %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <% if (locations.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label">Locations</label>
          <div class="filter-multiselect" id="location-multiselect">
            <button type="button" class="filter-multiselect-toggle" id="location-toggle">
              <span id="location-toggle-text">
                <% if (filters.locations && filters.locations.length) { %>
                  <%= filters.locations.length === 1 ? filters.locations[0] : filters.locations.length + ' selected' %>
                <% } else { %>
                  All locations
                <% } %>
              </span>
              <span class="filter-multiselect-arrow">&#9662;</span>
            </button>
            <div class="filter-multiselect-dropdown" id="location-dropdown">
              <% locations.forEach(function(location) { %>
                <label class="filter-multiselect-option">
                  <input type="checkbox" name="location" value="<%= location %>" <%= filters.locations.indexOf(location) !== -1 ? 'checked' : '' %>>
                  <span><%= location %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <% if (authors.length > 0) { %>
        <div class="filter-group">
          <label class="filter-label">Authors</label>
          <div class="filter-multiselect" id="author-multiselect">
            <button type="button" class="filter-multiselect-toggle" id="author-toggle">
              <span id="author-toggle-text">
                <% if (filters.authors && filters.authors.length) { %>
                  <%= filters.authors.length === 1 ? filters.authors[0] : filters.authors.length + ' selected' %>
                <% } else { %>
                  All authors
                <% } %>
              </span>
              <span class="filter-multiselect-arrow">&#9662;</span>
            </button>
            <div class="filter-multiselect-dropdown" id="author-dropdown">
              <% authors.forEach(function(author) { %>
                <label class="filter-multiselect-option">
                  <input type="checkbox" name="author" value="<%= author %>" <%= filters.authors.indexOf(author) !== -1 ? 'checked' : '' %>>
                  <span><%= author %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      <% } %>

      <div class="filter-group">
        <label class="filter-label">Date Range</label>
        <div class="filter-date-row">
          <input type="date" name="dateFrom" class="filter-date" value="<%= filters.dateFrom || '' %>" min="<%= dateRange.min_date || '' %>" max="<%= dateRange.max_date || '' %>">
          <span class="filter-date-sep">&ndash;</span>
          <input type="date" name="dateTo" class="filter-date" value="<%= filters.dateTo || '' %>" min="<%= dateRange.min_date || '' %>" max="<%= dateRange.max_date || '' %>">
        </div>
      </div>

      <button type="submit" class="btn-primary btn-sm filter-apply-btn">Search</button>
    </form>
  </aside>

  <section class="advanced-search-main">
    <div class="advanced-search-summary-card">
      <% if (hasActiveFilters) { %>
        <h2>Filtered Results</h2>
        <p class="search-summary">Found <%= totalCount %> result<%= totalCount !== 1 ? 's' : '' %>.</p>
      <% } else { %>
        <h2>All Accessible Documents</h2>
        <p class="search-summary">Showing <%= totalCount %> document<%= totalCount !== 1 ? 's' : '' %>. Add keywords or filters to narrow the results.</p>
      <% } %>
    </div>

    <% if (hasActiveFilters) { %>
      <div class="filter-active-tags advanced-search-tags">
        <% if (query) { %>
          <a href="<%= advancedQs({ q: '' }) %>" class="filter-active-tag">Keyword: <%= query %> &times;</a>
        <% } %>
        <% if (filters.collectionId) { %>
          <% var selectedCollection = availableCollections.find(function(collection) { return collection.id === filters.collectionId; }); %>
          <% if (selectedCollection) { %>
            <a href="<%= advancedQs({ collection: '' }) %>" class="filter-active-tag">Collection: <%= selectedCollection.name %> &times;</a>
          <% } %>
        <% } %>
        <% if (filters.docTypes && filters.docTypes.length) { %>
          <a href="<%= advancedQs({ type: '' }) %>" class="filter-active-tag">Document Type: <%= filters.docTypes.length === 1 ? filters.docTypes[0] : filters.docTypes.length + ' selected' %> &times;</a>
        <% } %>
        <% if (filters.locations && filters.locations.length) { %>
          <a href="<%= advancedQs({ location: '' }) %>" class="filter-active-tag">Location: <%= filters.locations.length === 1 ? filters.locations[0] : filters.locations.length + ' selected' %> &times;</a>
        <% } %>
        <% if (filters.authors && filters.authors.length) { %>
          <a href="<%= advancedQs({ author: '' }) %>" class="filter-active-tag">Author: <%= filters.authors.length === 1 ? filters.authors[0] : filters.authors.length + ' selected' %> &times;</a>
        <% } %>
        <% if (filters.dateFrom || filters.dateTo) { %>
          <a href="<%= advancedQs({ dateFrom: '', dateTo: '' }) %>" class="filter-active-tag">Date: <%= filters.dateFrom || '...' %> &ndash; <%= filters.dateTo || '...' %> &times;</a>
        <% } %>
      </div>
    <% } %>

    <% if (results.length > 0) { %>
      <div class="document-list search-document-list">
        <% results.forEach(function(doc) { %>
          <article class="document-card search-document-card">
            <div class="document-thumbnail">
              <% if (doc.image_path) { %>
                <img src="<%= doc.image_path %>" alt="<%= doc.title %>" onerror="this.style.display='none'">
              <% } %>
              <div class="placeholder-image">&#128220;</div>
            </div>
            <div class="document-info">
              <h2>
                <a href="/documents/<%= doc.id %><%= doc.transcript_id ? '?transcript=' + doc.transcript_id : '' %>"><%= doc.title %></a>
              </h2>
              <%
                var chips = [];
                if (doc.metadata && doc.metadata.author) chips.push({ label: 'Author', value: doc.metadata.author });
                if (doc.metadata && doc.metadata.document_type) chips.push({ label: 'Type', value: doc.metadata.document_type });
                if (doc.metadata && doc.metadata.location) chips.push({ label: 'Location', value: doc.metadata.location });
                if (doc.date_created) chips.push({ label: 'Date', value: doc.date_created });
              %>
              <% if (chips.length > 0) { %>
                <div class="doc-meta-row">
                  <% chips.forEach(function(chip) { %>
                    <span class="doc-meta-chip"><span class="doc-meta-label"><%= chip.label %></span> <%= chip.value %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if (doc.snippet) { %>
                <p class="result-snippet"><%- doc.snippet %></p>
              <% } %>
              <p class="document-meta">
                <span class="transcript-count"><%= doc.transcript_count %> transcript<%= doc.transcript_count !== 1 ? 's' : '' %></span>
                <% if (doc.transcript_transcriber) { %>
                  <span class="advanced-search-transcriber">Best transcript by <%= doc.transcript_transcriber %></span>
                <% } %>
              </p>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination">
          <% if (currentPage > 1) { %>
            <a href="<%= advancedQs({ page: currentPage - 1 }) %>" class="prev">&larr; Previous</a>
          <% } %>
          <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
          <% if (currentPage < totalPages) { %>
            <a href="<%= advancedQs({ page: currentPage + 1 }) %>" class="next">Next &rarr;</a>
          <% } %>
        </nav>
      <% } %>
    <% } else if (hasActiveFilters) { %>
      <div class="empty-state">
        <h2>No matching documents</h2>
        <p>Try broadening the keyword search or removing one of the metadata filters.</p>
      </div>
    <% } %>
  </section>
</div>

<script>
(function() {
  function initMultiSelect(id, allLabel) {
    var wrap = document.getElementById(id + '-multiselect');
    var toggle = document.getElementById(id + '-toggle');
    var dropdown = document.getElementById(id + '-dropdown');
    var toggleText = document.getElementById(id + '-toggle-text');
    if (!wrap || !toggle || !dropdown || !toggleText) return;

    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      document.querySelectorAll('.filter-multiselect.open').forEach(function(el) {
        if (el !== wrap) el.classList.remove('open');
      });
      wrap.classList.toggle('open');
    });

    document.addEventListener('click', function(e) {
      if (!wrap.contains(e.target)) wrap.classList.remove('open');
    });

    dropdown.querySelectorAll('input[type="checkbox"]').forEach(function(cb) {
      cb.addEventListener('change', function() {
        var checked = dropdown.querySelectorAll('input:checked');
        if (checked.length === 0) {
          toggleText.textContent = allLabel;
        } else if (checked.length === 1) {
          toggleText.textContent = checked[0].parentElement.querySelector('span').textContent;
        } else {
          toggleText.textContent = checked.length + ' selected';
        }
      });
    });
  }

  initMultiSelect('type', 'All types');
  initMultiSelect('location', 'All locations');
  initMultiSelect('author', 'All authors');

  var form = document.querySelector('.advanced-search-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      ['type', 'location', 'author'].forEach(function(fieldName) {
        var dropdown = document.getElementById(fieldName + '-dropdown');
        if (!dropdown) return;

        form.querySelectorAll('input[type="hidden"][data-generated-filter="' + fieldName + '"]').forEach(function(existing) {
          existing.remove();
        });

        var allCbs = dropdown.querySelectorAll('input[type="checkbox"]');
        var checked = dropdown.querySelectorAll('input[type="checkbox"]:checked');
        allCbs.forEach(function(cb) { cb.removeAttribute('name'); });

        if (checked.length > 0) {
          var hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.name = fieldName;
          hidden.value = Array.from(checked).map(function(cb) { return cb.value; }).join(',');
          hidden.setAttribute('data-generated-filter', fieldName);
          form.appendChild(hidden);
        }
      });
    });
  }
})();
</script>

<%- include('partials/footer') %>
