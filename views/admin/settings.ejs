<%- include('../partials/header', { pageTitle: 'LLM Settings', query: '' }) %>

<div class="admin-page admin-page--workspace settings-page">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>LLM Settings</h1>
    <p class="subtitle">Configure AI providers for document transcription</p>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">Settings saved successfully.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (!hasEncryptionKey) { %>
    <div class="alert alert-error"><code>DATA_ENCRYPTION_KEY</code> is not configured, so API keys and other encrypted provider secrets cannot be saved securely until it is added to <code>.env</code>.</div>
  <% } %>

  <form method="POST" action="/admin/llm-settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <section class="settings-section">
      <h2>Default Provider</h2>
      <div class="form-group">
        <label for="default_provider">Use this provider when none is specified</label>
        <select id="default_provider" name="default_provider">
          <% providers.forEach(p => { %>
            <option value="<%= p %>" <%= cfg.default_provider === p ? 'selected' : '' %>>
              <%= p.charAt(0).toUpperCase() + p.slice(1) %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="transcription_prompt">Default System Prompt</label>
        <textarea id="transcription_prompt" name="transcription_prompt" rows="18"><%= cfg.transcription_prompt || `You are an expert in historical document transcription and paleography. Transcribe all handwritten and printed text from the document image with high accuracy.

Rules:
- Transcribe ALL visible text verbatim, preserving original spelling, punctuation, and capitalization
- Use [illegible] for text that cannot be read with confidence
- Use [unclear: word?] when a word is uncertain
- Mark struck-through text as ~~text~~
- Mark interlinear additions in {curly braces}

Respond ONLY with a valid JSON object — no markdown fences, no commentary — in this exact shape:
{
  "transcription": "<full verbatim text>",
  "metadata": {
    "title": "<document title or null>",
    "date_created": "<date as written, e.g. March 15 1847, or null>",
    "document_type": "<letter|ledger|deed|diary|legal|receipt|other or null>",
    "author": "<author/signer or null>",
    "location": "<place of origin or null>",
    "condition": "<good|fair|poor or null>"
  },
  "notes": "<observations about illegible sections or difficulties, or null>"
}` %></textarea>
        <p class="field-hint">This prompt is used for new AI transcriptions. It is also stored in transcript provenance so each run records the prompt that was used.</p>
      </div>
    </section>

    <%
      const providerSections = [
        {
          title: 'OpenAI',
          apiKeyName: 'openai_api_key',
          apiKeyValue: cfg.openai_api_key,
          apiKeyPlaceholder: cfg.openai_api_key ? '••••••••••••••••' : 'sk-…',
          apiKeyEnvVar: 'OPENAI_API_KEY',
          modelName: 'openai_model',
          modelValue: cfg.openai_model || 'gpt-4o',
          modelPlaceholder: 'gpt-4o',
          modelHelp: 'Must support vision (image input).',
          visionName: 'openai_vision_model',
          visionValue: cfg.openai_vision_model || '',
          visionPlaceholder: 'gpt-4o-mini',
          visionDefault: 'gpt-4o-mini',
          utilityName: 'openai_utility_model',
          utilityValue: cfg.openai_utility_model || '',
          utilityPlaceholder: 'gpt-4o-mini',
          utilityDefault: 'gpt-4o-mini',
          inputCostName: 'openai_input_cost_per_mtok',
          inputCostValue: cfg.openai_input_cost_per_mtok || '',
          inputCostPlaceholder: 'e.g. 2.50',
          outputCostName: 'openai_output_cost_per_mtok',
          outputCostValue: cfg.openai_output_cost_per_mtok || '',
          outputCostPlaceholder: 'e.g. 10.00',
          utilityInputCostName: 'openai_utility_input_cost_per_mtok',
          utilityInputCostValue: cfg.openai_utility_input_cost_per_mtok || '',
          utilityInputCostPlaceholder: 'e.g. 0.15',
          utilityOutputCostName: 'openai_utility_output_cost_per_mtok',
          utilityOutputCostValue: cfg.openai_utility_output_cost_per_mtok || '',
          utilityOutputCostPlaceholder: 'e.g. 0.60'
        },
        {
          title: 'Claude (Anthropic)',
          apiKeyName: 'anthropic_api_key',
          apiKeyValue: cfg.anthropic_api_key,
          apiKeyPlaceholder: cfg.anthropic_api_key ? '••••••••••••••••' : 'sk-ant-…',
          apiKeyEnvVar: 'ANTHROPIC_API_KEY',
          modelName: 'anthropic_model',
          modelValue: cfg.anthropic_model || 'claude-3-5-sonnet-20241022',
          modelPlaceholder: 'claude-3-5-sonnet-20241022',
          modelHelp: 'Must support vision.',
          visionName: 'anthropic_vision_model',
          visionValue: cfg.anthropic_vision_model || '',
          visionPlaceholder: 'claude-3-5-haiku-20241022',
          visionDefault: 'claude-3-5-haiku-20241022',
          utilityName: 'anthropic_utility_model',
          utilityValue: cfg.anthropic_utility_model || '',
          utilityPlaceholder: 'claude-haiku-4-5-20251001',
          utilityDefault: 'claude-haiku-4-5-20251001',
          inputCostName: 'anthropic_input_cost_per_mtok',
          inputCostValue: cfg.anthropic_input_cost_per_mtok || '',
          inputCostPlaceholder: 'e.g. 3.00',
          outputCostName: 'anthropic_output_cost_per_mtok',
          outputCostValue: cfg.anthropic_output_cost_per_mtok || '',
          outputCostPlaceholder: 'e.g. 15.00',
          utilityInputCostName: 'anthropic_utility_input_cost_per_mtok',
          utilityInputCostValue: cfg.anthropic_utility_input_cost_per_mtok || '',
          utilityInputCostPlaceholder: 'e.g. 0.80',
          utilityOutputCostName: 'anthropic_utility_output_cost_per_mtok',
          utilityOutputCostValue: cfg.anthropic_utility_output_cost_per_mtok || '',
          utilityOutputCostPlaceholder: 'e.g. 4.00'
        },
        {
          title: 'Gemini (Google)',
          apiKeyName: 'google_api_key',
          apiKeyValue: cfg.google_api_key,
          apiKeyPlaceholder: cfg.google_api_key ? '••••••••••••••••' : 'AIza…',
          apiKeyEnvVar: 'GOOGLE_GENERATIVE_AI_API_KEY',
          modelName: 'google_model',
          modelValue: cfg.google_model || 'gemini-1.5-pro-latest',
          modelPlaceholder: 'gemini-1.5-pro-latest',
          modelHelp: 'Must support vision.',
          visionName: 'google_vision_model',
          visionValue: cfg.google_vision_model || '',
          visionPlaceholder: 'gemini-1.5-flash-latest',
          visionDefault: 'gemini-1.5-flash-latest',
          utilityName: 'google_utility_model',
          utilityValue: cfg.google_utility_model || '',
          utilityPlaceholder: 'gemini-1.5-flash-latest',
          utilityDefault: 'gemini-1.5-flash-latest',
          inputCostName: 'google_input_cost_per_mtok',
          inputCostValue: cfg.google_input_cost_per_mtok || '',
          inputCostPlaceholder: 'e.g. 1.25',
          outputCostName: 'google_output_cost_per_mtok',
          outputCostValue: cfg.google_output_cost_per_mtok || '',
          outputCostPlaceholder: 'e.g. 5.00',
          utilityInputCostName: 'google_utility_input_cost_per_mtok',
          utilityInputCostValue: cfg.google_utility_input_cost_per_mtok || '',
          utilityInputCostPlaceholder: 'e.g. 0.08',
          utilityOutputCostName: 'google_utility_output_cost_per_mtok',
          utilityOutputCostValue: cfg.google_utility_output_cost_per_mtok || '',
          utilityOutputCostPlaceholder: 'e.g. 0.30'
        },
        {
          title: 'Google Vertex',
          apiKeyName: 'vertex_api_key',
          apiKeyValue: cfg.vertex_api_key,
          apiKeyPlaceholder: cfg.vertex_api_key ? '••••••••••••••••' : 'AIza…',
          apiKeyEnvVar: 'GOOGLE_VERTEX_API_KEY',
          modelName: 'vertex_model',
          modelValue: cfg.vertex_model || 'gemini-2.5-flash',
          modelPlaceholder: 'gemini-2.5-flash',
          modelHelp: 'Must support vision. Realtime calls use Vertex AI Express Mode (API key auth); batch jobs use the Vertex batch settings below.',
          visionName: 'vertex_vision_model',
          visionValue: cfg.vertex_vision_model || '',
          visionPlaceholder: 'gemini-2.5-flash',
          visionDefault: 'gemini-2.5-flash',
          utilityName: 'vertex_utility_model',
          utilityValue: cfg.vertex_utility_model || '',
          utilityPlaceholder: 'gemini-2.5-flash',
          utilityDefault: 'gemini-2.5-flash',
          inputCostName: 'vertex_input_cost_per_mtok',
          inputCostValue: cfg.vertex_input_cost_per_mtok || '',
          inputCostPlaceholder: 'e.g. 1.25',
          outputCostName: 'vertex_output_cost_per_mtok',
          outputCostValue: cfg.vertex_output_cost_per_mtok || '',
          outputCostPlaceholder: 'e.g. 5.00',
          utilityInputCostName: 'vertex_utility_input_cost_per_mtok',
          utilityInputCostValue: cfg.vertex_utility_input_cost_per_mtok || '',
          utilityInputCostPlaceholder: 'e.g. 0.08',
          utilityOutputCostName: 'vertex_utility_output_cost_per_mtok',
          utilityOutputCostValue: cfg.vertex_utility_output_cost_per_mtok || '',
          utilityOutputCostPlaceholder: 'e.g. 0.30'
        }
      ];
    %>

    <% providerSections.forEach(function(provider) { %>
      <%- include('../partials/provider-settings', provider) %>
    <% }) %>

    <section class="settings-section">
      <h2>Vertex Batch Settings</h2>
      <div class="form-row">
        <div class="form-group">
          <label for="vertex_batch_project_id">Project ID</label>
          <input type="text" id="vertex_batch_project_id" name="vertex_batch_project_id"
                 value="<%= cfg.vertex_batch_project_id || '' %>"
                 placeholder="my-google-cloud-project">
          <p class="field-hint">Required for Vertex batch jobs. Falls back to <code>VERTEX_BATCH_PROJECT_ID</code> or <code>GOOGLE_CLOUD_PROJECT</code>.</p>
        </div>
        <div class="form-group">
          <label for="vertex_batch_location">Location</label>
          <input type="text" id="vertex_batch_location" name="vertex_batch_location"
                 value="<%= cfg.vertex_batch_location || 'global' %>"
                 placeholder="global">
          <p class="field-hint">Batch inference region, usually <code>global</code> or a supported regional endpoint like <code>us-central1</code>.</p>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="vertex_batch_bucket">Cloud Storage bucket</label>
          <input type="text" id="vertex_batch_bucket" name="vertex_batch_bucket"
                 value="<%= cfg.vertex_batch_bucket || '' %>"
                 placeholder="my-vertex-batch-bucket">
          <p class="field-hint">Required. Batch inputs, uploaded page assets, and output JSONL files are staged here.</p>
        </div>
        <div class="form-group">
          <label for="vertex_batch_input_prefix">Input prefix</label>
          <input type="text" id="vertex_batch_input_prefix" name="vertex_batch_input_prefix"
                 value="<%= cfg.vertex_batch_input_prefix || 'bartelby/vertex-batch/input' %>"
                 placeholder="bartelby/vertex-batch/input">
          <p class="field-hint">Prefix inside the bucket for request JSONL files and page image assets.</p>
        </div>
      </div>
      <div class="form-group">
        <label for="vertex_batch_output_prefix">Output prefix</label>
        <input type="text" id="vertex_batch_output_prefix" name="vertex_batch_output_prefix"
               value="<%= cfg.vertex_batch_output_prefix || 'bartelby/vertex-batch/output' %>"
               placeholder="bartelby/vertex-batch/output">
        <p class="field-hint">Prefix inside the bucket where Vertex writes batch results.</p>
      </div>
      <div class="form-group">
        <label for="vertex_batch_credentials_json">Service account JSON (optional)</label>
        <textarea id="vertex_batch_credentials_json" name="vertex_batch_credentials_json" rows="8" placeholder="<%= cfg.vertex_batch_credentials_json ? 'Encrypted credentials are already stored. Paste new JSON only to replace them.' : '{\"type\":\"service_account\",...}' %>"></textarea>
        <p class="field-hint">Optional. Stored encrypted in the database like API keys. Leave blank to keep the existing secret, or to rely on <code>VERTEX_BATCH_CREDENTIALS_JSON</code>, <code>GOOGLE_APPLICATION_CREDENTIALS_JSON</code>, or ambient Application Default Credentials.</p>
        <% if (cfg.vertex_batch_credentials_json) { %>
          <p class="field-hint">An encrypted Vertex batch credentials JSON secret is already stored.</p>
        <% } %>
      </div>
      <p class="field-hint provider-settings-note">Vertex batch jobs use a Google Cloud bearer-token source. The app prefers the encrypted JSON secret above when present, then falls back to environment-based credentials or ambient Application Default Credentials. The Express Mode API key above is still used for non-batch Vertex requests.</p>
    </section>

    <section class="settings-section">
      <h2>Ollama <span class="badge-local">Local</span></h2>
      <div class="form-group">
        <label for="ollama_base_url">Base URL</label>
        <input type="text" id="ollama_base_url" name="ollama_base_url"
               value="<%= cfg.ollama_base_url || 'http://localhost:11434' %>"
               placeholder="http://localhost:11434">
      </div>
      <div class="form-group">
        <label for="ollama_model">Model</label>
        <input type="text" id="ollama_model" name="ollama_model"
               value="<%= cfg.ollama_model || 'llava' %>"
               placeholder="llava">
        <p class="field-hint">Must be a vision-capable model. Examples: <code>llava</code>, <code>llava:13b</code>, <code>llama3.2-vision</code></p>
      </div>
    </section>

    <section class="settings-section">
      <h2>LM Studio <span class="badge-local">Local</span></h2>
      <div class="form-group">
        <label for="lmstudio_base_url">Base URL</label>
        <input type="text" id="lmstudio_base_url" name="lmstudio_base_url"
               value="<%= cfg.lmstudio_base_url || 'http://localhost:1234/v1' %>"
               placeholder="http://localhost:1234/v1">
        <p class="field-hint">Enable the local server in LM Studio (port 1234 by default).</p>
      </div>
      <div class="form-group">
        <label for="lmstudio_model">Model identifier</label>
        <input type="text" id="lmstudio_model" name="lmstudio_model"
               value="<%= cfg.lmstudio_model || 'local-model' %>"
               placeholder="local-model">
        <p class="field-hint">Copy the model identifier shown in LM Studio's server log, e.g. <code>lmstudio-community/Llama-3.2-11B-Vision-Instruct-GGUF</code></p>
      </div>
    </section>

    <div class="form-actions">
      <button type="submit" class="btn-primary">Save Settings</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
