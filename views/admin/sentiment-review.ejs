<%- include('../partials/header', { pageTitle: 'Sentiment Review', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: 'sentiment-review' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Sentiment' },
    { label: 'Review' }
  ] }) %>

  <div class="admin-header entity-header">
    <h1>Sentiment Review</h1>
    <p class="entity-meta">
      <span>Approve, reject, or delete pending sentiment annotations.</span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span>Auto-approved rows are not shown.</span>
    </p>
  </div>

  <form method="get" action="" class="filter-bar">
    <label for="entity-type-filter" class="filter-bar-label">Entity type</label>
    <select id="entity-type-filter" name="entity_type" data-submit-on-change="1">
      <option value="">— all —</option>
      <% entityTypes.forEach(function(type) { %>
        <option value="<%= type %>" <%= entityTypeFilter === type ? 'selected' : '' %>><%= type %></option>
      <% }) %>
    </select>
    <noscript><button type="submit" class="btn-secondary btn-sm">Filter</button></noscript>
  </form>

  <div class="bulk-toolbar bulk-toolbar--sticky bulk-toolbar--suggestions">
    <label class="bulk-toolbar-select-all">
      <input type="checkbox" id="sentiment-select-all">
      <span>Select all on page</span>
    </label>
    <div id="sentiment-bulk-actions" class="bulk-toolbar-actions bulk-actions is-hidden">
      <span id="sentiment-bulk-count" class="bulk-toolbar-count">0 selected</span>
      <button type="button" id="sentiment-bulk-approve" class="btn-primary btn-sm">Approve selected</button>
      <button type="button" id="sentiment-bulk-reject"  class="btn-secondary btn-sm">Reject selected</button>
      <button type="button" id="sentiment-bulk-clear"   class="btn-link btn-sm">Clear</button>
    </div>
  </div>

  <div id="sentiment-list" class="knowledge-citation-list">
    <% if (!annotations.length) { %>
      <div class="empty-state" data-empty-state>
        <p>No pending sentiment annotations.</p>
      </div>
    <% } else { %>
      <% annotations.forEach(function(a) { %>
        <article class="knowledge-citation-card sentiment-annotation-card"
                 data-annotation-id="<%= a.id %>">
          <div class="authority-suggestion-card-header authority-suggestion-card-header--selectable">
            <input type="checkbox" class="sentiment-cb authority-suggestion-checkbox" value="<%= a.id %>">
            <div class="authority-suggestion-title-group">
              <span class="authority-suggestion-kicker">Pending sentiment annotation</span>
              <h2><%= a.target_kind === 'entity' ? ('Entity #' + a.target_entity_id) : (a.target_phrase || a.target_kind) %></h2>
              <div class="authority-suggestion-meta">
                <span class="status-badge status-running"><%= a.polarity %> · <%= a.intensity %></span>
                <span class="authority-suggestion-meta-note">voice: <%= a.voice_role %></span>
                <span class="authority-suggestion-meta-note">confidence: <%= Number(a.confidence || 0).toFixed(2) %></span>
                <% if (a.register === 'conventional') { %>
                  <span class="s-chip s-chip--register s-chip--register-conventional"
                        title="Formulaic epistolary performance — register describes the form, not sincerity">conventional</span>
                <% } %>
              </div>
            </div>
          </div>

          <% if (a.review_note && a.review_note.indexOf('Flagged for review') === 0) { %>
            <div class="sentiment-flag-notice" data-review-flag-note>
              <span class="sentiment-flag-notice-icon" aria-hidden="true">⚑</span>
              <span class="sentiment-flag-notice-text"><%= a.review_note %></span>
            </div>
          <% } %>

          <div class="authority-suggestion-context">
            <section class="authority-suggestion-context-section" aria-label="Evidence">
              <span class="authority-suggestion-section-label">Evidence</span>
              <blockquote class="authority-suggestion-evidence"><%= a.evidence_excerpt %></blockquote>
            </section>
            <section class="authority-suggestion-context-section" aria-label="Phrase">
              <span class="authority-suggestion-section-label">Emotion phrase</span>
              <p class="authority-suggestion-document"><%= a.emotion_phrase_verbatim %></p>
            </section>
          </div>

          <% if (a.emotion_about_phrase_verbatim) { %>
            <div class="annotation-about" data-emotion-about="true">
              <span class="annotation-about-label">About:</span>
              <span class="annotation-about-verbatim"><%= a.emotion_about_phrase_verbatim %></span>
              <% if (a.emotion_about_earliest || a.emotion_about_latest) { %>
                <small class="muted">
                  <% if (a.emotion_about_earliest && a.emotion_about_latest && a.emotion_about_earliest === a.emotion_about_latest) { %>
                    (<%= a.emotion_about_earliest %>)
                  <% } else { %>
                    (<%= a.emotion_about_earliest || '?' %>
                    – <%= a.emotion_about_latest || '?' %>)
                  <% } %>
                  <% if (a.emotion_about_precision) { %>
                    • precision <%= a.emotion_about_precision %>
                  <% } %>
                  <% if (a.emotion_about_qualifier) { %>
                    • <%= a.emotion_about_qualifier %>
                  <% } %>
                </small>
              <% } else if (a.emotion_about_qualifier) { %>
                <small class="muted">(<%= a.emotion_about_qualifier %>)</small>
              <% } %>
            </div>
          <% } %>

          <div class="authority-suggestion-card-footer">
            <button type="button" class="btn-primary   btn-sm" data-action="approve" data-annotation-id="<%= a.id %>">Approve</button>
            <button type="button" class="btn-secondary btn-sm" data-action="reject"  data-annotation-id="<%= a.id %>">Reject</button>
            <button type="button" class="btn-link      btn-sm" data-action="delete"  data-annotation-id="<%= a.id %>">Delete</button>
            <span class="inline-error" hidden></span>
          </div>
        </article>
      <% }) %>
    <% } %>
  </div>

  <% if (nextCursor) { %>
    <div id="sentiment-load-more"
         data-before-created-at="<%= nextCursor.beforeCreatedAt %>"
         data-before-id="<%= nextCursor.beforeId %>">
      <button type="button" class="btn-secondary">Load more</button>
    </div>
  <% } %>

  <div id="sentiment-toast" class="toast" role="status" aria-live="polite" hidden></div>
</div>

<script type="application/json" id="sentiment-bootstrap">
  <%- JSON.stringify({ pageSize: pageSize }) %>
</script>
<script src="/js/admin-sentiment-review.js"></script>

<%- include('../partials/footer') %>
