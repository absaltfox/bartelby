<%- include('../partials/header', { pageTitle: 'Knowledge', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'overview' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge' }
  ] }) %>

  <%
    // Header meta line — per docs/ui-template-standards.md § Header meta
    // line. Numbers fold into the inline row and the right-side nav
    // shortcuts. The stat-card block that used to precede the sections
    // below is gone; anything actionable moves to sub-nav links, and
    // job-queue orientation ("N running") reads as inline meta.
    var _extRun = (extractionCounts && extractionCounts.running) || 0;
    var _extFail = (extractionCounts && extractionCounts.failed) || 0;
    var _extQueued = (extractionCounts && extractionCounts.queued) || 0;
    var _pendingLinks = authoritySuggestionCount || 0;
  %>
  <div class="admin-header entity-header">
    <h1>Knowledge</h1>
    <p class="entity-meta">
      <span><%= authorityCount || 0 %> authorit<%= (authorityCount || 0) === 1 ? 'y' : 'ies' %></span>
      <% if (_extRun > 0 || _extQueued > 0) { %>
        <span class="entity-meta__sep" aria-hidden="true">·</span>
        <span>
          <% if (_extRun > 0) { %>
            <a href="/admin/jobs?filter=running&type=extraction" title="View running extraction jobs"><%= _extRun %> extraction<%= _extRun === 1 ? '' : 's' %> running</a>
          <% } %>
          <% if (_extRun > 0 && _extQueued > 0) { %>, <% } %>
          <% if (_extQueued > 0) { %>
            <a href="/admin/jobs?filter=queued&type=extraction" title="View queued extraction jobs"><%= _extQueued %> queued</a>
          <% } %>
        </span>
      <% } %>
      <% if (_extFail > 0) { %>
        <span class="entity-meta__sep" aria-hidden="true">·</span>
        <span class="entity-meta__warn">
          <a href="/admin/jobs?filter=failed&type=extraction" title="View the failed extraction jobs to diagnose">
            <%= _extFail %> extraction<%= _extFail === 1 ? '' : 's' %> failed
          </a>
        </span>
      <% } %>
      <span class="entity-meta__nav">
        <a href="/admin/knowledge/entities">Entities</a>
        <a href="/admin/knowledge/authorities">Authorities</a>
        <% if (_pendingLinks > 0) { %>
          <a href="/admin/knowledge/authorities/suggestions">Review suggestions <span class="filter-count"><%= _pendingLinks %></span></a>
        <% } %>
        <a href="/admin/knowledge/review-extractions">Review extractions</a>
      </span>
    </p>
    <p class="entity-detail__section-meta">
      Manage entity extraction, approve graph evidence, and re-run knowledge graph generation for existing materials.
    </p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <% if (queuedDocumentTitle) { %>
    <div class="alert alert-success">
      Queued a fresh extraction run for <strong><%= queuedDocumentTitle %></strong>. Existing graph artifacts for that transcript will be replaced when the job starts.
    </div>
  <% } %>

  <% if (queuedCollectionName) { %>
    <div class="alert alert-success">
      <% if (queuedMode === 'batch') { %>
        Queued <strong>1 provider batch job</strong> for <strong><%= queuedCollectionName %></strong>, covering <strong><%= queuedCount %></strong> document<%= queuedCount !== 1 ? 's' : '' %>.
      <% } else { %>
        Queued <strong><%= queuedCount %></strong> extraction job<%= queuedCount !== 1 ? 's' : '' %> for <strong><%= queuedCollectionName %></strong>.
      <% } %>
      <% if (skippedPending || skippedNoTranscript) { %>
        <span class="muted">
          Skipped <%= skippedPending %> already in progress and <%= skippedNoTranscript %> without transcripts.
        </span>
      <% } %>
    </div>
  <% } %>
  <% if (queuedBackfill) { %>
    <div class="alert alert-success">Queued <strong><%= queuedBackfill %></strong> authority backfill job<%= queuedBackfill !== 1 ? 's' : '' %>.</div>
  <% } %>
  <% if (suggestionJobQueued) { %>
    <div class="alert alert-success">Authority suggestion job #<%= parseInt(suggestionJobQueued, 10) %> queued.</div>
  <% } %>

  <section class="settings-section knowledge-overview-section">
    <div class="knowledge-overview-header">
      <div>
        <h2>Queue Re-extraction</h2>
        <p class="subtitle">Choose a single document or an entire collection and Bartelby will rebuild the graph artifacts from the current best transcript.</p>
      </div>
    </div>

    <div class="knowledge-admin-grid">
      <section class="knowledge-task-card">
        <h3>Re-run One Document</h3>
        <p class="muted">Use the current best transcript for one document and replace the knowledge graph artifacts generated from that transcript.</p>
        <form method="POST" action="/admin/knowledge/documents/reextract" class="edit-form" data-knowledge-document-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" id="knowledge_document_id" name="document_id" required>
          <div class="edit-field">
            <label for="knowledge-document-search">Document</label>
            <input
              type="search"
              id="knowledge-document-search"
              class="admin-search-input knowledge-document-search-input"
              placeholder="Search documents with transcripts..."
              autocomplete="off"
              spellcheck="false"
              aria-describedby="knowledge-document-search-help"
              data-knowledge-document-search
            >
            <p class="muted knowledge-document-search-help" id="knowledge-document-search-help">Search by title, transcript text, author, or location. Start typing to load matching documents.</p>
            <div class="knowledge-document-selection" data-knowledge-document-selected hidden></div>
            <div class="knowledge-document-results" data-knowledge-document-results hidden></div>
          </div>
          <div class="edit-actions">
            <button type="submit" class="btn-primary btn-sm">Queue Document Re-extraction</button>
          </div>
        </form>
      </section>

      <section class="knowledge-task-card">
        <h3>Re-run One Collection</h3>
        <p class="muted">Queue a fresh extraction run for every transcript-bearing document in a collection. When the provider supports it and more than one document is eligible, Bartelby submits the rerun as a single provider batch job.</p>
        <form method="POST" action="/admin/knowledge/collections/reextract" class="edit-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="edit-field">
            <label for="knowledge_collection_id">Collection</label>
            <select id="knowledge_collection_id" name="collection_id" required>
              <option value="">Select a collection...</option>
              <% collections.forEach(function(collection) { %>
                <option value="<%= collection.id %>"><%= collection.name %> (<%= collection.document_count || 0 %> documents)</option>
              <% }) %>
            </select>
          </div>
          <div class="edit-actions">
            <button type="submit" class="btn-primary btn-sm">Queue Collection Re-extraction</button>
          </div>
        </form>
        <% if (collections && collections.length > 0) { %>
          <p class="field-hint">
            View a single collection's knowledge workbench:
            <% collections.forEach(function(collection, idx) { %>
              <a href="/manage/collections/<%= collection.id %>/knowledge" class="muted-link"><%= collection.name %></a><%= idx < collections.length - 1 ? ', ' : '' %>
            <% }) %>
          </p>
        <% } %>
      </section>
    </div>
  </section>

  <section class="settings-section knowledge-overview-section">
    <div class="knowledge-overview-header">
      <div>
        <h2>Authority Maintenance</h2>
        <p class="subtitle">Refresh cross-document identity work without changing extraction evidence.</p>
      </div>
    </div>

    <div class="knowledge-admin-grid">
      <section class="knowledge-task-card">
        <h3>Queue Authority Backfill</h3>
        <p class="muted">Creates durable jobs for unresolved entities so Bartelby can attach them to existing authorities or create new authority records without re-running transcript extraction.</p>
        <form method="POST" action="/admin/knowledge/authorities/backfill" class="edit-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="edit-actions">
            <button type="submit" class="btn-primary btn-sm">Queue Authority Backfill</button>
          </div>
        </form>
      </section>

      <section class="knowledge-task-card">
        <h3>Run Authority Suggestions</h3>
        <p class="muted">Runs the full-corpus authority suggestion pipeline, comparing unresolved entities against authority clusters and adding medium-confidence links to the review queue.</p>
        <form method="POST" action="/admin/knowledge/authorities/suggestion-jobs" class="edit-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="edit-actions">
            <button type="submit" class="btn-secondary btn-sm">Run Authority Suggestions</button>
          </div>
        </form>
      </section>
    </div>
  </section>

  <section class="settings-section knowledge-guidance-section">
    <div class="knowledge-overview-header">
      <div>
        <h2>How Knowledge Runs Work</h2>
      </div>
    </div>
    <div class="knowledge-guidance-grid">
      <div class="knowledge-guidance-card">
        <h3>Approval rules</h3>
        <p class="muted">High-confidence evidence is auto-approved. Lower-confidence evidence stays hidden until a human approves it in Review.</p>
      </div>
      <div class="knowledge-guidance-card">
        <h3>Authority backfill</h3>
        <p class="muted">Legacy entities can be assigned to authorities without re-running extraction. Use the Authorities workspace to queue backfill jobs.</p>
      </div>
      <div class="knowledge-guidance-card">
        <h3>Batch behavior</h3>
        <p class="muted">Single-document reruns stay as ordinary queued jobs. Collection reruns use provider batch APIs when OpenAI, Claude, or Gemini is configured and more than one document is eligible.</p>
      </div>
      <div class="knowledge-guidance-card">
        <h3>Replacement timing</h3>
        <p class="muted">Existing graph state remains in place until the queued job starts successfully, at which point the current transcript’s artifacts are rebuilt.</p>
      </div>
    </div>
  </section>
</div>

<script src="/js/knowledge-page.js"></script>
<%- include('../partials/footer') %>
