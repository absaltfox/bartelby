<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav') %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Sentiment' },
    { label: 'Labels' }
  ] }) %>

  <div class="admin-header entity-header">
    <h1>Sentiment Phrase Labels</h1>
    <p class="entity-meta">
      <span><%= summary.total_labels %> label<%= summary.total_labels === 1 ? '' : 's' %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span>
        <%= summary.total_labeled_phrases %> of <%= summary.total_phrases %> phrases labeled
        (<%= summary.total_phrases > 0
            ? ((summary.total_labeled_phrases / summary.total_phrases) * 100).toFixed(1)
            : '0.0' %>%)
      </span>
    </p>
  </div>

  <% if (labels.length === 0) { %>
    <div class="empty-state empty-state--padded-lg">
      <h2>No labels yet</h2>
      <p>Labels are created from clusters. Visit the Clusters tab, review cluster members,
        and click "Label →" to apply your first label.</p>
      <p><a href="/admin/knowledge/sentiment/clusters" class="btn-primary">Go to Clusters</a></p>
    </div>
  <% } else { %>
    <table class="workflows-table" id="labels-table">
      <thead>
        <tr>
          <th scope="col">Label</th>
          <th scope="col">Phrases</th>
          <th scope="col">Created</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (const l of labels) { %>
          <tr data-label-id="<%= l.id %>">
            <td class="labels-name-cell"><span class="labels-name-text"><%= l.name %></span></td>
            <td class="labels-count-cell"><%= l.phrase_count %></td>
            <td><%= l.created_at %></td>
            <td>
              <button type="button" class="btn-link btn-sm labels-rename-btn">rename</button>
              <button type="button" class="btn-link btn-sm labels-delete-btn">delete</button>
              <span class="save-status labels-row-status"></span>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>
</div>

<script src="/js/sentiment-labels-page.js" defer></script>
<%- include('../partials/footer') %>
