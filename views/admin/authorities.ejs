<%- include('../partials/header', { pageTitle: 'Authorities', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <div class="admin-header">
    <h1>Authorities</h1>
    <p class="subtitle">Manage cross-document identity clusters that group extracted entities into shared people, places, organizations, and topics.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (bulkDeleted) { %>
    <div class="alert alert-success">Deleted <strong><%= bulkDeleted %></strong> authorit<%= bulkDeleted === 1 ? 'y' : 'ies' %>.</div>
  <% } %>
  <% if (bulkMerged) { %>
    <div class="alert alert-success">Merged <strong><%= bulkMerged %></strong> authorit<%= bulkMerged === 1 ? 'y' : 'ies' %> into the selected authority.</div>
  <% } %>

  <div class="admin-stats">
    <div class="stat-card">
      <div class="stat-value"><%= totalCount || 0 %></div>
      <div class="stat-label">Authorities</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= suggestionCount || 0 %></div>
      <div class="stat-label">Pending Suggestions</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= authorityJobCounts.queued || 0 %></div>
      <div class="stat-label">Queued Backfill Jobs</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= authorityJobCounts.running || 0 %></div>
      <div class="stat-label">Running Backfill Jobs</div>
    </div>
  </div>

  <div class="knowledge-toolbar knowledge-toolbar--spaced">
    <form method="GET" action="/admin/knowledge/authorities" class="admin-search-form">
      <input type="search" name="q" value="<%= q %>" placeholder="Search authorities, members, or aliases..." class="admin-search-input">
      <select name="type" aria-label="Filter by authority type">
        <option value="">All types</option>
        <% authorityTypes.forEach(function(option) { %>
          <option value="<%= option.authority_type %>" <%= typeFilter === option.authority_type ? 'selected' : '' %>><%= option.authority_type %> (<%= option.count %>)</option>
        <% }) %>
      </select>
      <input type="hidden" name="sort" value="<%= sort %>">
      <input type="hidden" name="direction" value="<%= direction %>">
      <button type="submit" class="btn-secondary btn-sm">Search</button>
      <% if (q || typeFilter || sort !== 'name' || direction !== 'asc') { %>
        <a href="/admin/knowledge/authorities" class="btn-secondary btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <%- include('../partials/knowledge/authorities-list', {
    authorities: authorities,
    q: q,
    typeFilter: typeFilter,
    sort: sort,
    direction: direction,
    totalCount: totalCount,
    totalPages: totalPages,
    currentPage: currentPage,
    csrfToken: csrfToken,
    currentUrl: currentUrl,
    authorityListPath: authorityListPath,
    urlPrefix: '/admin/knowledge'
  }) %>
</div>

<script src="/js/admin-authorities.js"></script>
<%- include('../partials/footer') %>
