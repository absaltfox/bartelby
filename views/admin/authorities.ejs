<%- include('../partials/header', { pageTitle: 'Authorities', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <div class="admin-header">
    <h1>Authorities</h1>
    <p class="subtitle">Manage cross-document identity clusters that group extracted entities into shared people, places, organizations, and topics.</p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (bulkDeleted) { %>
    <div class="alert alert-success">Deleted <strong><%= bulkDeleted %></strong> authorit<%= bulkDeleted === 1 ? 'y' : 'ies' %>.</div>
  <% } %>
  <% if (bulkMerged) { %>
    <div class="alert alert-success">Merged <strong><%= bulkMerged %></strong> authorit<%= bulkMerged === 1 ? 'y' : 'ies' %> into the selected authority.</div>
  <% } %>

  <div class="admin-stats">
    <div class="stat-card">
      <div class="stat-value"><%= totalCount || 0 %></div>
      <div class="stat-label">Authorities</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= suggestionCount || 0 %></div>
      <div class="stat-label">Pending Suggestions</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= authorityJobCounts.queued || 0 %></div>
      <div class="stat-label">Queued Backfill Jobs</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= authorityJobCounts.running || 0 %></div>
      <div class="stat-label">Running Backfill Jobs</div>
    </div>
  </div>

  <div class="knowledge-toolbar knowledge-toolbar--spaced">
    <form method="GET" action="/admin/knowledge/authorities" class="admin-search-form">
      <input type="search" name="q" value="<%= q %>" placeholder="Search authorities, members, or aliases..." class="admin-search-input">
      <select name="type" aria-label="Filter by authority type">
        <option value="">All types</option>
        <% authorityTypes.forEach(function(option) { %>
          <option value="<%= option.authority_type %>" <%= typeFilter === option.authority_type ? 'selected' : '' %>><%= option.authority_type %> (<%= option.count %>)</option>
        <% }) %>
      </select>
      <input type="hidden" name="sort" value="<%= sort %>">
      <input type="hidden" name="direction" value="<%= direction %>">
      <button type="submit" class="btn-secondary btn-sm">Search</button>
      <% if (q || typeFilter || sort !== 'name' || direction !== 'asc') { %>
        <a href="/admin/knowledge/authorities" class="btn-secondary btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <% if (authorities.length === 0) { %>
    <div class="empty-state">
      <p>No authorities found<% if (q) { %> for "<%= q %>"<% } %><% if (typeFilter) { %> with type "<%= typeFilter %>"<% } %>.</p>
    </div>
  <% } else { %>
    <form method="POST" action="/admin/knowledge/authorities/bulk/merge" class="authority-bulk-form" data-authority-bulk-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="returnTo" value="<%= currentUrl %>">
      <div class="bulk-toolbar suggestions-bulk-controls">
        <label class="bulk-toolbar-select-all suggestions-select-all">
          <input type="checkbox" id="authorities-select-all" data-authorities-select-all>
          <span>Select all on page</span>
        </label>
        <div class="bulk-toolbar-actions bulk-actions is-hidden" data-authorities-bulk-actions>
          <span class="bulk-toolbar-count" data-authorities-bulk-count>0 selected</span>
          <label class="inline-form">
            Keep
            <select name="target_authority_id" data-authorities-merge-target>
              <option value="">Choose authority...</option>
              <% authorities.forEach(function(authority) { %>
                <option value="<%= authority.id %>"><%= authority.canonical_name %> (<%= authority.authority_type %>)</option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn-secondary btn-sm" data-authorities-bulk-merge>Merge selected into target</button>
          <button type="submit" class="btn-danger btn-sm" formaction="/admin/knowledge/authorities/bulk/delete" data-authorities-bulk-delete>Delete selected</button>
        </div>
      </div>

      <div class="workflows-table-wrap">
        <table class="workflows-table">
          <thead>
            <tr>
              <th scope="col">Select</th>
              <th scope="col">
                <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: 'type', direction: sort === 'type' && direction === 'asc' ? 'desc' : 'asc' }) %>">Type<%= sort === 'type' ? (direction === 'asc' ? ' ↑' : ' ↓') : '' %></a>
              </th>
              <th scope="col">
                <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: 'name', direction: sort === 'name' && direction === 'asc' ? 'desc' : 'asc' }) %>">Authority<%= sort === 'name' ? (direction === 'asc' ? ' ↑' : ' ↓') : '' %></a>
              </th>
              <th scope="col">
                <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: 'members', direction: sort === 'members' && direction === 'desc' ? 'asc' : 'desc' }) %>">Members<%= sort === 'members' ? (direction === 'asc' ? ' ↑' : ' ↓') : '' %></a>
              </th>
              <th scope="col">
                <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: 'documents', direction: sort === 'documents' && direction === 'desc' ? 'asc' : 'desc' }) %>">Documents<%= sort === 'documents' ? (direction === 'asc' ? ' ↑' : ' ↓') : '' %></a>
              </th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% authorities.forEach(function(authority) { %>
              <tr>
                <td><input type="checkbox" class="authority-cb" name="authority_ids" value="<%= authority.id %>" data-authority-checkbox></td>
                <td><span class="entity-type-badge entity-type-<%= authority.authority_type %>"><%= authority.authority_type %></span></td>
                <td>
                  <strong><a href="/admin/knowledge/authorities/<%= authority.id %>"><%= authority.canonical_name %></a></strong>
                  <% if (authority.description) { %>
                    <div class="muted"><%= authority.description %></div>
                  <% } %>
                </td>
                <td><%= authority.member_count || 0 %></td>
                <td><%= authority.document_count || 0 %></td>
                <td><a href="/admin/knowledge/authorities/<%= authority.id %>" class="btn-secondary btn-sm">Open</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </form>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: sort, direction: direction, page: currentPage - 1 }) %>" class="pagination-btn">&lsaquo; Prev</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">&lsaquo; Prev</span>
        <% } %>
        <span class="pagination-info">Page <%= currentPage %> of <%= totalPages %> <span class="muted">(<%= totalCount %> authorities)</span></span>
        <% if (currentPage < totalPages) { %>
          <a href="<%= authorityListPath({ q: q, type: typeFilter, sort: sort, direction: direction, page: currentPage + 1 }) %>" class="pagination-btn">Next &rsaquo;</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">Next &rsaquo;</span>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<script src="/js/admin-authorities.js"></script>
<%- include('../partials/footer') %>
