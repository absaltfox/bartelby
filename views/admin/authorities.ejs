<%- include('../partials/header', { pageTitle: 'Authorities', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Authorities' }
  ] }) %>

  <%
    // Header meta line — per docs/ui-template-standards.md § Header meta
    // line. Total authority count + running-job hint sit inline; the
    // stat-card block that used to precede the list is removed. Pending
    // suggestion and backfill affordances live in the sub-nav row below.
    var _runningJobs = (authorityJobCounts && authorityJobCounts.running) || 0;
    var _queuedJobs = (authorityJobCounts && authorityJobCounts.queued || 0);
    var _pendingSug = suggestionCount || 0;
  %>
  <div class="admin-header entity-header">
    <h1>Authorities</h1>
    <p class="entity-meta">
      <span><%= totalCount || 0 %> total</span>
      <% if (_runningJobs > 0) { %>
        <span class="entity-meta__sep" aria-hidden="true">·</span>
        <span><%= _runningJobs %> backfill job<%= _runningJobs === 1 ? '' : 's' %> running</span>
      <% } else if (_queuedJobs > 0) { %>
        <span class="entity-meta__sep" aria-hidden="true">·</span>
        <span><%= _queuedJobs %> backfill job<%= _queuedJobs === 1 ? '' : 's' %> queued</span>
      <% } %>
      <span class="entity-meta__nav">
        <% if (_pendingSug > 0) { %>
          <a href="/admin/knowledge/authorities/suggestions">Review suggestions <span class="filter-count"><%= _pendingSug %></span></a>
        <% } %>
        <a href="/admin/knowledge/authorities/backfill">Backfill</a>
        <a href="/admin/knowledge/authorities/generic-terms">Generic terms</a>
      </span>
    </p>
    <p class="entity-detail__section-meta">
      Cross-document identity clusters that group extracted entities into shared people, places, organizations, and topics.
    </p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (bulkDeleted) { %>
    <div class="alert alert-success">Deleted <strong><%= bulkDeleted %></strong> authorit<%= bulkDeleted === 1 ? 'y' : 'ies' %>.</div>
  <% } %>
  <% if (bulkMerged) { %>
    <div class="alert alert-success">Merged <strong><%= bulkMerged %></strong> authorit<%= bulkMerged === 1 ? 'y' : 'ies' %> into the selected authority.</div>
  <% } %>

  <div class="knowledge-toolbar knowledge-toolbar--spaced">
    <form method="GET" action="/admin/knowledge/authorities" class="admin-search-form">
      <input type="search" name="q" value="<%= q %>" placeholder="Search authorities, members, or aliases..." class="admin-search-input">
      <select name="type" aria-label="Filter by authority type">
        <option value="">All types</option>
        <% authorityTypes.forEach(function(option) { %>
          <option value="<%= option.authority_type %>" <%= typeFilter === option.authority_type ? 'selected' : '' %>><%= option.authority_type %> (<%= option.count %>)</option>
        <% }) %>
      </select>
      <input type="hidden" name="sort" value="<%= sort %>">
      <input type="hidden" name="direction" value="<%= direction %>">
      <button type="submit" class="btn-secondary btn-sm">Search</button>
      <% if (q || typeFilter || sort !== 'name' || direction !== 'asc') { %>
        <a href="/admin/knowledge/authorities" class="btn-secondary btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <%- include('../partials/knowledge/authorities-list', {
    authorities: authorities,
    q: q,
    typeFilter: typeFilter,
    sort: sort,
    direction: direction,
    totalCount: totalCount,
    totalPages: totalPages,
    currentPage: currentPage,
    csrfToken: csrfToken,
    currentUrl: currentUrl,
    authorityListPath: authorityListPath,
    urlPrefix: '/admin/knowledge'
  }) %>
</div>

<script src="/js/admin-authorities.js"></script>
<%- include('../partials/footer') %>
