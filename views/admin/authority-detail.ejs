<%- include('../partials/header', { pageTitle: authority.canonical_name, query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <div class="admin-header authority-workspace-header">
    <div>
      <h1><%= authority.canonical_name %></h1>
      <p class="subtitle">
        <span class="entity-type-badge entity-type-<%= authority.authority_type %>"><%= authority.authority_type %></span>
        Authority cluster
      </p>
    </div>
    <div class="authority-workspace-stats" aria-label="Authority summary">
      <div><strong><%= authorityWorkspace.summary.memberCount %></strong><span>Members</span></div>
      <div><strong><%= authorityWorkspace.summary.documentCount %></strong><span>Documents</span></div>
      <div><strong><%= authorityWorkspace.summary.aliasCount %></strong><span>Aliases</span></div>
      <div><strong><%= authorityWorkspace.summary.citationCount %></strong><span>Citations</span></div>
      <div><strong><%= authorityWorkspace.summary.relationshipCount %></strong><span>Edges</span></div>
    </div>
  </div>

  <%- include('../partials/flash-alerts', { flashes }) %>

  <div class="knowledge-toolbar knowledge-toolbar--spaced">
    <a href="/admin/knowledge/authorities" class="btn-secondary btn-sm">&larr; Back to authorities</a>
    <a href="/admin/knowledge/authorities/suggestions" class="btn-secondary btn-sm">Review Suggestions</a>
    <a href="/admin/knowledge/authorities/<%= authority.id %>/chronology" class="btn-secondary btn-sm">
      Chronology
    </a>
    <details class="toolbar-details" data-authority-relationship-members>
      <summary class="btn-secondary btn-sm">+ Add relationship from a member</summary>
      <div class="toolbar-details-menu">
        <% if (Array.isArray(linkedEntities) && linkedEntities.length) { %>
          <% linkedEntities.forEach(function(member) { %>
            <a class="toolbar-details-menu-item"
               href="/admin/knowledge/relationships/new?sourceEntityId=<%= member.id %>">
              <%= member.canonical_name %><% if (member.entity_type) { %> <span class="muted">(<%= member.entity_type %>)</span><% } %>
            </a>
          <% }) %>
        <% } else { %>
          <p class="toolbar-details-menu-empty muted">No member entities linked to this authority yet.</p>
        <% } %>
      </div>
    </details>
  </div>

  <section class="authority-workspace" data-authority-workspace>
    <div class="graph-shell-card knowledge-card authority-member-browser">
      <div class="graph-sidebar-header authority-workspace-panel-header">
        <div>
          <p class="kg-panel-eyebrow">Members</p>
          <h2>Linked entities</h2>
        </div>
        <span class="status-badge"><%= authorityWorkspace.summary.memberCount %></span>
      </div>
      <div class="graph-sidebar-body authority-member-browser-body">
        <label class="sr-only" for="authority-member-filter-<%= authority.id %>">Filter linked entities</label>
        <input
          type="search"
          id="authority-member-filter-<%= authority.id %>"
          class="admin-search-input authority-member-filter"
          placeholder="Filter by name, id, or type..."
          autocomplete="off"
          data-authority-member-filter
        >

        <% if (!members.length) { %>
          <p class="graph-empty-state">No member entities are linked to this authority.</p>
        <% } else { %>
          <div class="authority-member-list" data-authority-member-list>
            <% members.forEach(function(member, index) { %>
              <a
                href="/admin/knowledge/entities/<%= member.id %>"
                class="authority-member-row <%= index === 0 ? 'is-selected' : '' %>"
                data-authority-member-id="<%= member.id %>"
                data-authority-member-search="<%= [member.id, member.canonical_name, member.entity_type].join(' ').toLowerCase() %>"
              >
                <span>
                  <strong><%= member.canonical_name %></strong>
                  <span class="graph-muted">Entity #<%= member.id %> &bull; <%= member.entity_type %></span>
                </span>
                <span class="authority-member-row-meta">
                  <span><%= member.document_count %> docs</span>
                  <span><%= member.citation_count %> cites</span>
                  <span><%= member.relationship_count %> edges</span>
                </span>
              </a>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="graph-shell-card knowledge-card authority-context-panel">
      <div class="graph-sidebar-header authority-workspace-panel-header">
        <div>
          <p class="kg-panel-eyebrow">Selected member</p>
          <h2 data-authority-selected-title><%= members[0] ? members[0].canonical_name : 'No entity selected' %></h2>
        </div>
        <a class="btn-secondary btn-sm" href="<%= members[0] ? '/admin/knowledge/entities/' + members[0].id : '/admin/knowledge/entities' %>" data-authority-selected-link>Open Entity</a>
      </div>
      <div class="graph-sidebar-body">
        <div class="authority-selected-meta" data-authority-selected-meta></div>

        <div class="authority-detail-tabs" role="tablist" aria-label="Selected member detail">
          <button type="button" class="authority-detail-tab active" data-authority-detail-tab="citations">Citations</button>
          <button type="button" class="authority-detail-tab" data-authority-detail-tab="edges">Connected edges</button>
          <button type="button" class="authority-detail-tab" data-authority-detail-tab="manage">Manage</button>
        </div>

        <div class="authority-detail-panel" data-authority-detail-panel></div>
      </div>
    </div>
  </section>

  <div class="authority-secondary-grid">
    <section class="graph-shell-card knowledge-card">
      <div class="graph-sidebar-header">
        <p class="kg-panel-eyebrow">Aliases</p>
        <h2>Rolled-up names</h2>
      </div>
      <div class="graph-sidebar-body">
        <% if (!aliases.length) { %>
          <p class="graph-empty-state">No member aliases are recorded.</p>
        <% } else { %>
          <div class="graph-alias-list authority-compact-list">
            <% aliases.forEach(function(alias) { %>
              <div class="graph-detail-card">
                <strong><%= alias.alias %></strong>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

<% if (sentimentSummary && sentimentSummary.length > 0) { %>
      <%- include('partials/sentiment-kg-card', {
        summary: sentimentSummary,
        list: sentimentList,
        heading: 'Across all member entities',
        workbenchHref: '/sentiment?authority_id=' + authority.id
      }) %>
    <% } %>

    <section class="danger-zone">
      <h2>Danger zone</h2>
      <p class="curator-action-note">Merging authorities is irreversible.
        Members and citations of the source authority are re-parented onto
        the target, and the source is deleted.</p>
      <div class="graph-shell-card knowledge-card">
        <div class="graph-sidebar-header">
          <p class="kg-panel-eyebrow">Merge</p>
          <h2>Merge into another authority</h2>
        </div>
        <div class="graph-sidebar-body">
          <form method="POST" action="/admin/knowledge/authorities/<%= authority.id %>/merge" class="edit-form authority-picker-form" data-authority-picker-form data-authority-type="<%= authority.authority_type %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="target_authority_id" value="" data-authority-id required>
            <div class="edit-field">
              <label for="authority-merge-search-<%= authority.id %>">Target authority</label>
              <input
                type="search"
                id="authority-merge-search-<%= authority.id %>"
                class="admin-search-input"
                placeholder="Search the authority to keep..."
                autocomplete="off"
                spellcheck="false"
                data-authority-search
              >
            </div>
            <div class="knowledge-document-selection" data-authority-selected hidden></div>
            <div class="knowledge-document-results" data-authority-results hidden></div>
            <div class="edit-actions">
              <button type="submit" class="btn-danger btn-sm">Merge Authority</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>

  <script type="application/json" id="authority-workspace-data"><%- JSON.stringify({
    authority: {
      id: authority.id,
      canonical_name: authority.canonical_name,
      authority_type: authority.authority_type
    },
    csrfToken,
    members: authorityWorkspace.members,
    citationsByEntityId: authorityWorkspace.citationsByEntityId,
    relationshipsByEntityId: authorityWorkspace.relationshipsByEntityId
  }).replace(/</g, '\\u003c') %></script>
</div>

<script src="/js/authority-picker.js"></script>
<script src="/js/authority-detail-page.js"></script>
<script src="/js/sentiment-card-renderer.js"></script>
<%- include('../partials/footer') %>
