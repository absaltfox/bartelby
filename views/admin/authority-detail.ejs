<%- include('../partials/header', { pageTitle: authority.canonical_name, query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Authorities', href: '/admin/knowledge/authorities' },
    { label: authority.canonical_name }
  ] }) %>

  <%
    // Header meta line — per docs/ui-template-standards.md § Header meta line.
    // The stat block (5 cards: members, docs, aliases, citations, edges) is
    // gone; the same numbers now render inline as scannable orientation.
    // Chronology and Review suggestions are folded into the header meta line
    // as pure-navigation text links (right-aligned via .entity-meta__nav).
    var _summary = authorityWorkspace.summary;
  %>
  <div class="admin-header entity-header">
    <h1><%= authority.canonical_name %></h1>
    <p class="entity-meta">
      <span class="entity-type-badge entity-type-<%= authority.authority_type %>"><%= authority.authority_type %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span class="entity-meta__id">id <%= authority.id %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span><%= _summary.memberCount %> member<%= _summary.memberCount === 1 ? '' : 's' %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span><%= _summary.documentCount %> document<%= _summary.documentCount === 1 ? '' : 's' %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span><%= _summary.aliasCount %> alias<%= _summary.aliasCount === 1 ? '' : 'es' %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span><%= _summary.citationCount %> citation<%= _summary.citationCount === 1 ? '' : 's' %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span><%= _summary.relationshipCount %> edge<%= _summary.relationshipCount === 1 ? '' : 's' %></span>
      <span class="entity-meta__nav">
        <a href="/admin/knowledge/authorities/<%= authority.id %>/chronology">Chronology</a>
        <a href="/admin/knowledge/authorities/suggestions">Review suggestions</a>
      </span>
    </p>
  </div>

  <%- include('../partials/flash-alerts', { flashes }) %>

  <%
    // Hidden per-member relationship-new link stash. Preserves the DOM
    // invariant that each member has an addressable relationship-new href
    // (used by tests and by any future keyboard-navigation surface).
    // Not user-visible; contextual authoring lives in the Selected member
    // panel header below.
  %>
  <div data-authority-relationship-members hidden>
    <% members.forEach(function(member) { %>
      <a
        data-authority-relationship-link
        data-authority-member-id="<%= member.id %>"
        href="/admin/knowledge/relationships/new?sourceEntityId=<%= member.id %>"
      ><%= member.canonical_name %></a>
    <% }) %>
  </div>

  <section class="authority-workspace" data-authority-workspace>
    <div class="graph-shell-card knowledge-card authority-member-browser">
      <div class="graph-sidebar-header authority-workspace-panel-header">
        <div>
          <p class="kg-panel-eyebrow">Members</p>
          <h2>Linked entities</h2>
        </div>
        <span class="status-badge"><%= _summary.memberCount %></span>
      </div>
      <div class="graph-sidebar-body authority-member-browser-body">
        <label class="sr-only" for="authority-member-filter-<%= authority.id %>">Filter linked entities</label>
        <input
          type="search"
          id="authority-member-filter-<%= authority.id %>"
          class="admin-search-input authority-member-filter"
          placeholder="Filter by name, id, or type..."
          autocomplete="off"
          data-authority-member-filter
        >

        <% if (!members.length) { %>
          <p class="graph-empty-state">No member entities are linked to this authority.</p>
        <% } else { %>
          <div class="authority-member-list" data-authority-member-list role="listbox" aria-label="Linked entities">
            <% members.forEach(function(member, index) { %>
              <div
                class="authority-member-row <%= index === 0 ? 'is-selected' : '' %>"
                data-authority-member-id="<%= member.id %>"
                data-authority-member-search="<%= [member.id, member.canonical_name, member.entity_type].join(' ').toLowerCase() %>"
                role="option"
                aria-selected="<%= index === 0 ? 'true' : 'false' %>"
                tabindex="0"
              >
                <span class="authority-member-row-name"><%= member.canonical_name %></span>
                <% if (member.top_document_title) { %>
                  <span class="authority-member-row-evidence" title="Document with the most citations of this specific member entity">
                    mostly in <em><%= member.top_document_title %></em>
                  </span>
                <% } %>
                <span class="authority-member-row-meta">
                  <span><%= member.entity_type %></span>
                  <span class="entity-meta__sep" aria-hidden="true">·</span>
                  <span>id <%= member.id %></span>
                  <span class="entity-meta__sep" aria-hidden="true">·</span>
                  <span><%= member.document_count %> doc<%= member.document_count === 1 ? '' : 's' %></span>
                  <span class="entity-meta__sep" aria-hidden="true">·</span>
                  <span><%= member.citation_count %> cite<%= member.citation_count === 1 ? '' : 's' %></span>
                  <span class="entity-meta__sep" aria-hidden="true">·</span>
                  <span><%= member.relationship_count %> edge<%= member.relationship_count === 1 ? '' : 's' %></span>
                </span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <div class="graph-shell-card knowledge-card authority-context-panel">
      <div class="graph-sidebar-header entity-detail__section-head authority-workspace-panel-header">
        <div class="entity-detail__card-title">
          <p class="kg-panel-eyebrow">Selected member</p>
          <h2 data-authority-selected-title><%= members[0] ? members[0].canonical_name : 'No entity selected' %></h2>
        </div>
        <%
          // Selected-panel actions — element choice vs visual weight rule.
          // Per docs/ui-template-standards.md § Element choice vs visual
          // weight: both are <a> semantically (URL changes). "Open entity"
          // is pure navigation → plain text link. "+ Add relationship" is
          // a contextual authoring affordance in this panel's header →
          // btn-ghost.
        %>
        <div class="entity-detail__card-actions">
          <a
            class="entity-detail__section-link"
            href="<%= members[0] ? '/admin/knowledge/entities/' + members[0].id : '/admin/knowledge/entities' %>"
            data-authority-selected-link
          >Open entity →</a>
          <a
            class="btn-ghost"
            href="<%= members[0] ? '/admin/knowledge/relationships/new?sourceEntityId=' + members[0].id : '#' %>"
            data-authority-selected-add-relationship
          >+ Add relationship</a>
        </div>
      </div>
      <div class="graph-sidebar-body">
        <div class="authority-selected-meta" data-authority-selected-meta></div>

        <div class="authority-detail-tabs" role="tablist" aria-label="Selected member detail">
          <button type="button" class="authority-detail-tab active" data-authority-detail-tab="citations">Citations</button>
          <button type="button" class="authority-detail-tab" data-authority-detail-tab="edges">Connected edges</button>
          <button type="button" class="authority-detail-tab" data-authority-detail-tab="manage">Manage</button>
        </div>

        <div class="authority-detail-panel" data-authority-detail-panel></div>
      </div>
    </div>
  </section>

  <div class="authority-secondary-grid">
    <section class="graph-shell-card knowledge-card">
      <div class="graph-sidebar-header">
        <p class="kg-panel-eyebrow">Aliases</p>
        <h2>Rolled-up names</h2>
      </div>
      <div class="graph-sidebar-body">
        <% if (!aliases.length) { %>
          <p class="graph-empty-state">No member aliases are recorded.</p>
        <% } else { %>
          <div class="graph-alias-list authority-compact-list">
            <% aliases.forEach(function(alias) { %>
              <div class="graph-detail-card">
                <strong><%= alias.alias %></strong>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>

    <% if (sentimentSummary && sentimentSummary.length > 0) { %>
      <%- include('partials/sentiment-kg-card', {
        summary: sentimentSummary,
        list: sentimentList,
        heading: 'Across all member entities',
        workbenchHref: '/sentiment?authority_id=' + authority.id
      }) %>
    <% } %>
  </div>

  <%
    // Danger zone — per docs/ui-template-standards.md § Danger zone.
    // Fixed title (no verb), single-line note, single btn-danger.
    // Merge target picker lives on the dedicated /authorities/merge page;
    // this button navigates there. Structure now mirrors entity-detail.
  %>
  <section class="workspace-danger" aria-labelledby="authority-danger-label">
    <div>
      <p class="workspace-danger-title" id="authority-danger-label">Danger zone</p>
      <p class="workspace-danger-note">
        Merging folds this authority's members and citations onto a target
        authority, and deletes this record. This action cannot be undone.
      </p>
    </div>
    <div>
      <a
        class="btn-danger"
        href="/admin/knowledge/authorities/merge?source_id=<%= authority.id %>"
      >Merge authority</a>
    </div>
  </section>

  <script type="application/json" id="authority-workspace-data"><%- JSON.stringify({
    authority: {
      id: authority.id,
      canonical_name: authority.canonical_name,
      authority_type: authority.authority_type
    },
    csrfToken,
    members: authorityWorkspace.members,
    citationsByEntityId: authorityWorkspace.citationsByEntityId,
    relationshipsByEntityId: authorityWorkspace.relationshipsByEntityId
  }).replace(/</g, '\\u003c') %></script>
</div>

<script src="/js/authority-detail-page.js"></script>
<script src="/js/sentiment-card-renderer.js"></script>
<%- include('../partials/footer') %>
