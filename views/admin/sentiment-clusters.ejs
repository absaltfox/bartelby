<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: 'sentiment-clusters' }) %>

  <div class="admin-header">
    <h1>Sentiment Phrase Clusters</h1>
  </div>

    <div class="segmented-control" role="tablist" aria-label="Clusters view">
      <a href="?tab=clusters" role="tab" aria-current="<%= tab === 'clusters' ? 'true' : 'false' %>">
        Clusters <span class="filter-count"><%= tabCounts.clusters %></span>
      </a>
      <a href="?tab=noise" role="tab" aria-current="<%= tab === 'noise' ? 'true' : 'false' %>">
        Noise <span class="filter-count"><%= tabCounts.noise %></span>
      </a>
    </div>

    <% if (tab === 'clusters') { %>
      <p class="muted">
        Each cluster shows its derived label state from member phrases. Click "Label" to open the drawer,
        review members, and apply or change labels. Labels persist across re-clustering.
      </p>

      <div class="cluster-actions">
        <button type="button" class="btn-primary"
                id="sentiment-cluster-run-btn"
                <% if (inFlightRun) { %>disabled<% } %>
                data-in-flight-run-id="<%= inFlightRun ? inFlightRun.id : '' %>">
          <% if (inFlightRun) { %>
            Run #<%= inFlightRun.id %> in progress (<%= inFlightRun.status %>)…
          <% } else { %>
            Run clustering now
          <% } %>
        </button>
        <span class="save-status" id="sentiment-cluster-status"></span>
      </div>

      <div class="filter-bar">
        <div class="segmented-control" role="tablist" aria-label="Filter by label state">
          <a href="?tab=clusters&state=all" role="tab" aria-current="<%= stateFilter === 'all' ? 'true' : 'false' %>">all</a>
          <a href="?tab=clusters&state=unlabeled" role="tab" aria-current="<%= stateFilter === 'unlabeled' ? 'true' : 'false' %>">unlabeled</a>
          <a href="?tab=clusters&state=partial" role="tab" aria-current="<%= stateFilter === 'partial' ? 'true' : 'false' %>">partial</a>
          <a href="?tab=clusters&state=mixed" role="tab" aria-current="<%= stateFilter === 'mixed' ? 'true' : 'false' %>">mixed</a>
          <a href="?tab=clusters&state=full" role="tab" aria-current="<%= stateFilter === 'full' ? 'true' : 'false' %>">full</a>
        </div>
        <form method="get" class="filter-label-form">
          <% if (tab !== 'clusters') { %><input type="hidden" name="tab" value="<%= tab %>"><% } %>
          <% if (stateFilter !== 'all') { %><input type="hidden" name="state" value="<%= stateFilter %>"><% } %>
          Label:
          <select name="label_id" data-submit-on-change="1">
            <option value="">All labels</option>
            <% for (const l of labelsForFilter) { %>
              <option value="<%= l.id %>" <%= selectedLabelId === l.id ? 'selected' : '' %>><%= l.name %></option>
            <% } %>
          </select>
          <% if (selectedLabelId !== null) { %>
            <a href="?tab=<%= tab %>&state=<%= stateFilter %>" class="btn-link btn-sm">clear</a>
          <% } %>
        </form>
      </div>

      <h2>Recent runs</h2>
      <% if (recentRuns.length === 0) { %>
        <p class="muted">No clustering runs yet. Click "Run clustering now" to start one.</p>
      <% } else { %>
        <table class="workflows-table">
          <thead><tr><th scope="col">Run</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col">Result</th></tr></thead>
          <tbody>
            <% for (const r of recentRuns) { %>
              <tr>
                <td>#<%= r.id %></td>
                <td><%= r.status %></td>
                <td><%= r.created_at %></td>
                <td>
                  <% if (r.status === 'done') { %>
                    <%= r.cluster_count %> clusters · <%= r.noise_count %> noise · <%= r.phrase_count %> phrases
                  <% } else if (r.status === 'failed') { %>
                    <span class="muted">error: <%= r.error %></span>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>

      <% if (latestDone) { %>
        <h2>
          Run #<%= latestDone.id %> — clusters
          <% if (selectedLabelName) { %>
            containing label <em>'<%= selectedLabelName %>'</em>
          <% } %>
        </h2>
        <% if (clusters.length === 0) { %>
          <% if (selectedLabelName) { %>
            <p class="muted">No clusters in run #<%= latestDone.id %> contain label '<%= selectedLabelName %>'.</p>
          <% } else { %>
            <p class="muted">No clusters match the current filter.</p>
          <% } %>
        <% } else { %>
          <table class="workflows-table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Size</th>
                <th scope="col">State</th>
                <th scope="col">Sample / Label</th>
                <th scope="col">Action</th>
              </tr>
            </thead>
            <tbody>
              <% for (const c of clusters) { %>
                <tr data-cluster-id="<%= c.cluster_id %>">
                  <td>#<%= c.cluster_index %></td>
                  <td><%= c.size %></td>
                  <td>
                    <% if (c.label_state === 'unlabeled') { %>
                      ─ unlabeled
                    <% } else if (c.label_state === 'partial') { %>
                      ◐ partial <%= c.labeled_count %>/<%= c.size %>
                      <span class="muted">(<%= c.dominant_label_name %>)</span>
                    <% } else if (c.label_state === 'full') { %>
                      ● full <%= c.labeled_count %>/<%= c.size %>
                      <span class="muted">(<%= c.dominant_label_name %>)</span>
                    <% } else { %>
                      ⚠ mixed
                    <% } %>
                  </td>
                  <td>
                    <%= c.sample_phrases.join(' · ') %>
                    <% if (c.size > c.sample_phrases.length) { %>
                      <span class="muted">(+<%= c.size - c.sample_phrases.length %>)</span>
                    <% } %>
                  </td>
                  <td>
                    <button type="button" class="btn-secondary btn-sm sentiment-cluster-label-btn"
                            data-cluster-id="<%= c.cluster_id %>"
                            data-cluster-index="<%= c.cluster_index %>"
                            data-cluster-size="<%= c.size %>">
                      Label →
                    </button>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        <% } %>
      <% } %>

      <!-- Side drawer markup (hidden until Label → clicked, populated by Task 10's JS) -->
      <div id="sentiment-cluster-drawer" class="drawer is-hidden" aria-hidden="true">
        <div class="drawer__backdrop"></div>
        <aside class="drawer__panel" role="dialog" aria-labelledby="drawer-title">
          <header class="drawer__header">
            <h2 id="drawer-title">Cluster #<span id="drawer-cluster-index">—</span> · size <span id="drawer-cluster-size">—</span></h2>
            <button type="button" class="drawer__close" aria-label="Close drawer">×</button>
          </header>
          <div class="drawer__body">
            <input type="text" id="drawer-filter" placeholder="Filter members…" class="drawer__filter">
            <ul id="drawer-members" class="drawer__members"></ul>
          </div>
          <footer class="drawer__footer">
            <label>Label: <input type="text" id="drawer-label-input" list="drawer-label-options" placeholder="type or pick existing"></label>
            <datalist id="drawer-label-options"></datalist>
            <button type="button" class="btn-primary" id="drawer-apply-btn">Apply to selected</button>
            <button type="button" class="btn-secondary" id="drawer-clear-btn">Clear labels</button>
            <span class="save-status" id="drawer-status"></span>
          </footer>
        </aside>
      </div>

    <% } else if (tab === 'noise') { %>
      <!-- Noise tab content rendered by client JS in Task 12 -->
      <div id="sentiment-noise-container">
        <p class="muted">Loading noise phrases…</p>
      </div>
    <% } %>
</div>

<script src="/js/sentiment-clusters-drawer.js" defer></script>
<script src="/js/sentiment-noise-page.js" defer></script>
<script src="/js/sentiment-clusters-page.js" defer></script>
<%- include('../partials/footer') %>
