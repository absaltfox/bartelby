<%- include('../partials/header', { pageTitle: 'Create Entity', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Create Entity</h1>
    <p class="subtitle">Author an entity from scratch with a transcript citation.</p>
  </div>

  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'entities' }) %>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <section class="settings-section">
    <form method="POST" action="/admin/knowledge/entities/new" class="edit-form entity-new-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <fieldset>
        <legend>Entity</legend>
        <div class="edit-field">
          <label for="entity_type">Type</label>
          <select id="entity_type" name="entity_type" required>
            <% entityTypes.forEach(function(t) { %>
              <option value="<%= t %>" <%= prefill.entityType === t ? 'selected' : '' %>><%= t %></option>
            <% }) %>
          </select>
        </div>
        <div class="edit-field">
          <label for="canonical_name">Canonical name</label>
          <input type="text" id="canonical_name" name="canonical_name" required
            value="<%= prefill.canonicalName || '' %>" />
        </div>
        <div class="edit-field">
          <label for="description">Description (optional)</label>
          <textarea id="description" name="description" rows="3"><%= prefill.description || '' %></textarea>
        </div>
        <div class="edit-field">
          <label for="authority_id">Authority ID (optional)</label>
          <input type="number" id="authority_id" name="authority_id"
            value="<%= prefill.authorityId != null ? prefill.authorityId : '' %>"
            placeholder="link to existing authority" />
        </div>
      </fieldset>

      <%- include('../partials/transcript-span-picker', { prefill }) %>

      <div class="edit-actions">
        <button type="submit" class="btn-primary">Create entity</button>
        <a href="/admin/knowledge/entities" class="btn-secondary">Cancel</a>
      </div>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
