<%- include('../partials/header', { pageTitle: 'Documents', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Documents</h1>
    <p class="subtitle"><%= totalCount %> document<%= totalCount !== 1 ? 's' : '' %></p>
  </div>

  <% if (deleted) { %>
    <div class="alert alert-success">Document deleted successfully.</div>
  <% } %>
  <% if (queryError === 'not_found') { %>
    <div class="alert alert-error">Document not found.</div>
  <% } else if (queryError) { %>
    <div class="alert alert-error"><%= queryError %></div>
  <% } %>
  <% if (queuedDocumentTitle) { %>
    <div class="alert alert-success">
      Queued a fresh knowledge extraction run for <strong><%= queuedDocumentTitle %></strong>.
    </div>
  <% } %>

  <div class="bulk-toolbar bulk-toolbar--sticky">
    <div class="bulk-toolbar-left">
      <label class="bulk-toolbar-select-all" title="Select all documents on this page">
        <input type="checkbox" id="select-all-cb">
        <span id="select-all-label">Select all on page</span>
      </label>
      <span id="bulk-count" class="bulk-toolbar-count bulk-count is-hidden">0 selected</span>
    </div>
    <div class="bulk-toolbar-actions is-hidden" id="bulk-actions">
      <button type="button" class="btn-secondary btn-sm" id="bulk-tag-btn">Add to Collection</button>
      <button type="button" class="btn-danger btn-sm" id="bulk-delete-btn">Delete Selected</button>
    </div>
    <div class="bulk-toolbar-right">
      <% if (allCollections.length > 0) { %>
        <select id="collection-filter" class="doc-filter-select">
          <option value="">All collections</option>
          <% allCollections.forEach(function(c) { %>
            <option value="<%= c.id %>" <%= collectionFilter === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      <% } %>
      <select id="per-page-select" class="doc-filter-select">
        <% [25, 50, 75, 100].forEach(function(n) { %>
          <option value="<%= n %>" <%= perPage === n ? 'selected' : '' %>><%= n %> per page</option>
        <% }) %>
      </select>
    </div>
  </div>

  <% if (docs.length > 0) { %>
    <div class="doc-grid" id="doc-grid">
      <% docs.forEach(function(doc) { %>
        <div class="doc-card" data-id="<%= doc.id %>">
          <label class="doc-card-select">
            <input type="checkbox" class="doc-cb" value="<%= doc.id %>">
          </label>
          <div class="doc-card-image">
            <button type="button" class="doc-card-image-select" data-doc-card-image aria-label="Select <%= doc.title %>"></button>
            <img src="<%= doc.image_path || '' %>" alt=""
                 data-hide-on-image-error
                 data-fallback-message="📄">
            <span class="doc-card-image-hint">Click image to select</span>
            <button type="button" class="doc-card-zoom-btn" aria-label="Zoom document preview" title="Zoom document preview" data-doc-card-zoom>
              &#128269;
            </button>
          </div>
          <div class="doc-card-body">
            <h2 class="doc-card-title"><%= doc.title %></h2>
            <% if (doc.date_created) { %>
              <span class="doc-card-date"><%= doc.date_created %></span>
            <% } %>
            <% if (doc.description) { %>
              <p class="doc-card-summary"><%= doc.description.length > 120 ? doc.description.substring(0, 120) + '...' : doc.description %></p>
            <% } %>
            <div class="doc-card-tags">
              <% if (doc.collections && doc.collections.length > 0) { %>
                <% doc.collections.forEach(function(c) { %>
                  <span class="collection-tag-sm"><%= c.name %></span>
                <% }) %>
              <% } %>
            </div>
          </div>
          <div class="doc-card-actions">
            <div class="doc-card-more-menu" data-doc-card-menu>
              <button type="button"
                      class="doc-card-more-toggle"
                      aria-expanded="false"
                      aria-haspopup="true"
                      aria-label="More actions for <%= doc.title %>"
                      title="More actions"
                      data-doc-card-menu-toggle>&#8942;</button>
                <div class="doc-card-more-panel" hidden data-doc-card-menu-panel>
                  <a href="/documents/<%= doc.id %>" class="doc-card-more-item">Open document</a>
                  <% if (Number(doc.transcript_count || 0) > 0) { %>
                    <form method="POST" action="/admin/knowledge/documents/reextract" class="doc-card-more-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="document_id" value="<%= doc.id %>">
                      <input type="hidden" name="returnTo" value="/admin/documents<%= currentPage > 1 || collectionFilter || perPage !== 25 ? ('?page=' + currentPage + (collectionFilter ? '&collection=' + collectionFilter : '') + (perPage !== 25 ? '&perPage=' + perPage : '')) : '' %>">
                      <button type="submit" class="doc-card-more-item">Re-extract</button>
                    </form>
                  <% } %>
                  <button type="button"
                          class="doc-card-more-item tag-edit-btn"
                          data-doc-id="<%= doc.id %>"
                          data-collection-ids="<%= (doc.collections || []).map(c => c.id).join(',') %>">Edit collections</button>
                  <form method="POST" action="/admin/documents/<%= doc.id %>/delete"
                        class="doc-card-more-form"
                        data-confirm="Delete &quot;<%= doc.title %>&quot; and all its transcriptions?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="doc-card-more-item doc-card-more-item--danger">Delete document</button>
                  </form>
                </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <%
          const filterParam = collectionFilter ? '&collection=' + collectionFilter : '';
          const perPageParam = perPage !== 25 ? '&perPage=' + perPage : '';
        %>
        <% if (currentPage > 1) { %>
          <a href="/admin/documents?page=<%= currentPage - 1 %><%= filterParam %><%= perPageParam %>" class="btn-secondary btn-sm">&laquo; Prev</a>
        <% } %>
        <span class="pagination-info">Page <%= currentPage %> of <%= totalPages %></span>
        <% if (currentPage < totalPages) { %>
          <a href="/admin/documents?page=<%= currentPage + 1 %><%= filterParam %><%= perPageParam %>" class="btn-secondary btn-sm">Next &raquo;</a>
        <% } %>
      </div>
    <% } %>
  <% } else { %>
    <div class="empty-state empty-state--padded-lg">
      <% if (collectionFilter) { %>
        <p>No documents in this collection.</p>
        <a href="/admin/documents" class="btn-secondary">Show all documents</a>
      <% } else { %>
        <h2>No documents yet</h2>
        <p>Import your first document to get started.</p>
        <a href="/admin/import" class="btn-primary">Import Document</a>
      <% } %>
    </div>
  <% } %>
</div>

<div id="doc-zoom-overlay" class="zoom-overlay is-hidden" aria-hidden="true">
  <button type="button" class="zoom-close" id="doc-zoom-close" aria-label="Close zoom">&times;</button>
  <img src="" alt="" id="doc-zoom-image">
  <div class="zoom-label" id="doc-zoom-label"></div>
</div>

<!-- Collection tagger modal -->
<div id="tag-modal-overlay" class="tag-modal-overlay is-hidden">
  <div class="tag-modal">
    <div class="tag-modal-header">
      <h3 id="tag-modal-title">Edit Collections</h3>
      <button type="button" class="tag-modal-close" id="tag-modal-close">&times;</button>
    </div>
    <div class="tag-modal-body">
      <% if (allCollections.length === 0) { %>
        <p class="muted">No collections exist yet. <a href="/admin/collections">Create one first.</a></p>
      <% } else { %>
        <% allCollections.forEach(function(c) { %>
          <label class="collection-access-item">
            <input type="checkbox" class="tag-cb" value="<%= c.id %>">
            <span>
              <strong><%= c.name %></strong>
              <% if (c.is_world_public) { %><span class="badge-public">public</span><% } else if (c.is_public) { %><span class="badge-public">all users</span><% } %>
              <% if (c.description) { %><small class="muted"> — <%= c.description %></small><% } %>
            </span>
          </label>
        <% }) %>
        <p class="field-hint">Managers of each selected collection will be able to curate this document's knowledge graph.</p>
      <% } %>
    </div>
    <div class="tag-modal-footer">
      <button type="button" class="btn-secondary" id="tag-modal-cancel">Cancel</button>
      <button type="button" class="btn-primary" id="tag-modal-save">Save</button>
    </div>
  </div>
</div>

<script src="/js/admin-documents.js"></script>

<%- include('../partials/footer') %>
