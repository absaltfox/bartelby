<%- include('../partials/header', { pageTitle: 'Collections', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Collections</h1>
    <p class="subtitle">Organize documents and control access. Private collections require explicit access grants; shared collections are visible to all logged-in users; public collections are open to anyone, including unauthenticated visitors.</p>
  </div>

  <% if (saved) { %>
    <div class="alert alert-success">Collection saved successfully.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (queuedMode === 'iiif-transcribe') { %>
    <div class="alert alert-success">
      <% if (queuedCount > 0) { %>
        Queued transcription for <strong><%= queuedCount %></strong> IIIF document<%= queuedCount !== 1 ? 's' : '' %>.
      <% } else { %>
        No IIIF documents needed transcription &mdash; all already have a machine transcript or an active job.
      <% } %>
    </div>
  <% } %>
  <% if (queuedCollectionName) { %>
    <div class="alert alert-success">
      <% if (queuedMode === 'batch') { %>
        Queued <strong>1 provider batch job</strong> for <strong><%= queuedCollectionName %></strong>, covering <strong><%= queuedCount %></strong> document<%= queuedCount !== 1 ? 's' : '' %>.
      <% } else if (queuedMode === 'title-backfill') { %>
        Queued a title &amp; summary backfill job for <strong><%= queuedCollectionName %></strong>.
      <% } else if (queuedMode === 'sentiment-rerun') { %>
        Queued <strong><%= queuedCount %></strong> sentiment re-run job<%= queuedCount !== 1 ? 's' : '' %>.
      <% } else { %>
        Queued <strong><%= queuedCount %></strong> extraction job<%= queuedCount !== 1 ? 's' : '' %> for <strong><%= queuedCollectionName %></strong>.
      <% } %>
      <% if (skippedPending || skippedNoTranscript) { %>
        <span class="muted">
          Skipped <%= skippedPending %> already in progress and <%= skippedNoTranscript %> without transcripts.
        </span>
      <% } %>
    </div>
  <% } %>

  <!-- Create new collection -->
  <div class="settings-section">
    <h2>New Collection</h2>
    <form method="POST" action="/admin/collections" class="auth-form admin-form-wide">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="col-name">Name *</label>
        <input type="text" id="col-name" name="name" required placeholder="e.g. Colonial Records">
      </div>
      <div class="form-group">
        <label for="col-desc">Description <span class="field-hint-inline">(optional)</span></label>
        <textarea id="col-desc" name="description" rows="2" placeholder="Brief description of this collection"></textarea>
      </div>
      <div class="form-group">
        <label for="col-range-start">Document date range <span class="field-hint-inline">(optional)</span></label>
        <div class="form-row">
          <input type="number" id="col-range-start" name="date_range_start_year" min="1" max="9999" placeholder="Start year, e.g. 1840">
          <input type="number" id="col-range-end" name="date_range_end_year" min="1" max="9999" placeholder="End year, e.g. 1885">
        </div>
        <p class="field-hint">Years this collection's documents are known to span. Helps AI transcription and knowledge extraction interpret ambiguous or partial dates, and flags extracted dates that fall outside the range for review.</p>
      </div>
      <div class="form-group">
        <label>Visibility</label>
        <label class="radio-label">
          <input type="radio" name="visibility" value="private" checked>
          <span><strong>Private</strong> — only users with explicit access grants</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="visibility" value="authenticated">
          <span><strong>All users</strong> — visible to all logged-in users without access grants</span>
        </label>
        <label class="radio-label">
          <input type="radio" name="visibility" value="public">
          <span><strong>Public</strong> — visible to anyone, including unauthenticated visitors</span>
        </label>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="allow_export" value="1">
          <span>Allow export — users can download documents from this collection as PDF or TEI</span>
        </label>
      </div>
      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="auto_group_pages" value="1">
          <span>Enable AI-assisted document grouping during import</span>
        </label>
        <p class="field-hint">When enabled, users importing into this collection will see an <strong>Auto-group</strong> button that uses AI to detect archival page numbering and suggest document groups.</p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary">Create Collection</button>
      </div>
    </form>
  </div>

  <!-- Existing collections -->
  <% if (allCollections.length > 0) { %>
    <div class="settings-section">
      <h2>Existing Collections (<%= allCollections.length %>)</h2>
      <div class="collections-list">
        <% allCollections.forEach(function(c) { %>
          <div class="collection-row" id="collection-<%= c.id %>">
            <div class="collection-row-info">
              <div class="collection-row-title">
                <strong><%= c.name %></strong>
                <% if (c.is_world_public) { %>
                  <span class="badge-public">public</span>
                <% } else if (c.is_public) { %>
                  <span class="badge-public">all users</span>
                <% } else { %>
                  <span class="badge-private">private</span>
                <% } %>
              </div>
              <% if (c.description) { %><p class="collection-row-desc"><%= c.description %></p><% } %>
              <span class="collection-doc-count"><%= c.document_count %> document<%= c.document_count !== 1 ? 's' : '' %></span>
            </div>
            <div class="collection-row-actions">
              <form method="POST" action="/admin/knowledge/collections/reextract" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="collection_id" value="<%= c.id %>">
                <input type="hidden" name="returnTo" value="/admin/collections#collection-<%= c.id %>">
                <button type="submit" class="btn-secondary btn-sm">Re-extract</button>
              </form>
              <% if (c.sentiment_enabled) { %>
                <form method="POST" action="/admin/knowledge/sentiment/backfill/collection/<%= c.id %>" class="inline-form"
                      data-confirm-message="Queue sentiment extraction for all best transcripts in &quot;<%= c.name %>&quot; that don't already have a sentiment job?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-secondary btn-sm">Backfill sentiment</button>
                </form>
                <form method="POST" action="/admin/knowledge/sentiment/rerun/collection/<%= c.id %>" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-secondary btn-sm"
                          data-confirm-modal
                          data-confirm-title="Re-run sentiment (reset)"
                          data-confirm-label="Re-run (reset)"
                          data-confirm-danger="1"
                          data-confirm-preview-url="/admin/knowledge/sentiment/rerun/collection/<%= c.id %>/confirm.json">Re-run sentiment</button>
                </form>
              <% } %>
              <form method="POST" action="/admin/knowledge/titles/backfill/collection/<%= c.id %>" class="inline-form"
                    data-confirm-message="Regenerate generic titles and missing summaries for documents in &quot;<%= c.name %>&quot;?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-secondary btn-sm">Backfill titles</button>
              </form>
              <a href="/manage/collections/<%= c.id %>/knowledge" class="btn-secondary btn-sm">Knowledge &rarr;</a>
              <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="iiif-<%= c.id %>" data-collection-id="<%= c.id %>">IIIF source<% if (c.iiifSources && c.iiifSources.length) { %> (<%= c.iiifSources.length %>)<% } %></button>
              <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="edit-<%= c.id %>" data-collection-id="<%= c.id %>">Edit</button>
              <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="preview-<%= c.id %>" data-collection-id="<%= c.id %>">Preview Image</button>
              <% if (!c.is_public && !c.is_world_public) { %>
                <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="access-<%= c.id %>" data-collection-id="<%= c.id %>">Access</button>
              <% } %>
              <form method="POST" action="/admin/collections/<%= c.id %>/delete" class="inline-form"
                    data-confirm-message="Delete collection &quot;<%= c.name %>&quot;? Documents will not be deleted.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-danger btn-sm">Delete</button>
              </form>
            </div>
          </div>

          <!-- IIIF source panel -->
          <div id="iiif-<%= c.id %>" class="collection-edit-form is-hidden">
            <% var iiifImported = (c.iiifSources || []).reduce(function (n, s) { return n + (s.manifests_imported || 0); }, 0); %>
            <% if (c.iiifSources && c.iiifSources.length) { %>
              <h4>Connected sources</h4>
              <ul class="iiif-source-list">
                <% c.iiifSources.forEach(function (s) { %>
                  <li class="iiif-source-item">
                    <div class="iiif-source-head">
                      <strong><%= s.label || s.collection_identifier || ('Source #' + s.id) %></strong>
                      <span class="iiif-source-status iiif-source-status-<%= s.status %>"><%= s.status %></span>
                      <span class="muted"><%= s.manifests_imported %> of <%= s.manifests_total %> imported</span>
                    </div>
                    <% if (s.error) { %><p class="field-hint iiif-source-error">Error: <%= s.error %></p><% } %>
                    <% if (s.status === 'done' || s.status === 'failed') { %>
                      <form method="POST" action="/admin/collections/<%= c.id %>/iiif/<%= s.id %>/resync" class="inline-form"
                            data-confirm-message="Re-sync &quot;<%= s.label || s.collection_identifier %>&quot;? Already-imported items are skipped (no duplicates).">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-secondary btn-sm">Re-sync</button>
                      </form>
                    <% } %>
                  </li>
                <% }); %>
              </ul>
              <% if (iiifImported > 0) { %>
                <form method="POST" action="/admin/collections/<%= c.id %>/iiif/transcribe" class="inline-form"
                      data-confirm-message="Queue AI transcription for IIIF documents in &quot;<%= c.name %>&quot; that don't already have a machine transcript?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-secondary btn-sm">Transcribe imported documents</button>
                </form>
                <p class="field-hint">Imported documents keep the library's own transcription; this queues an AI transcript alongside it for comparison. Uses the system default provider and batches when supported.</p>
              <% } %>
            <% } else { %>
              <p class="field-hint">No IIIF source connected. Connect a UBC Open Collections collection to import its letters as remote references (images stay hosted by the library).</p>
            <% } %>

            <h4>Connect a UBC Open Collections source</h4>
            <form method="POST" action="/admin/collections/<%= c.id %>/iiif/connect">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label for="iiif-ident-<%= c.id %>">UBC collection identifier *</label>
                <input type="text" id="iiif-ident-<%= c.id %>" name="collection_identifier" required placeholder="e.g. royalfisk">
                <p class="field-hint">The collection's nickname in UBC Open Collections (the <code>collection_identifier</code>).</p>
              </div>
              <div class="form-group">
                <label for="iiif-label-<%= c.id %>">Label <span class="field-hint-inline">(optional)</span></label>
                <input type="text" id="iiif-label-<%= c.id %>" name="label" placeholder="Display name for this source">
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label for="iiif-size-<%= c.id %>">Image size <span class="field-hint-inline">(optional)</span></label>
                  <input type="text" id="iiif-size-<%= c.id %>" name="image_size" placeholder="2000,">
                </div>
                <div class="form-group">
                  <label for="iiif-key-<%= c.id %>">API key <span class="field-hint-inline">(optional)</span></label>
                  <input type="password" id="iiif-key-<%= c.id %>" name="api_key" autocomplete="off" placeholder="<%= '' %>">
                  <p class="field-hint">Overrides the server's UBC API key for this source. Stored securely; never displayed.</p>
                </div>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn-primary btn-sm">Connect &amp; queue sync</button>
                <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="iiif-<%= c.id %>" data-collection-id="<%= c.id %>">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Edit form -->
          <div id="edit-<%= c.id %>" class="collection-edit-form is-hidden">
            <form method="POST" action="/admin/collections/<%= c.id %>/edit">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="form-group">
                <label>Name</label>
                <input type="text" name="name" value="<%= c.name %>" required>
              </div>
              <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="3"><%= c.description || '' %></textarea>
              </div>
              <div class="form-group">
                <label>Document date range <span class="field-hint-inline">(optional)</span></label>
                <div class="form-row">
                  <input type="number" name="date_range_start_year" min="1" max="9999" placeholder="Start year, e.g. 1840" value="<%= c.date_range_start_year || '' %>">
                  <input type="number" name="date_range_end_year" min="1" max="9999" placeholder="End year, e.g. 1885" value="<%= c.date_range_end_year || '' %>">
                </div>
                <p class="field-hint">Years this collection's documents are known to span. Helps AI transcription and knowledge extraction interpret ambiguous or partial dates, and flags extracted dates that fall outside the range for review.</p>
              </div>
              <div class="form-group">
                <label>Visibility</label>
                <label class="radio-label">
                  <input type="radio" name="visibility" value="private" <%= (!c.is_public && !c.is_world_public) ? 'checked' : '' %>>
                  <span><strong>Private</strong> — only users with explicit access grants</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="visibility" value="authenticated" <%= (c.is_public && !c.is_world_public) ? 'checked' : '' %>>
                  <span><strong>All users</strong> — visible to all logged-in users</span>
                </label>
                <label class="radio-label">
                  <input type="radio" name="visibility" value="public" <%= c.is_world_public ? 'checked' : '' %>>
                  <span><strong>Public</strong> — visible to anyone, including unauthenticated visitors</span>
                </label>
              </div>
              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" name="allow_export" value="1" <%= c.allow_export ? 'checked' : '' %>>
                  <span>Allow export — users can download documents as PDF or TEI</span>
                </label>
              </div>
              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" name="auto_group_pages" value="1" <%= c.auto_group_pages ? 'checked' : '' %>>
                  <span>Enable AI-assisted document grouping during import</span>
                </label>
                <p class="field-hint">When enabled, users importing into this collection will see an <strong>Auto-group</strong> button that uses AI to detect archival page numbering and suggest document groups.</p>
              </div>
              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" name="sentiment_enabled" value="1" <%= c.sentiment_enabled ? 'checked' : '' %>>
                  <span>Enable sentiment extraction for this collection</span>
                </label>
                <p class="field-hint">When enabled, every successful transcript extraction queues a sentiment-extraction job. Disabling stops new jobs but does not delete existing annotations.</p>
              </div>
              <div class="form-actions">
                <button type="submit" class="btn-primary">Save</button>
                <button type="button" class="btn-secondary js-collection-toggle" data-target="edit-<%= c.id %>" data-collection-id="<%= c.id %>">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Preview image selector -->
          <div id="preview-<%= c.id %>" class="collection-access-panel is-hidden">
            <h4>Collection Preview Image</h4>
            <p class="muted collection-preview-note">
              Select a document whose image will appear as the collection thumbnail. If none is selected, the most recent document's image is used.
            </p>
            <% if (c.documents && c.documents.length > 0) { %>
              <form method="POST" action="/admin/collections/<%= c.id %>/preview">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="preview-image-grid">
                  <label class="preview-image-option <%= !c.preview_document_id ? 'selected' : '' %>">
                    <input type="radio" name="preview_document_id" value="" <%= !c.preview_document_id ? 'checked' : '' %>>
                    <div class="preview-image-thumb preview-image-thumb--auto">
                      <span>Auto</span>
                    </div>
                  </label>
                  <% c.documents.forEach(function(doc) { %>
                    <label class="preview-image-option <%= c.preview_document_id === doc.id ? 'selected' : '' %>">
                      <input type="radio" name="preview_document_id" value="<%= doc.id %>" <%= c.preview_document_id === doc.id ? 'checked' : '' %>>
                      <div class="preview-image-thumb">
                        <% if (doc.image_path) { %>
                          <img data-preview-lazy-image data-src="<%= doc.image_path %>" alt="<%= doc.title %>">
                        <% } else { %>
                          <span>&#128220;</span>
                        <% } %>
                      </div>
                      <span class="preview-image-label"><%= doc.title.length > 25 ? doc.title.substring(0, 25) + '...' : doc.title %></span>
                    </label>
                  <% }) %>
                </div>
                <div class="form-actions collection-preview-actions">
                  <button type="submit" class="btn-primary btn-sm">Save Preview</button>
                  <button type="button" class="btn-secondary btn-sm js-collection-toggle" data-target="preview-<%= c.id %>" data-collection-id="<%= c.id %>">Cancel</button>
                </div>
              </form>
            <% } else { %>
              <p class="muted collection-preview-note">No documents in this collection yet. Add documents to set a preview image.</p>
            <% } %>
          </div>

          <!-- Access management panel (private collections only) -->
          <% if (!c.is_public && !c.is_world_public) { %>
            <div id="access-<%= c.id %>" class="collection-access-panel is-hidden">
              <h4>User Access</h4>

              <% if (c.grantedUsers && c.grantedUsers.length > 0) { %>
                <ul class="access-user-list">
                  <% c.grantedUsers.forEach(function(u) { %>
                    <li class="access-user-item">
                      <span>
                        <strong><%= u.username %></strong>
                        <% if (u.email) { %> <small class="muted">&lt;<%= u.email %>&gt;</small><% } %>
                        <span class="role-badge role-<%= u.collection_role || 'viewer' %> admin-role-badge--tiny"><%= u.collection_role || 'viewer' %></span>
                      </span>
                      <div class="collection-access-actions">
                        <form method="POST" action="/admin/collections/<%= c.id %>/access/grant" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <input type="hidden" name="user_id" value="<%= u.id %>">
                          <select name="role" class="admin-select--tiny" data-submit-on-change="1">
                            <option value="viewer" <%= u.collection_role === 'viewer' ? 'selected' : '' %>>Viewer</option>
                            <option value="editor" <%= u.collection_role === 'editor' ? 'selected' : '' %>>Editor</option>
                            <option value="manager" <%= u.collection_role === 'manager' ? 'selected' : '' %>>Manager</option>
                          </select>
                        </form>
                        <form method="POST" action="/admin/collections/<%= c.id %>/access/revoke/<%= u.id %>" class="inline-form" data-confirm-message="Revoke access for <%= u.username %>?">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-danger btn-sm">Revoke</button>
                        </form>
                      </div>
                    </li>
                  <% }) %>
                </ul>
              <% } else { %>
                <p class="muted collection-preview-note">No users have been granted access to this collection.</p>
              <% } %>

              <% if (activeUsers.length > 0) { %>
                <%
                  var grantedIds = (c.grantedUsers || []).map(u => u.id);
                  var eligible = activeUsers.filter(u => !grantedIds.includes(u.id));
                %>
                <% if (eligible.length > 0) { %>
                  <form method="POST" action="/admin/collections/<%= c.id %>/access/grant" class="access-grant-form collection-grant-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <select name="user_id" required class="collection-grant-select">
                      <option value="">— Grant access to a user —</option>
                      <% eligible.forEach(function(u) { %>
                        <option value="<%= u.id %>"><%= u.username %><% if (u.email) { %> (<%= u.email %>)<% } %></option>
                      <% }) %>
                    </select>
                    <select name="role" class="collection-grant-select collection-grant-select--role">
                      <option value="viewer">Viewer</option>
                      <option value="editor">Editor</option>
                      <option value="manager">Manager</option>
                    </select>
                    <button type="submit" class="btn-primary btn-sm">Grant Access</button>
                  </form>
                <% } else { %>
                  <p class="muted collection-access-empty">All eligible users already have access.</p>
                <% } %>
              <% } else { %>
                <p class="muted collection-access-empty">No non-admin users to grant access to.</p>
              <% } %>

              <p class="field-hint collection-access-hint">
                Users with <em>Access All</em> or the <em>admin</em> role always have access to all collections regardless of these grants.
              </p>
            </div>
          <% } %>

        <% }) %>
      </div>
    </div>
  <% } else { %>
    <div class="empty-state empty-state--padded-lg">
      <div class="empty-icon">&#128193;</div>
      <h2>No collections yet</h2>
      <p>Create your first collection above to start organizing documents.</p>
    </div>
  <% } %>
</div>
<%- include('../partials/confirm-modal') %>
<%- include('../partials/footer') %>
