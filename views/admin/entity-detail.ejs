<%- include('../partials/header', { pageTitle: entity.canonical_name, query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'entities' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Entities', href: '/admin/knowledge/entities' },
    { label: entity.canonical_name }
  ] }) %>

  <div class="admin-header entity-header">
    <h1><%= entity.canonical_name %></h1>
    <p class="entity-meta">
      <span class="entity-type-badge entity-type-<%= entity.entity_type %>"><%= entity.entity_type %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span class="entity-meta__id">id <%= entity.id %></span>
      <% var _role = (entity.properties && entity.properties.role) ? String(entity.properties.role) : null; %>
      <% if (_role) { %>
        <span class="entity-meta__sep" aria-hidden="true">·</span>
        <span class="entity-meta__role"><%= _role %></span>
      <% } %>
    </p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <%- include('../partials/flash-alerts', { flashes }) %>

  <div class="entity-detail">

    <% if (entity.description) { %>
      <section class="graph-shell-card knowledge-card entity-detail__prose">
        <div class="graph-sidebar-body">
          <p><%= entity.description %></p>
        </div>
      </section>
    <% } %>

    <%- include('./partials/entity-identity-card', {
      entity: entity,
      authority: authority,
      linkedEntities: linkedEntities,
      authoritySuggestions: authoritySuggestions,
      csrfToken: csrfToken
    }) %>

    <%
      // Header already surfaces canonical name, type, id — omit those from Properties
      // to keep the section focused on custom metadata. Hide entirely when nothing custom exists.
      var _extraProps = Object.entries(entity.properties || {});
    %>
    <% if (_extraProps.length > 0 || aliases.length > 0) { %>
    <div class="entity-detail__row">
      <% if (_extraProps.length > 0) { %>
        <section class="graph-shell-card knowledge-card">
          <div class="graph-sidebar-header">
            <div class="entity-detail__card-title">
              <p class="kg-panel-eyebrow">Profile</p>
              <h2>Properties</h2>
            </div>
          </div>
          <div class="graph-sidebar-body">
            <dl class="metadata-list">
              <% _extraProps.forEach(function(entry) { %>
                <dt><%= entry[0] %></dt>
                <dd><%= typeof entry[1] === 'object' ? JSON.stringify(entry[1]) : entry[1] %></dd>
              <% }) %>
            </dl>
          </div>
        </section>
      <% } %>

      <% if (aliases.length > 0) { %>
        <section class="graph-shell-card knowledge-card">
          <div class="graph-sidebar-header">
            <div class="entity-detail__card-title">
              <p class="kg-panel-eyebrow">Aliases</p>
              <h2>Known names</h2>
            </div>
          </div>
          <div class="graph-sidebar-body">
            <div class="graph-alias-list">
              <% aliases.forEach(function(alias) { %>
                <div class="graph-detail-card">
                  <strong><%= alias.alias || alias.label || alias.canonical_name || alias %></strong>
                  <div class="graph-muted"><%= alias.source || 'alias' %></div>
                </div>
              <% }) %>
            </div>
          </div>
        </section>
      <% } %>
    </div>
    <% } %>

    <% if (sentimentSummary && sentimentSummary.length > 0) { %>
      <%- include('partials/sentiment-kg-card', {
        summary: sentimentSummary,
        list: sentimentList,
        heading: 'Label distribution for ' + entity.canonical_name,
        workbenchHref: '/sentiment?entity_id=' + entity.id
      }) %>
    <% } %>

    <% if (relationships.length > 0) { %>
      <section class="graph-shell-card knowledge-card">
        <div class="graph-sidebar-header entity-detail__section-head">
          <div class="entity-detail__card-title">
            <p class="kg-panel-eyebrow">Relationships</p>
            <h2>Connected edges</h2>
            <%
              var _outgoing = relationships.filter(function (r) { return r.direction === 'outgoing' || r.source_entity_id === entity.id; }).length;
              var _incoming = relationships.length - _outgoing;
            %>
            <p class="entity-detail__section-meta">
              <%= relationships.length %> edge<%= relationships.length === 1 ? '' : 's' %>
              <% if (_outgoing) { %> · <%= _outgoing %> outbound<% } %>
              <% if (_incoming) { %> · <%= _incoming %> inbound<% } %>
            </p>
          </div>
          <div class="entity-detail__card-actions">
            <a href="/admin/knowledge/relationships/new?sourceEntityId=<%= entity.id %>" class="btn-ghost">Add relationship</a>
          </div>
        </div>
        <div class="graph-sidebar-body">
          <div class="workspace-edges">
            <% relationships.forEach(function(rel) { %>
              <%
                var _outgoing = rel.direction === 'outgoing' || rel.source_entity_id === entity.id;
                var _relType = rel.relationship_type || rel.type || 'related_to';
                var _confPct = rel.confidence != null ? Math.round(Number(rel.confidence) * 100) : null;
              %>
              <div class="workspace-edge">
                <span class="workspace-edge-type"><%= _relType %></span>
                <span class="workspace-edge-path">
                  <% if (_outgoing) { %>
                    <span class="workspace-edge-self"><%= entity.canonical_name %></span>
                    <span class="workspace-edge-arrow" aria-hidden="true">→</span>
                    <span class="workspace-edge-other"><%= rel.target_name || 'Unknown target' %></span>
                  <% } else { %>
                    <span class="workspace-edge-other"><%= rel.source_name || 'Unknown source' %></span>
                    <span class="workspace-edge-arrow" aria-hidden="true">→</span>
                    <span class="workspace-edge-self"><%= entity.canonical_name %></span>
                  <% } %>
                </span>
                <span class="workspace-edge-meta">
                  <% if (rel.relationship_type_deprecated_at) { %>
                    <span class="status-badge status-trace">deprecated</span>
                  <% } %>
                  <% if (_confPct != null) { %>
                    <span class="workspace-edge-conf"><%= _confPct %>%</span>
                  <% } %>
                  <%- include('../partials/voice-badge', {
                    relationship: rel,
                    attributionEntity: (rel.voice_role === 'speaker' && rel.expressed_by_entity)
                      || (rel.voice_role === 'described_subject' && rel.described_subject_entity)
                      || null
                  }) %>
                </span>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (dates.length > 0) { %>
      <section class="graph-shell-card knowledge-card">
        <div class="graph-sidebar-header">
          <div class="entity-detail__card-title">
            <p class="kg-panel-eyebrow">Dates</p>
            <h2>Date expressions</h2>
          </div>
        </div>
        <div class="graph-sidebar-body">
          <div class="graph-citation-list">
            <% dates.forEach(function(date) { %>
              <div class="graph-citation-card">
                <strong><%= date.label || date.mention %></strong>
                <div class="graph-muted"><%= date.earliest || 'Unknown' %><% if (date.latest && date.latest !== date.earliest) { %> to <%= date.latest %><% } %></div>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <section class="graph-shell-card knowledge-card">
      <div class="graph-sidebar-header">
        <div class="entity-detail__card-title">
          <p class="kg-panel-eyebrow">Evidence</p>
          <h2>Citations</h2>
          <p class="entity-detail__section-meta entity-evidence-summary">
            <% var _total = citations.length; %>
            <% var _approved = citations.filter(function (c) { return c.approval_status === 'approved'; }).length; %>
            <% var _pendingCit = citations.filter(function (c) { return !c.approval_status || c.approval_status === 'pending'; }).length; %>
            <% var _rejected = citations.filter(function (c) { return c.approval_status === 'rejected'; }).length; %>
            <% var _docs = new Set(citations.map(function (c) { return c.document_id; })).size; %>
            <% if (_total === 0) { %>
              No citations yet.
            <% } else { %>
              <%= _total %> citation<%= _total === 1 ? '' : 's' %> across <%= _docs %> document<%= _docs === 1 ? '' : 's' %> ·
              <span class="status-badge status-done"><%= _approved %> approved</span>
              <% if (_pendingCit > 0) { %><span class="status-badge status-running"><%= _pendingCit %> pending</span><% } %>
              <% if (_rejected > 0) { %><span class="status-badge status-failed"><%= _rejected %> rejected</span><% } %>
            <% } %>
          </p>
        </div>
      </div>
      <div class="graph-sidebar-body">
        <% if (citations.length === 0) { %>
          <p class="graph-empty-state">No citations recorded.</p>
        <% } else { %>
          <div class="workspace-citations">
            <% var _shownCits = citations.slice(0, 5); %>
            <% var _hiddenCits = citations.slice(5); %>
            <% _shownCits.forEach(function (citation) { %>
              <%- include('./partials/entity-citation-row', { entity: entity, citation: citation, csrfToken: csrfToken }) %>
            <% }) %>
            <% if (_hiddenCits.length > 0) { %>
              <details class="workspace-citations-more">
                <summary>Show <%= _hiddenCits.length %> more citation<%= _hiddenCits.length === 1 ? '' : 's' %></summary>
                <% _hiddenCits.forEach(function (citation) { %>
                  <%- include('./partials/entity-citation-row', { entity: entity, citation: citation, csrfToken: csrfToken }) %>
                <% }) %>
              </details>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>

    <% if (recentChanges && recentChanges.length > 0) { %>
      <section class="graph-shell-card knowledge-card entity-changes-card">
        <div class="graph-sidebar-header">
          <div class="entity-detail__card-title">
            <p class="kg-panel-eyebrow">History</p>
            <h2>Recent changes</h2>
          </div>
        </div>
        <div class="graph-sidebar-body">
          <details class="entity-changes-card__disclosure">
            <summary>Show <%= recentChanges.length %> most recent change<%= recentChanges.length === 1 ? '' : 's' %></summary>
            <ul class="entity-changes-list">
              <% recentChanges.forEach(function (chg) { %>
                <li>
                  <span class="graph-muted"><%= new Date(chg.changed_at).toISOString().slice(0, 10) %></span>
                  <%= chg.field %> changed
                  <% if (chg.old_value) { %><span class="graph-muted">from <em><%= chg.old_value %></em></span><% } %>
                  <% if (chg.new_value) { %><span class="graph-muted">to <em><%= chg.new_value %></em></span><% } %>
                  <% if (chg.changed_by_username) { %><span class="graph-muted"> by <%= chg.changed_by_username %></span><% } %>
                  <% if (chg.change_note) { %><em class="graph-muted"> — <%= chg.change_note %></em><% } %>
                </li>
              <% }) %>
            </ul>
          </details>
        </div>
      </section>
    <% } %>

    <!--
      Curator actions appear AFTER the evidence they'd be based on.
      Per user-stated design principle: information first, actions after.
      See docs/ui-template-standards.md § Entity detail — actions after context.
    -->
    <section class="entity-detail__record-actions" aria-labelledby="entity-record-actions-label">
      <p class="entity-detail__record-actions-label" id="entity-record-actions-label">Curator actions</p>
      <div class="entity-detail__record-actions-rows">
        <div class="entity-detail__record-actions-row" aria-labelledby="entity-record-actions-correct">
          <span class="entity-detail__record-actions-group-label" id="entity-record-actions-correct">Correct</span>
          <span class="entity-detail__record-actions-note">Edit preserves evidence; split moves only selected evidence; merge consolidates records.</span>
          <div class="entity-detail__record-actions-buttons">
            <a href="/admin/knowledge/entities/<%= entity.id %>/edit" class="btn-primary btn-sm">Edit entity</a>
            <a href="/admin/knowledge/entities/<%= entity.id %>/split" class="btn-secondary btn-sm">Split entity</a>
            <a href="/admin/knowledge/entities/merge" class="btn-secondary btn-sm">Merge entities</a>
          </div>
        </div>
        <div class="entity-detail__record-actions-row" aria-labelledby="entity-record-actions-author">
          <span class="entity-detail__record-actions-group-label" id="entity-record-actions-author">Author</span>
          <span class="entity-detail__record-actions-note">Creates citation-backed relationship evidence from this entity.</span>
          <div class="entity-detail__record-actions-buttons">
            <a href="/admin/knowledge/relationships/new?sourceEntityId=<%= entity.id %>" class="btn-secondary btn-sm">Add relationship</a>
          </div>
        </div>
      </div>
    </section>

    <section class="workspace-danger" aria-labelledby="entity-danger-label">
      <div>
        <p class="workspace-danger-title" id="entity-danger-label">Danger zone</p>
        <p class="workspace-danger-note">Deletion removes the entity, its citations, and its relationships. This cannot be undone.</p>
      </div>
      <form method="POST" action="/admin/knowledge/entities/<%= entity.id %>/delete" data-confirm-message="Delete this entity? This cannot be undone.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn-danger">Delete entity</button>
      </form>
    </section>

  </div>
</div>

<script src="/js/authority-picker.js"></script>
<script src="/js/sentiment-card-renderer.js"></script>
<%- include('../partials/footer') %>
