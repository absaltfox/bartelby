<%
function formatBytes(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
  return (bytes / 1073741824).toFixed(2) + ' GB';
}
%>
<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header analytics-settings-header">
    <h1>Document Analytics</h1>
    <p class="subtitle">Configure when analytics are computed and monitor per-collection status.</p>
  </div>

  <% if (flashMessage) { %>
    <div class="alert alert-<%= flashMessage.type === 'error' ? 'error' : 'success' %>"><%= flashMessage.text %></div>
  <% } %>

  <form method="POST" action="/admin/analytics-settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <section class="settings-section analytics-settings-section">
      <div class="analytics-section-header analytics-section-header--stacked">
        <div>
          <p class="admin-section-label">Scheduling</p>
          <h2>Analytics Schedule</h2>
          <p class="subtitle">Choose when collection analytics should run automatically and when document growth should trigger an earlier refresh.</p>
        </div>
      </div>

      <div class="analytics-settings-summary">
        <div class="analytics-settings-summary-card">
          <span class="analytics-settings-summary-label">Current schedule</span>
          <strong><%= analyticsScheduleSummary %></strong>
        </div>
        <div class="analytics-settings-summary-card">
          <span class="analytics-settings-summary-label">Change trigger</span>
          <strong><%= settings.analytics_change_threshold || '10' %>% growth since the last analytics snapshot</strong>
        </div>
      </div>

      <div class="analytics-settings-grid analytics-settings-grid--schedule">
        <label class="analytics-toggle-row analytics-toggle-row--wide">
          <input type="checkbox" name="analytics_enabled"
            <%= settings.analytics_enabled !== '0' ? 'checked' : '' %>>
          <span>
            <strong>Enable scheduled analytics</strong>
            <small>Run collection analytics automatically using the cadence below. Manual runs remain available any time.</small>
          </span>
        </label>

        <div class="form-group">
          <label for="analytics_schedule_interval">Run interval</label>
          <select id="analytics_schedule_interval" name="analytics_schedule_interval">
            <option value="24"  <%= analyticsSchedule.interval === '24'  ? 'selected' : '' %>>Daily</option>
            <option value="168" <%= analyticsSchedule.interval === '168' ? 'selected' : '' %>>Weekly</option>
            <option value="720" <%= analyticsSchedule.interval === '720' ? 'selected' : '' %>>Monthly</option>
          </select>
          <p class="field-hint">Weekly runs use the weekday below. Monthly runs happen on the first day of the month.</p>
        </div>

        <div class="form-group">
          <label for="analytics_schedule_day_of_week">Day of week</label>
          <select id="analytics_schedule_day_of_week" name="analytics_schedule_day_of_week">
            <% analyticsDayOptions.forEach(function(option) { %>
              <option value="<%= option.value %>" <%= analyticsSchedule.dayOfWeek === option.value ? 'selected' : '' %>><%= option.label %></option>
            <% }) %>
          </select>
          <p class="field-hint">Used for weekly runs. Daily and monthly runs ignore this setting.</p>
        </div>

        <div class="form-group">
          <label for="analytics_schedule_time">Run time</label>
          <input type="time" id="analytics_schedule_time" name="analytics_schedule_time" value="<%= analyticsSchedule.time %>" step="300">
          <p class="field-hint">Server local time.</p>
        </div>

        <div class="form-group">
          <label for="analytics_change_threshold">Change threshold (%)</label>
          <input type="number" id="analytics_change_threshold" name="analytics_change_threshold"
            value="<%= settings.analytics_change_threshold || '10' %>"
            min="1" max="100">
          <p class="field-hint">Also run when a collection grows by this percentage since its last analytics run.</p>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn-primary">Save Settings</button>
      </div>
    </section>
  </form>

  <section class="settings-section analytics-settings-section">
    <div class="analytics-section-header">
      <div>
        <p class="admin-section-label">Monitoring</p>
        <h2>Collection Status</h2>
        <p class="subtitle">Review the most recent analytics snapshot for each collection and trigger manual refreshes when needed.</p>
      </div>
      <div class="analytics-section-actions">
        <form method="POST" action="/admin/analytics-settings/run-all" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-secondary btn-sm">Run All Now</button>
        </form>
      </div>
    </div>
    <% if (statusRows.length === 0) { %>
      <p class="muted">No analytics have been run yet.</p>
    <% } else { %>
      <div class="users-table-wrap">
        <table class="users-table users-table--auto analytics-status-table">
          <thead>
            <tr>
              <th scope="col">Collection</th>
              <th scope="col">Last Run</th>
              <th scope="col">Documents</th>
              <th scope="col">Transcribed</th>
              <th scope="col">Storage</th>
              <th scope="col">Topics</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% statusRows.forEach(function(row) { %>
            <tr>
              <td>
                <div class="analytics-collection-cell">
                  <a href="/collections/<%= row.collection_id %>"><%= row.collection_name %></a>
                  <% if (!row.computed_at) { %>
                    <span class="access-badge access-restricted">Not yet run</span>
                  <% } %>
                </div>
              </td>
              <td>
                <% if (row.computed_at) { %>
                  <%= new Date(row.computed_at).toLocaleString() %>
                <% } else { %>
                  <span class="muted">Never</span>
                <% } %>
              </td>
              <td><%= row.document_count || 0 %></td>
              <td><%= row.transcribed_count || 0 %></td>
              <td><%= formatBytes(row.storage_bytes || 0) %></td>
              <td>
                <span class="access-badge <%= row.topicsStatus.badgeClass %>">
                  <%= row.topicsStatus.label %>
                </span>
              </td>
              <td class="col-actions">
                <form method="POST" action="/admin/analytics-settings/run/<%= row.collection_id %>" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn-secondary btn-sm">Run Now</button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
