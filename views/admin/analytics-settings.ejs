<%
function formatBytes(bytes) {
  if (!bytes) return '0 B';
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  if (bytes < 1073741824) return (bytes / 1048576).toFixed(1) + ' MB';
  return (bytes / 1073741824).toFixed(2) + ' GB';
}
%>
<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Document Analytics</h1>
    <p class="subtitle">Configure when analytics are computed and monitor per-collection status.</p>
  </div>

  <% if (flashMessage) { %>
    <div class="flash flash-<%= flashMessage.type %>"><%= flashMessage.text %></div>
  <% } %>

  <form method="POST" action="/admin/analytics-settings">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="settings-section">
      <h2>Schedule</h2>
      <div class="setting-row">
        <label class="setting-label">
          <input type="checkbox" name="analytics_enabled"
            <%= settings.analytics_enabled !== '0' ? 'checked' : '' %>>
          Enable scheduled analytics
        </label>
      </div>
      <div class="setting-row">
        <label class="setting-label" for="analytics_schedule_interval">Run interval</label>
        <select id="analytics_schedule_interval" name="analytics_schedule_interval" class="setting-input">
          <option value="24"  <%= settings.analytics_schedule_interval === '24'  ? 'selected' : '' %>>Daily</option>
          <option value="168" <%= (!settings.analytics_schedule_interval || settings.analytics_schedule_interval === '168') ? 'selected' : '' %>>Weekly</option>
          <option value="720" <%= settings.analytics_schedule_interval === '720' ? 'selected' : '' %>>Monthly</option>
        </select>
      </div>
      <div class="setting-row">
        <label class="setting-label" for="analytics_change_threshold">
          Change threshold (%)
          <span class="setting-hint">Also run when a collection grows by this % since last run</span>
        </label>
        <input type="number" id="analytics_change_threshold" name="analytics_change_threshold"
          value="<%= settings.analytics_change_threshold || '10' %>"
          min="1" max="100" class="setting-input setting-input-sm">
      </div>
      <div class="setting-actions">
        <button type="submit" class="btn btn-primary">Save Settings</button>
      </div>
    </div>
  </form>

  <div class="settings-section">
    <div class="settings-section-header">
      <h2>Collection Status</h2>
      <form method="POST" action="/admin/analytics-settings/run-all">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn-secondary btn-sm">Run All Now</button>
      </form>
    </div>
    <% if (latestStats.length === 0) { %>
      <p class="muted">No analytics have been run yet.</p>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th>Collection</th>
            <th>Last Run</th>
            <th>Documents</th>
            <th>Transcribed</th>
            <th>Storage</th>
            <th>Topics</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% latestStats.forEach(function(row) { %>
          <tr>
            <td><a href="/collections/<%= row.collection_id %>"><%= row.collection_name %></a></td>
            <td><%= new Date(row.computed_at).toLocaleString() %></td>
            <td><%= row.document_count %></td>
            <td><%= row.transcribed_count %></td>
            <td><%= formatBytes(row.storage_bytes) %></td>
            <td><%= row.topics_computed ? '✓' : '–' %></td>
            <td>
              <form method="POST" action="/admin/analytics-settings/run/<%= row.collection_id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm">Run Now</button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
