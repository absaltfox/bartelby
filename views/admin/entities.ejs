<%- include('../partials/header', { pageTitle: 'Entities', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'entities' }) %>

  <div class="admin-header">
    <h1>Entities</h1>
    <p class="subtitle">Browse approved and pending knowledge graph entities, then inspect the evidence behind each node.</p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <div class="filter-tabs">
    <%
      function filterHref(type, query, page) {
        var params = [];
        if (type && type !== 'all') params.push('type=' + encodeURIComponent(type));
        if (query) params.push('q=' + encodeURIComponent(query));
        if (page && page > 1) params.push('page=' + page);
        return '/admin/knowledge/entities' + (params.length ? '?' + params.join('&') : '');
      }
    %>
    <a href="<%= filterHref('all', q, 1) %>" class="filter-tab <%= typeFilter === 'all' ? 'active' : '' %>">All <span class="filter-count"><%= totalCount %></span></a>
    <% entityTypes.forEach(function(type) { %>
      <a href="<%= filterHref(type, q, 1) %>" class="filter-tab <%= typeFilter === type ? 'active' : '' %>">
        <%= type.charAt(0).toUpperCase() + type.slice(1) %>
        <span class="filter-count"><%= typeCounts[type] || 0 %></span>
      </a>
    <% }) %>
  </div>

  <div class="knowledge-toolbar">
    <form method="GET" action="/admin/knowledge/entities" class="admin-search-form">
      <input type="hidden" name="type" value="<%= typeFilter %>">
      <input type="search" name="q" value="<%= q %>" placeholder="Search entities..." class="admin-search-input">
      <button type="submit" class="btn-secondary btn-sm">Search</button>
      <% if (q) { %>
        <a href="/admin/knowledge/entities?type=<%= encodeURIComponent(typeFilter) %>" class="btn-secondary btn-sm">Clear</a>
      <% } %>
    </form>
  </div>

  <% if (entities.length === 0) { %>
    <div class="empty-state">
      <p>No entities found<% if (q) { %> for "<%= q %>"<% } %><% if (typeFilter !== 'all') { %> in type "<%= typeFilter %>"<% } %>.</p>
    </div>
  <% } else { %>
    <div class="workflows-table-wrap">
      <table class="workflows-table">
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">Entity</th>
            <th scope="col">Aliases</th>
            <th scope="col">Citations</th>
            <th scope="col" class="col-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% entities.forEach(function(entity) { %>
            <tr>
              <td><span class="entity-type-badge entity-type-<%= entity.entity_type %>"><%= entity.entity_type %></span></td>
              <td>
                <strong><a href="/admin/knowledge/entities/<%= entity.id %>"><%= entity.canonical_name %></a></strong>
                <% if (entity.description) { %>
                  <div class="muted"><%= entity.description %></div>
                <% } %>
              </td>
              <td><%= entity.alias_count || 0 %></td>
              <td><%= entity.citation_count || 0 %></td>
              <td>
                <a href="/admin/knowledge/entities/<%= entity.id %>" class="btn-secondary btn-sm">Open</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (currentPage > 1) { %>
          <a href="<%= filterHref(typeFilter, q, currentPage - 1) %>" class="pagination-btn">&lsaquo; Prev</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">&lsaquo; Prev</span>
        <% } %>
        <span class="pagination-info">Page <%= currentPage %> of <%= totalPages %> <span class="muted">(<%= totalCount %> entities)</span></span>
        <% if (currentPage < totalPages) { %>
          <a href="<%= filterHref(typeFilter, q, currentPage + 1) %>" class="pagination-btn">Next &rsaquo;</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">Next &rsaquo;</span>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/footer') %>
