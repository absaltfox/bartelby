<%- include('../partials/header', { pageTitle: 'User Management', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>User Management</h1>
    <p class="subtitle">Invite users, review access, and manage account-level AI permissions.</p>
    <div class="header-actions">
      <a href="/admin/users/invite" class="btn-primary">Invite User</a>
    </div>
  </div>

  <% if (flash) { %>
    <div class="alert alert-success">
      <p><%= flash.message %></p>
      <% if (flash.inviteUrl) { %>
        <p class="mt-2">
          <strong>Invite link:</strong>
          <a href="<%= flash.inviteUrl %>"><%= flash.inviteUrl %></a>
        </p>
      <% } %>
      <% if (flash.resetUrl) { %>
        <p class="mt-2">
          <strong>Password reset link:</strong>
          <a href="<%= flash.resetUrl %>"><%= flash.resetUrl %></a>
        </p>
      <% } %>
    </div>
  <% } %>

  <% if (invites.length > 0) { %>
    <div class="settings-section">
      <h2>Open Invitations (<%= invites.length %>)</h2>
      <% if (!smtpConfigured) { %>
        <p class="field-hint field-hint--mb-sm">SMTP is not configured, so invitation links must be copied manually from the success message after creation.</p>
      <% } %>
      <div class="users-table-wrap">
        <table class="users-table users-table--auto">
          <thead>
            <tr>
              <th scope="col">Email</th>
              <th scope="col">Access</th>
              <th scope="col">Expires</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% invites.forEach(function(invite) { %>
              <tr>
                <td class="user-email-cell"><%= invite.email %></td>
                <td>
                  <div class="user-badge-stack">
                    <span class="role-badge role-<%= invite.role %>"><%= invite.role %></span>
                    <% if (invite.access_all) { %>
                      <span class="access-badge access-all">All collections</span>
                    <% } else if ((invite.collection_ids || []).length > 0) { %>
                      <span class="access-badge access-restricted"><%= invite.collection_ids.length %> collection<%= invite.collection_ids.length !== 1 ? 's' : '' %></span>
                    <% } else { %>
                      <span class="access-badge access-restricted">No access</span>
                    <% } %>
                    <span class="access-badge <%= invite.can_use_system_api_keys ? 'access-all' : 'access-restricted' %>">
                      System keys: <%= invite.can_use_system_api_keys ? 'yes' : 'no' %>
                    </span>
                  </div>
                </td>
                <td class="user-date-cell"><%= new Date(invite.expires_at).toLocaleDateString() %></td>
                <td class="col-actions">
                  <form method="POST" action="/admin/users/invites/<%= invite.id %>/revoke" class="inline-form"
                        data-confirm-message="Revoke the invitation for <%= invite.email %>?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-danger btn-sm">Revoke</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- Pending approvals -->
  <% if (pending.length > 0) { %>
    <div class="settings-section pending-section">
      <h2>
        Pending Approval
        <span class="pending-badge"><%= pending.length %></span>
      </h2>
      <div class="users-table-wrap">
        <table class="users-table users-table--auto">
          <thead>
            <tr>
              <th scope="col">Username</th>
              <th scope="col">Email</th>
              <th scope="col">Requested</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% pending.forEach(function(u) { %>
              <tr>
                <td><span class="username-text"><%= u.username %></span></td>
                <td class="user-email-cell"><% if (u.email) { %><%= u.email %><% } else { %><span class="muted">&mdash;</span><% } %></td>
                <td class="user-date-cell"><%= new Date(u.created_at).toLocaleDateString() %></td>
                <td class="col-actions">
                  <div class="user-actions-row">
                    <a href="/admin/users/<%= u.id %>/approve" class="btn-secondary btn-sm">Review</a>
                    <form method="POST" action="/admin/users/<%= u.id %>/reject" class="inline-form"
                          data-confirm-message="Reject <%= u.username %>&apos;s request?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn-danger btn-sm">Reject</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>

  <!-- Active users -->
  <div class="settings-section">
    <h2>Active Users (<%= active.length %>)</h2>
    <% if (active.length === 0) { %>
      <p class="muted is-italic">No active users.</p>
    <% } else { %>
      <div class="users-table-wrap">
        <table class="users-table users-table--auto">
          <thead>
            <tr>
              <th scope="col">User</th>
              <th scope="col">Permissions</th>
              <th scope="col">Security</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% active.forEach(function(u) { %>
              <tr class="<%= u.id === currentUserId ? 'row-self' : '' %>">
                <td>
                  <div class="user-identity">
                    <span class="username-text"><%= u.username %><% if (u.id === currentUserId) { %> <span class="badge-you">you</span><% } %></span>
                    <% if (u.email) { %><span class="user-email-sub"><%= u.email %></span><% } %>
                  </div>
                </td>
                <td>
                  <div class="user-badge-stack">
                    <span class="role-badge role-<%= u.role %>"><%= u.role %></span>
                    <% if (u.role === 'admin') { %>
                      <span class="access-badge access-all">All access</span>
                    <% } else if (u.access_all) { %>
                      <span class="access-badge access-all">All collections</span>
                    <% } else { %>
                      <span class="access-badge access-restricted">Restricted</span>
                    <% } %>
                    <% if (u.role !== 'admin') { %>
                      <span class="access-badge <%= u.can_use_system_api_keys ? 'access-all' : 'access-restricted' %>">
                        System keys: <%= u.can_use_system_api_keys ? 'yes' : 'no' %>
                      </span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <div class="user-badge-stack">
                    <% if (u.mfa_method && u.mfa_method !== 'none') { %>
                      <span class="access-badge access-all">MFA: <%= u.mfa_method.toUpperCase() %></span>
                    <% } else { %>
                      <span class="access-badge access-restricted">No MFA</span>
                    <% } %>
                    <span class="user-meta-text">Joined <%= new Date(u.created_at).toLocaleDateString() %></span>
                  </div>
                </td>
                <td class="col-actions">
                  <% if (u.id !== currentUserId) { %>
                    <div class="user-actions-row">
                      <a href="/admin/users/<%= u.id %>/access" class="btn-secondary btn-sm">Edit Access</a>
                      <form method="POST" action="/admin/users/<%= u.id %>/password-reset" class="inline-form"
                          data-confirm-message="Create a password reset link for <%= u.username %>?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn-secondary btn-sm">Reset Password</button>
                      </form>
                      <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline-form delete-user-form"
                          data-name="<%= u.username %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="button" class="btn-danger btn-sm delete-user-btn">Delete</button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="muted is-italic mt-2">Current user</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Rejected -->
  <% if (rejected.length > 0) { %>
    <div class="settings-section">
      <h2>Rejected (<%= rejected.length %>)</h2>
      <div class="users-table-wrap">
        <table class="users-table users-table--auto">
          <thead>
            <tr>
              <th scope="col">Username</th>
              <th scope="col">Email</th>
              <th scope="col">Requested</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% rejected.forEach(function(u) { %>
              <tr>
                <td><span class="username-text"><%= u.username %></span></td>
                <td class="user-email-cell"><% if (u.email) { %><%= u.email %><% } else { %><span class="muted">&mdash;</span><% } %></td>
                <td class="user-date-cell"><%= new Date(u.created_at).toLocaleDateString() %></td>
                <td class="col-actions">
                  <div class="user-actions-row">
                    <a href="/admin/users/<%= u.id %>/approve" class="btn-primary btn-sm">Approve</a>
                    <form method="POST" action="/admin/users/<%= u.id %>/delete" class="inline-form delete-user-form"
                          data-name="<%= u.username %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="button" class="btn-danger btn-sm delete-user-btn">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>

<div class="tag-modal-overlay is-hidden" id="delete-user-modal">
  <div class="tag-modal tag-modal--wide">
    <div class="tag-modal-header">
      <h3 id="delete-user-modal-title">Delete User</h3>
      <button type="button" class="tag-modal-close" id="delete-user-modal-close">&times;</button>
    </div>
    <div class="tag-modal-body tag-modal-body--pad">
      <p class="mb-4">Delete <strong id="delete-user-name"></strong>?</p>
      <p class="field-hint admin-note--tight">This permanently removes the account and cannot be undone.</p>
    </div>
    <div class="tag-modal-footer">
      <button type="button" class="btn-secondary btn-sm" id="delete-user-cancel">Cancel</button>
      <button type="button" class="btn-danger btn-sm" id="delete-user-confirm">Delete User</button>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
