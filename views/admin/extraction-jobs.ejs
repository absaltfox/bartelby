<%- include('../partials/header', { pageTitle: 'Extraction Jobs', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'extraction-jobs' }) %>

  <div class="admin-header">
    <h1>Extraction Jobs</h1>
    <p class="subtitle">LLM-powered entity extraction runs</p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <p class="search-advanced-link-row"><a href="/admin/knowledge/review-extractions">Review extractions</a></p>

  <% if (jobs.length === 0) { %>
    <div class="empty-state empty-state--padded-lg">
      <h2>No extraction jobs</h2>
      <p>Extraction jobs are queued from a document's Knowledge tab or via
        collection re-extraction on
        <a href="/admin/knowledge">Knowledge Overview</a>.</p>
    </div>
  <% } else { %>
    <div class="workflows-table-wrap">
      <table class="workflows-table">
        <thead>
          <tr>
            <th scope="col">Status</th>
            <th scope="col">Source</th>
            <th scope="col">Entities</th>
            <th scope="col">Relationships</th>
            <th scope="col">Drops</th>
            <th scope="col">Recorded</th>
            <th scope="col" class="col-actions">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.forEach(function(job) { %>
            <tr>
              <td><span class="status-badge status-<%= job.status %>"><%= job.status %></span></td>
              <td>
                <% if (job.job_kind === 'batch') { %>
                  <strong><%= job.batch_display_name || 'Collection batch' %></strong>
                  <div class="muted">
                    <%= job.batch_document_count || 0 %> document<%= Number(job.batch_document_count || 0) !== 1 ? 's' : '' %>
                    <% if (job.batch_completed_count || job.batch_failed_count) { %>
                      • <%= job.batch_completed_count || 0 %> complete
                      <% if (job.batch_failed_count) { %> • <%= job.batch_failed_count %> failed<% } %>
                    <% } %>
                  </div>
                  <% if (job.batch_remote_status) { %>
                    <div class="muted">Provider status: <%= job.batch_remote_status %></div>
                  <% } %>
                  <% if (job.document_title) { %>
                    <div class="muted">Anchor document: <a href="/documents/<%= job.document_id %>"><%= job.document_title %></a></div>
                  <% } %>
                <% } else if (job.document_title) { %>
                  <a href="/documents/<%= job.document_id %>"><%= job.document_title %></a>
                <% } else { %>
                  <span class="muted">Transcript #<%= job.transcript_id %></span>
                <% } %>
                <% if (job.error) { %><div class="job-error">Error: <%= job.error %></div><% } %>
              </td>
              <td><%= job.entity_count || 0 %></td>
              <td><%= job.relationship_count || 0 %></td>
              <td>
                <% if ((job.unresolved_relationship_count || 0) || (job.unresolved_date_count || 0) || (job.dropped_verbatim_mismatch_count || 0) || (job.dropped_unknown_entity_mention_count || 0)) { %>
                  <span class="status-badge status-failed">
                    <%= job.dropped_verbatim_mismatch_count || 0 %> verbatim,
                    <%= job.dropped_unknown_entity_mention_count || 0 %> mention,
                    <%= job.unresolved_relationship_count || 0 %> relationship,
                    <%= job.unresolved_date_count || 0 %> date
                  </span>
                <% } else { %>
                  <span class="muted">0</span>
                <% } %>
              </td>
              <td><span class="muted"><%= new Date(job.created_at).toLocaleString() %></span></td>
              <td>
                <div class="job-actions">
                  <form method="POST" action="/admin/knowledge/extraction-jobs/<%= job.id %>/retry" class="inline-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-secondary btn-sm"><%= job.status === 'failed' ? 'Retry' : 'Re-run' %></button>
                  </form>
                  <form method="POST" action="/admin/knowledge/extraction-jobs/<%= job.id %>/delete" class="inline-form" data-confirm-message="Delete this extraction job?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn-danger btn-sm">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
