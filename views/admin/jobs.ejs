<%- include('../partials/header', { pageTitle: 'Jobs', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Jobs</h1>
    <p class="subtitle">Background import, transcription, knowledge extraction, and sentiment jobs</p>
  </div>

  <!-- Filter tabs: status -->
  <div class="filter-tabs">
  <%
    const jobsApiBase = '/admin/jobs/api';
    function filterHref(f, t) {
      var params = [];
      if (f !== 'all') params.push('filter=' + f);
      if (t !== 'all') params.push('type=' + t);
        // Reset to page 1 when changing filters
        return '/admin/jobs' + (params.length ? '?' + params.join('&') : '');
      }
      function pageHref(p) {
        var params = [];
        if (filter !== 'all') params.push('filter=' + filter);
        if (typeFilter !== 'all') params.push('type=' + typeFilter);
        if (p > 1) params.push('page=' + p);
        return '/admin/jobs' + (params.length ? '?' + params.join('&') : '');
      }
    %>
    <a href="<%= filterHref('all', typeFilter) %>" class="filter-tab <%= filter === 'all' ? 'active' : '' %>">
      All <span class="filter-count"><%= counts.total %></span>
    </a>
    <a href="<%= filterHref('queued', typeFilter) %>" class="filter-tab <%= filter === 'queued' ? 'active' : '' %>">
      Queued <span class="filter-count"><%= counts.queued %></span>
    </a>
    <a href="<%= filterHref('running', typeFilter) %>" class="filter-tab filter-tab-running <%= filter === 'running' ? 'active' : '' %>">
      Running <span class="filter-count"><%= counts.running %></span>
    </a>
    <a href="<%= filterHref('done', typeFilter) %>" class="filter-tab filter-tab-done <%= filter === 'done' ? 'active' : '' %>">
      Done <span class="filter-count"><%= counts.done %></span>
    </a>
    <a href="<%= filterHref('failed', typeFilter) %>" class="filter-tab filter-tab-failed <%= filter === 'failed' ? 'active' : '' %>">
      Failed <span class="filter-count"><%= counts.failed %></span>
    </a>

    <span class="filter-separator"></span>

    <a href="<%= filterHref(filter, 'all') %>" class="filter-tab filter-tab-type <%= typeFilter === 'all' ? 'active' : '' %>">
      All Types
    </a>
    <a href="<%= filterHref(filter, 'import') %>" class="filter-tab filter-tab-type <%= typeFilter === 'import' ? 'active' : '' %>">
      Import <span class="filter-count"><%= typeCounts.import %></span>
    </a>
    <a href="<%= filterHref(filter, 'transcription') %>" class="filter-tab filter-tab-type <%= typeFilter === 'transcription' ? 'active' : '' %>">
      Transcription <span class="filter-count"><%= typeCounts.transcription %></span>
    </a>
    <a href="<%= filterHref(filter, 'extraction') %>" class="filter-tab filter-tab-type <%= typeFilter === 'extraction' ? 'active' : '' %>">
      Extraction <span class="filter-count"><%= typeCounts.extraction %></span>
    </a>
    <a href="<%= filterHref(filter, 'sentiment') %>" class="filter-tab filter-tab-type <%= typeFilter === 'sentiment' ? 'active' : '' %>">
      Sentiment <span class="filter-count"><%= typeCounts.sentiment %></span>
    </a>
    <a href="<%= filterHref(filter, 'authority_suggestion') %>" class="filter-tab filter-tab-type <%= typeFilter === 'authority_suggestion' ? 'active' : '' %>">
      Authority Suggestion <span class="filter-count"><%= typeCounts.authority_suggestion %></span>
    </a>
  </div>

  <% if (pendingReconcileCount > 0) { %>
    <div class="jobs-reconcile-banner">
      <span class="muted"><%= pendingReconcileCount %> orphaned sentiment batch row<%= pendingReconcileCount === 1 ? '' : 's' %> awaiting reconciliation.</span>
      <button type="button" class="btn-secondary btn-sm" id="sentiment-reconcile-btn">Reconcile now</button>
      <span class="save-status" id="sentiment-reconcile-status"></span>
    </div>
  <% } %>

  <!-- Bulk action bar -->
  <div class="jobs-toolbar is-hidden" id="jobs-toolbar">
    <label class="jobs-toolbar-select-all">
      <input type="checkbox" id="select-all-jobs">
      <span id="select-all-label">Select all</span>
    </label>
    <span id="jobs-bulk-count" class="bulk-count">0 selected</span>
    <div class="jobs-toolbar-actions">
      <button type="button" class="btn-secondary btn-sm is-hidden" id="bulk-retry-btn">Retry Selected</button>
      <button type="button" class="btn-danger btn-sm" id="bulk-delete-btn">Delete Selected</button>
    </div>
  </div>

  <% if (jobs.length === 0) { %>
    <div class="empty-state">
      <p>No jobs<% if (filter !== 'all') { %> with status "<%= filter %>"<% } %><% if (typeFilter !== 'all') { %> of type "<%= typeFilter %>"<% } %>.</p>
    </div>
  <% } else { %>
    <div class="workflows-table-wrap">
      <table class="workflows-table workflows-table--auto">
        <thead>
          <tr>
            <th scope="col" class="th-cb"><input type="checkbox" id="header-select-all" aria-label="Select all jobs"></th>
            <th scope="col">Type</th>
            <th scope="col">Status</th>
            <th scope="col">Document</th>
            <th scope="col">Provider</th>
            <th scope="col">Time</th>
            <th scope="col" class="col-actions">Actions</th>
          </tr>
        </thead>
        <tbody id="jobs-tbody">
          <% jobs.forEach(function(job) { %>
            <%
              let durationStr = '';
              if (job.started_at && job.completed_at) {
                const ms = new Date(job.completed_at) - new Date(job.started_at);
                durationStr = (ms / 1000).toFixed(1) + 's';
              } else if (job.started_at && job.status === 'running') {
                durationStr = 'running…';
              } else if (job.status === 'processing') {
                durationStr = 'processing…';
              }

              const isImport = job.job_type === 'import';
              const isImportSubmit = isImport && job.job_kind === 'submit';
              const isImportGrouping = isImport && job.job_kind === 'grouping';
              const isSentiment = job.job_type === 'sentiment';
              const isBatch = !isImport && !isSentiment && job.job_kind === 'batch';
              const isAuthoritySuggestion = job.job_type === 'authority_suggestion';
              const canDelete = job.status === 'done' || job.status === 'failed';
              const canRetry = job.status === 'failed' && (
                isAuthoritySuggestion
                  ? true
                  : (!isImport || isImportSubmit)
              );
              // Sentiment has no provider-edit flow (model is resolved per-cycle
              // from settings, not stored per-job in an editable form).
              // Authority suggestion has no provider to edit either.
              const canEdit = job.status === 'failed' && !isImport && !isSentiment && !isAuthoritySuggestion;
              const canForceFail = job.status === 'running'
                && (
                  (job.job_kind === 'batch' && (job.job_type === 'transcription' || job.job_type === 'extraction'))
                  || job.job_type === 'authority_suggestion'
                );
            %>
            <tr class="job-row" data-id="<%= job.id %>" data-status="<%= job.status %>" data-type="<%= job.job_type %>"
                data-can-delete="<%= canDelete %>" data-can-retry="<%= canRetry %>">
              <td class="td-cb">
                <input type="checkbox" class="job-cb" value="<%= job.id %>" data-type="<%= job.job_type %>"
                       data-can-delete="<%= canDelete %>" data-can-retry="<%= canRetry %>">
              </td>
              <td>
                <span class="job-type-badge job-type-<%= job.job_type %>">
                  <%= isImportSubmit ? 'Submit'
                    : isImportGrouping ? 'Grouping'
                    : isImport ? 'Import'
                    : job.job_type === 'extraction' ? 'Extraction'
                    : isSentiment ? 'Sentiment'
                    : isAuthoritySuggestion ? 'Authority Suggestion'
                    : 'Transcription' %>
                </span>
              </td>
              <td>
                <span class="status-badge status-<%= job.status %>"><%= job.status %></span>
              </td>
              <td class="job-subject-cell" data-job-cell="subject">
                <% if (isImport) { %>
                  <span><%= job.original_name || 'PDF Import' %></span>
                  <% if (isImportSubmit && (job.status === 'running' || job.status === 'queued') && job.page_count) { %>
                    <div class="import-progress">
                      <div class="import-progress-bar" data-progress="<%= Math.round((job.pages_rendered || 0) / job.page_count * 100) %>"></div>
                    </div>
                    <small class="muted">Creating document <%= Math.min((job.pages_rendered || 0) + 1, job.page_count) %> of <%= job.page_count %></small>
                  <% } else if (job.status === 'processing' && job.page_count) { %>
                    <div class="import-progress">
                      <div class="import-progress-bar" data-progress="<%= Math.round((job.pages_rendered || 0) / job.page_count * 100) %>"></div>
                    </div>
                    <small class="muted">Rendering page <%= job.pages_rendered || 0 %> of <%= job.page_count %></small>
                  <% } else if (job.status === 'processing') { %>
                    <small class="muted">Starting...</small>
                  <% } else if (isImportSubmit && job.page_count) { %>
                    <small class="muted"> (<%= job.page_count %> documents)</small>
                  <% } else if (job.page_count) { %>
                    <small class="muted"> (<%= job.page_count %> pages)</small>
                  <% } %>
                <% } else if (job.job_type === 'extraction' && job.job_kind === 'batch') { %>
                  <span><%= job.batch_display_name || 'Batch extraction job' %></span>
                  <small class="muted">
                    <%= job.batch_document_count || 0 %> documents
                    <% if (job.batch_completed_count || job.batch_failed_count) { %>
                      • <%= job.batch_completed_count || 0 %> complete
                      <% if (job.batch_failed_count) { %> • <%= job.batch_failed_count %> failed<% } %>
                    <% } %>
                    <% if (job.batch_remote_status) { %> • <%= job.batch_remote_status %><% } %>
                  </small>
                  <% if (job.status === 'done' && ((job.unresolved_relationship_count || 0) > 0 || (job.unresolved_date_count || 0) > 0 || (job.dropped_verbatim_mismatch_count || 0) > 0 || (job.dropped_unknown_entity_mention_count || 0) > 0)) { %>
                    <small class="muted">
                      drops/unresolved:
                      <%= job.dropped_verbatim_mismatch_count || 0 %> verbatim,
                      <%= job.dropped_unknown_entity_mention_count || 0 %> mention,
                      <%= job.unresolved_relationship_count || 0 %> relationship(s),
                      <%= job.unresolved_date_count || 0 %> date(s)
                      <span class="status-badge status-failed">check WARN log</span>
                    </small>
                  <% } %>
                <% } else if (isBatch) { %>
                  <span><%= job.batch_display_name || 'Batch transcription job' %></span>
                  <small class="muted">
                    <%= job.batch_document_count || 0 %> documents
                    <% if (job.batch_page_count) { %> • <%= job.batch_page_count %> pages<% } %>
                    <% if (job.batch_remote_status) { %> • <%= job.batch_remote_status %><% } %>
                  </small>
                <% } else if (isAuthoritySuggestion) { %>
                  <span><%= job.subject_label || (job.collection_id == null ? 'Full corpus' : 'Collection #' + job.collection_id) %></span>
                  <% if (job.status === 'failed' && job.error) { %>
                    <div class="job-error job-error--inline" data-job-error="true"><%= job.error %></div>
                  <% } else if (job.status === 'done') { %>
                    <small class="muted">
                      <%= job.entity_count || 0 %> entities •
                      <%= job.candidate_count || 0 %> candidate pairs •
                      <%= job.suggestion_count || 0 %> suggestions
                      <% if (job.auto_approved_count) { %> • <%= job.auto_approved_count %> auto-approved<% } %>
                    </small>
                    <% if (job.suggestion_count > 0) { %>
                      <small class="muted">
                        confidence: min <%= (job.confidence_min || 0).toFixed(4) %>,
                        max <%= (job.confidence_max || 0).toFixed(4) %>,
                        distinct <%= job.confidence_distinct_count || 0 %>
                        <% if (job.confidence_distinct_count <= 1 && job.suggestion_count > 1) { %>
                          <strong class="status-badge status-failed">⚠ uniform — investigate scorePairs</strong>
                        <% } %>
                      </small>
                    <% } %>
                  <% } %>
                <% } else if (job.document_title) { %>
                  <a href="/documents/<%= job.document_id %>"><%= job.document_title %></a>
                  <% if (job.job_type === 'extraction' && job.status === 'done' && ((job.unresolved_relationship_count || 0) > 0 || (job.unresolved_date_count || 0) > 0 || (job.dropped_verbatim_mismatch_count || 0) > 0 || (job.dropped_unknown_entity_mention_count || 0) > 0)) { %>
                    <small class="muted">
                      drops/unresolved:
                      <%= job.dropped_verbatim_mismatch_count || 0 %> verbatim,
                      <%= job.dropped_unknown_entity_mention_count || 0 %> mention,
                      <%= job.unresolved_relationship_count || 0 %> relationship(s),
                      <%= job.unresolved_date_count || 0 %> date(s)
                      <span class="status-badge status-failed">check WARN log</span>
                    </small>
                  <% } %>
                <% } else { %>
                  <span class="muted">Document #<%= job.document_id %></span>
                  <% if (job.job_type === 'extraction' && job.status === 'done' && ((job.unresolved_relationship_count || 0) > 0 || (job.unresolved_date_count || 0) > 0 || (job.dropped_verbatim_mismatch_count || 0) > 0 || (job.dropped_unknown_entity_mention_count || 0) > 0)) { %>
                    <small class="muted">
                      drops/unresolved:
                      <%= job.dropped_verbatim_mismatch_count || 0 %> verbatim,
                      <%= job.dropped_unknown_entity_mention_count || 0 %> mention,
                      <%= job.unresolved_relationship_count || 0 %> relationship(s),
                      <%= job.unresolved_date_count || 0 %> date(s)
                      <span class="status-badge status-failed">check WARN log</span>
                    </small>
                  <% } %>
                <% } %>
              </td>
              <td><%= job.provider || '—' %></td>
              <td class="job-time-cell">
                <span class="muted"><%= new Date(job.created_at).toLocaleString() %></span>
                <% if (durationStr) { %><span class="job-duration"><%= durationStr %></span><% } %>
              </td>
              <td class="job-actions-cell" data-job-cell="actions">
                <div class="job-actions">
                  <% if (!isImport || isImportSubmit) { %>
                    <button type="button" class="btn-secondary btn-sm toggle-log-btn" data-id="<%= job.id %>" data-type="<%= job.job_type %>">Log</button>
                  <% } %>
                  <% if (isImport && !isImportGrouping && job.status === 'done' && !job.submitted) { %>
                    <a href="/admin/import?importJobId=<%= job.id %>" class="btn-secondary btn-sm">Continue</a>
                  <% } %>
                  <% if (canEdit) { %>
                    <button type="button" class="btn-secondary btn-sm edit-job-btn" data-id="<%= job.id %>" data-type="<%= job.job_type %>" data-provider="<%= job.provider || '' %>" data-model="<%= job.model || '' %>">Edit</button>
                  <% } %>
                  <% if (canRetry) { %>
                    <button type="button" class="btn-secondary btn-sm retry-btn" data-id="<%= job.id %>">Retry</button>
                  <% } %>
                  <% if (canForceFail) { %>
                    <button type="button" class="btn-danger btn-sm force-fail-btn" data-id="<%= job.id %>" data-type="<%= job.job_type %>">Mark failed</button>
                  <% } %>
                  <% if (canDelete) { %>
                    <button type="button" class="btn-danger btn-sm delete-job-btn" data-id="<%= job.id %>" data-type="<%= job.job_type %>">Delete</button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% if (!isImport || isImportSubmit) { %>
              <tr class="log-row is-hidden" id="log-row-<%= job.id %>">
                <td colspan="7">
                  <% if (job.error) { %>
                    <div class="job-error">Error: <%= job.error %></div>
                  <% } %>
                  <pre class="job-log" id="job-log-<%= job.id %>" data-log-loaded="false">(open log to load)</pre>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% if (page > 1) { %>
          <a href="<%= pageHref(page - 1) %>" class="pagination-btn">&lsaquo; Prev</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">&lsaquo; Prev</span>
        <% } %>

        <span class="pagination-info">
          Page <%= page %> of <%= totalPages %>
          <span class="muted">(<%= filteredTotal %> jobs)</span>
        </span>

        <% if (page < totalPages) { %>
          <a href="<%= pageHref(page + 1) %>" class="pagination-btn">Next &rsaquo;</a>
        <% } else { %>
          <span class="pagination-btn pagination-btn--disabled">Next &rsaquo;</span>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>

<!-- Edit Job Provider Modal -->
<div class="modal-overlay is-hidden" id="edit-job-modal" role="dialog" aria-modal="true" aria-labelledby="edit-job-modal-title">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 id="edit-job-modal-title">Change Provider &amp; Retry</h3>
      <button type="button" class="modal-close" id="close-edit-job-modal" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body">
      <form id="edit-job-form">
        <div class="edit-field">
          <label for="edit-job-provider">Provider</label>
          <select id="edit-job-provider" name="provider"></select>
        </div>
        <div class="edit-field">
          <label for="edit-job-model">Model <span class="field-hint-inline">(optional override)</span></label>
          <input type="text" id="edit-job-model" name="model" placeholder="Use provider default">
        </div>
        <div class="edit-actions edit-actions--spaced">
          <button type="submit" class="btn-primary btn-sm" id="edit-job-submit-btn">Save &amp; Retry</button>
          <span class="save-status" id="edit-job-status"></span>
        </div>
      </form>
    </div>
  </div>
</div>

<script id="jobs-page-config" type="application/json"><%- JSON.stringify({
  mode: 'admin',
  filter,
  typeFilter,
  pageBaseUrl: '/admin/jobs',
  apiBase: jobsApiBase,
  apiBasesByType: {
    transcription: jobsApiBase + '/',
    extraction: jobsApiBase + '/extraction/',
    import: jobsApiBase + '/import/',
    sentiment: jobsApiBase + '/sentiment/',
    authority_suggestion: jobsApiBase + '/authority-suggestion/'
  },
  pollUrl: jobsApiBase + '/all',
  activePollUrl: jobsApiBase + '/all',
  bulkRetryUrl: jobsApiBase + '/bulk/retry',
  bulkDeleteUrl: jobsApiBase + '/bulk/delete',
  configuredProviders: configuredProviders
}).replace(/</g, '\\u003c') %></script>
<script src="/js/jobs-page.js"></script>

<%- include('../partials/footer') %>
