<%- include('../partials/header', { pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Authorities', href: '/admin/knowledge/authorities' },
    { label: authority.canonical_name, href: '/admin/knowledge/authorities/' + authority.id },
    { label: 'Chronology' }
  ] }) %>

  <div class="admin-header entity-header">
    <h1><%= authority.canonical_name %></h1>
    <p class="entity-meta">
      <span class="entity-type-badge entity-type-<%= authority.authority_type %>"><%= authority.authority_type %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span>Chronology</span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span>Merged timeline of citations, relationships, sentiment, and dated events across this authority's members.</span>
    </p>
  </div>

  <%- include('../partials/authority-chronology-panel', {
    authorityId: authority.id,
    filters,
    activeSignalTypes,
    signalTypes,
    collections,
    buckets,
    nextCursor
  }) %>
</div>

<script src="/js/authority-chronology.js"></script>
<%- include('../partials/footer') %>
