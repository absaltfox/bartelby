<%- include('../partials/header', { pageTitle: 'Review Extractions', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'review-extractions' }) %>

  <div class="admin-header">
    <h1>Review Extractions</h1>
    <p class="subtitle">Approve, reject, or remove extracted evidence before it becomes visible in the knowledge graph.</p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <%- include('../partials/flash-alerts', { flashes }) %>
  <div class="alert is-hidden" data-review-live-message role="status" aria-live="polite"></div>

  <%
    function reviewHref(targetStatus, targetPage, targetKind) {
      var params = [];
      if (targetStatus && targetStatus !== 'pending') params.push('status=' + encodeURIComponent(targetStatus));
      var effectiveKind = targetKind || reviewKind || 'all';
      if (effectiveKind && effectiveKind !== 'all') params.push('kind=' + encodeURIComponent(effectiveKind));
      if (targetPage && targetPage > 1) params.push('page=' + encodeURIComponent(targetPage));
      return '/admin/knowledge/review-extractions' + (params.length ? '?' + params.join('&') : '');
    }
  %>

  <div class="knowledge-toolbar review-extractions-toolbar">
    <div class="filter-tabs review-status-tabs" role="tablist" aria-label="Extraction review status">
      <a href="<%= reviewHref('pending', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'pending' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'pending' ? 'true' : 'false' %>" data-review-status-tab data-status="pending">
        Pending <span class="filter-count review-status-count" data-review-status-count data-status="pending"><%= statusCounts.pending || 0 %></span>
      </a>
      <a href="<%= reviewHref('approved', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'approved' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'approved' ? 'true' : 'false' %>" data-review-status-tab data-status="approved">
        Approved <span class="filter-count review-status-count" data-review-status-count data-status="approved"><%= statusCounts.approved || 0 %></span>
      </a>
      <a href="<%= reviewHref('rejected', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'rejected' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'rejected' ? 'true' : 'false' %>" data-review-status-tab data-status="rejected">
        Rejected <span class="filter-count review-status-count" data-review-status-count data-status="rejected"><%= statusCounts.rejected || 0 %></span>
      </a>
      <a href="<%= reviewHref('all', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'all' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'all' ? 'true' : 'false' %>" data-review-status-tab data-status="all">
        All <span class="filter-count review-status-count" data-review-status-count data-status="all"><%= totalCount %></span>
      </a>
    </div>
    <div class="knowledge-toolbar-actions">
      <form method="GET" action="/admin/knowledge/review-extractions" class="admin-search-form review-filter-form">
        <% if (approvalStatus && approvalStatus !== 'pending') { %>
          <input type="hidden" name="status" value="<%= approvalStatus %>">
        <% } %>

        <label for="review_kind_filter" class="review-filter-label">Filter type</label>
        <select id="review_kind_filter" name="kind" class="review-filter-select" data-submit-on-change="1" aria-label="Filter review queue by evidence or entity type">
          <% (reviewKindOptions || []).forEach(function(option) { %>
            <option value="<%= option.value %>" <%= option.value === (reviewKind || 'all') ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>

        <label for="review-source" class="review-filter-label">Source</label>
        <select name="source" id="review-source" class="review-filter-select" data-submit-on-change="1" aria-label="Filter review queue by extraction source">
          <option value="" <%= !source ? 'selected' : '' %>>All sources</option>
          <% (sourceOptions || []).forEach(function(option) { %>
            <option value="<%= option.value %>" <%= option.value === source ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>

        <label for="review-sort" class="review-filter-label">Sort</label>
        <select name="sort" id="review-sort" class="review-filter-select" data-submit-on-change="1" aria-label="Sort review queue">
          <% (sortOptions || []).forEach(function(option) { %>
            <option value="<%= option.value %>" <%= option.value === sort ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>

        <noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
      </form>
    </div>
  </div>

  <%- include('../partials/knowledge/review-extractions-list', {
    reviewItems: reviewItems,
    approvalStatus: approvalStatus,
    reviewKind: reviewKind,
    reviewKindLabel: reviewKindLabel,
    totalCount: totalCount,
    totalPages: totalPages,
    currentPage: currentPage,
    csrfToken: csrfToken,
    urlPrefix: '/admin/knowledge'
  }) %>
</div>

<div class="modal-overlay is-hidden" id="review-bulk-delete-modal" role="dialog" aria-modal="true" aria-labelledby="review-bulk-delete-title">
  <div class="modal-dialog">
    <div class="modal-header">
      <h3 id="review-bulk-delete-title">Delete <span id="review-bulk-delete-count">N</span> citation(s) permanently?</h3>
    </div>
    <div class="modal-body">
      <p class="muted">This removes citation evidence records and cannot be undone. Approved citations are excluded automatically.</p>
    </div>
    <div class="modal-actions">
      <button type="button" class="btn-danger" id="review-bulk-delete-confirm">Delete</button>
      <button type="button" class="btn-secondary" id="review-bulk-delete-cancel">Cancel</button>
    </div>
  </div>
</div>

<div class="modal-overlay is-hidden" id="review-preview-modal" role="dialog" aria-modal="true" aria-labelledby="review-preview-modal-title">
  <div class="modal-dialog review-preview-modal-dialog">
    <div class="modal-header">
      <div class="review-preview-modal-heading">
        <p class="kg-panel-eyebrow">Passage Preview</p>
        <h3 id="review-preview-modal-title">Document preview</h3>
      </div>
      <button type="button" class="modal-close" id="review-preview-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body review-preview-modal-body">
      <div class="review-preview-meta" id="review-preview-meta"></div>
      <div class="review-preview-layout">
        <section class="review-preview-panel">
          <div class="review-preview-panel-header">
            <h4>Original document</h4>
            <span class="review-preview-page-label" id="review-preview-page-label"></span>
          </div>
          <div class="review-preview-image-wrap" id="review-preview-image-wrap">
            <p class="muted">Loading image preview…</p>
          </div>
        </section>
        <section class="review-preview-panel">
          <div class="review-preview-panel-header">
            <h4>Transcript context</h4>
            <span class="review-preview-transcript-label" id="review-preview-transcript-label"></span>
          </div>
          <div class="review-preview-transcript" id="review-preview-transcript">
            <p class="muted">Loading transcript preview…</p>
          </div>
          <p class="review-preview-passage-note" id="review-preview-passage-note"></p>
        </section>
      </div>
      <div class="review-preview-context" id="review-preview-context"></div>
      <div class="review-preview-footer">
        <a href="#" class="btn-secondary btn-sm" id="review-preview-document-link" target="_blank" rel="noopener">Open full document</a>
      </div>
    </div>
  </div>
</div>

<script id="review-extractions-config" type="application/json"><%- JSON.stringify({
  bulkApproveUrl: '/admin/knowledge/review-extractions/bulk/approve',
  bulkRejectUrl: '/admin/knowledge/review-extractions/bulk/reject',
  bulkDeleteUrl: '/admin/knowledge/review-extractions/bulk/delete',
  csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : null
}).replace(/</g, '\\u003c') %></script>
<script src="/js/review-extractions.js"></script>
<script src="/js/review-extractions-bulk.js"></script>
<%- include('../partials/footer') %>
