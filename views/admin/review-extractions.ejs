<%- include('../partials/header', { pageTitle: 'Review Extractions', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Review Extractions</h1>
    <p class="subtitle">Approve, reject, or remove extracted evidence before it becomes visible in the knowledge graph.</p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'review-extractions' }) %>

  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (typeof confirmed !== 'undefined' && confirmed) { %><div class="alert alert-success">Citation approved.</div><% } %>
  <% if (typeof rejected !== 'undefined' && rejected) { %><div class="alert alert-success">Citation rejected.</div><% } %>
  <% if (typeof deleted !== 'undefined' && deleted) { %><div class="alert alert-success">Citation deleted.</div><% } %>
  <div class="alert is-hidden" data-review-live-message role="status" aria-live="polite"></div>

  <%
    function reviewHref(targetStatus, targetPage, targetKind) {
      var params = [];
      if (targetStatus && targetStatus !== 'pending') params.push('status=' + encodeURIComponent(targetStatus));
      var effectiveKind = targetKind || reviewKind || 'all';
      if (effectiveKind && effectiveKind !== 'all') params.push('kind=' + encodeURIComponent(effectiveKind));
      if (targetPage && targetPage > 1) params.push('page=' + encodeURIComponent(targetPage));
      return '/admin/knowledge/review-extractions' + (params.length ? '?' + params.join('&') : '');
    }

    var summaryTail = '';
    if (approvalStatus === 'pending') {
      summaryTail = 'Approval makes pending evidence eligible to appear in the visible knowledge graph.';
    } else if (approvalStatus === 'approved') {
      summaryTail = 'Already-visible evidence can still be revisited or removed here.';
    } else if (approvalStatus === 'rejected') {
      summaryTail = 'Rejected evidence stays hidden from the graph until it is approved.';
    } else {
      summaryTail = 'Use the status tabs to narrow the queue when you are triaging specific states.';
    }
  %>

  <div class="knowledge-toolbar review-extractions-toolbar">
    <div class="filter-tabs review-status-tabs" role="tablist" aria-label="Extraction review status">
      <a href="<%= reviewHref('pending', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'pending' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'pending' ? 'true' : 'false' %>" data-review-status-tab data-status="pending">
        Pending <span class="filter-count review-status-count" data-review-status-count data-status="pending"><%= statusCounts.pending || 0 %></span>
      </a>
      <a href="<%= reviewHref('approved', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'approved' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'approved' ? 'true' : 'false' %>" data-review-status-tab data-status="approved">
        Approved <span class="filter-count review-status-count" data-review-status-count data-status="approved"><%= statusCounts.approved || 0 %></span>
      </a>
      <a href="<%= reviewHref('rejected', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'rejected' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'rejected' ? 'true' : 'false' %>" data-review-status-tab data-status="rejected">
        Rejected <span class="filter-count review-status-count" data-review-status-count data-status="rejected"><%= statusCounts.rejected || 0 %></span>
      </a>
      <a href="<%= reviewHref('all', 1, reviewKind) %>" class="filter-tab review-status-tab <%= approvalStatus === 'all' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'all' ? 'true' : 'false' %>" data-review-status-tab data-status="all">
        All <span class="filter-count review-status-count" data-review-status-count data-status="all"><%= totalCount %></span>
      </a>
    </div>
    <div class="knowledge-toolbar-actions">
      <form method="GET" action="/admin/knowledge/review-extractions" class="admin-search-form review-filter-form">
        <% if (approvalStatus && approvalStatus !== 'pending') { %>
          <input type="hidden" name="status" value="<%= approvalStatus %>">
        <% } %>
        <label for="review_kind_filter" class="review-filter-label">Filter type</label>
        <select id="review_kind_filter" name="kind" class="review-filter-select" data-submit-on-change="1" aria-label="Filter review queue by evidence or entity type">
          <% (reviewKindOptions || []).forEach(function(option) { %>
            <option value="<%= option.value %>" <%= option.value === (reviewKind || 'all') ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
        <% if (typeof sort !== 'undefined' && sort) { %>
          <input type="hidden" name="sort" value="<%= sort %>">
        <% } %>
        <noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
      </form>
      <form method="GET" action="/admin/knowledge/review-extractions" class="admin-search-form review-filter-form">
        <% if (approvalStatus && approvalStatus !== 'pending') { %>
          <input type="hidden" name="status" value="<%= approvalStatus %>">
        <% } %>
        <% if (reviewKind && reviewKind !== 'all') { %>
          <input type="hidden" name="kind" value="<%= reviewKind %>">
        <% } %>
        <label for="review-sort" class="review-filter-label">Sort</label>
        <select name="sort" id="review-sort" class="review-filter-select" data-submit-on-change="1" aria-label="Sort review queue">
          <% (sortOptions || []).forEach(function(option) { %>
            <option value="<%= option.value %>" <%= option.value === sort ? 'selected' : '' %>><%= option.label %></option>
          <% }) %>
        </select>
        <noscript><button type="submit" class="btn-secondary btn-sm">Apply</button></noscript>
      </form>
      <a href="/admin/knowledge/entities/merge" class="btn-secondary btn-sm">Merge Entities</a>
    </div>
  </div>

  <section class="settings-section review-extractions-panel" data-review-panel data-active-status="<%= approvalStatus %>" data-total-count="<%= totalCount %>">
    <div class="review-extractions-panel-header">
      <div>
        <p class="kg-panel-eyebrow">Queue</p>
        <h2>
          <% if (approvalStatus === 'approved') { %>
            Approved evidence
          <% } else if (approvalStatus === 'rejected') { %>
            Rejected evidence
          <% } else if (approvalStatus === 'all') { %>
            All evidence states
          <% } else { %>
            Pending review
          <% } %>
        </h2>
        <p class="subtitle">
          Showing <span data-review-visible-count><%= reviewItems.length %></span> of <span data-review-total-count><%= totalCount %></span> citation<span data-review-total-plural><%= totalCount === 1 ? '' : 's' %></span>.
          <% if (reviewKind && reviewKind !== 'all') { %>
            Filtered by <strong><%= reviewKindLabel %></strong>.
          <% } %>
          <span data-review-summary-tail><%= summaryTail %></span>
        </p>
      </div>
    </div>

    <% if (reviewItems.length === 0) { %>
      <div class="empty-state">
        <% if (approvalStatus === 'pending') { %>
          <p>No extraction evidence is waiting for review right now<%= reviewKind && reviewKind !== 'all' ? ' for this filter' : '' %>.</p>
          <p class="muted">New low-confidence extractions will appear here automatically, while high-confidence evidence is auto-approved.</p>
          <p><a href="/admin/knowledge">Return to Knowledge overview</a> or <a href="/admin/jobs?type=extraction">check extraction jobs</a>.</p>
        <% } else if (approvalStatus === 'approved') { %>
          <p>No approved evidence is available in this view.</p>
          <p class="muted">Approved citations become visible in the knowledge graph and can still be managed from entity pages.</p>
        <% } else if (approvalStatus === 'rejected') { %>
          <p>No rejected evidence is recorded right now.</p>
          <p class="muted">Rejected citations remain hidden from the graph until they are manually approved.</p>
        <% } else { %>
          <p>No extraction evidence has been recorded yet.</p>
          <p class="muted">Run knowledge extraction from the Knowledge overview to begin building the review queue.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="review-extraction-list">
        <% reviewItems.forEach(function(item) { %>
          <article class="review-extraction-card" data-review-card data-citation-id="<%= item.id %>" data-citation-status="<%= item.approval_status || 'pending' %>" data-kind="<%= item.kind %>">
            <div class="review-extraction-card-header">
              <div class="review-extraction-title-group">
                <p class="kg-panel-eyebrow"><%= item.kind_label %></p>
                <h3><%= item.claim_title %></h3>
                <p class="review-extraction-context"><strong>Claim</strong> <%= item.claim_explainer %></p>
                <% if (item.claim_detail) { %>
                  <p class="review-extraction-detail"><%= item.claim_detail %></p>
                <% } %>
                <% if (item.kind === 'relationship') { %>
                  <%- include('../partials/voice-badge', {
                    relationship: item,
                    attributionEntity: (item.voice_role === 'speaker' && item.expressed_by_entity)
                      || (item.voice_role === 'described_subject' && item.described_subject_entity)
                      || null
                  }) %>
                <% } %>
                <% if (item.claim_meta) { %>
                  <p class="review-extraction-meta-line"><%= item.claim_meta %></p>
                <% } %>
              </div>
              <div class="review-extraction-summary">
                <span class="status-badge <%= item.status_class %>"><%= item.status_label %></span>
                <% if (item.confidence_label) { %>
                  <span class="review-confidence"><%= item.confidence_label %></span>
                <% } %>
                <% if (item.method_label) { %>
                  <span class="review-method-note"><%= item.method_label %></span>
                <% } %>
                <% if (item.open_passage_href) { %>
                  <a
                    href="<%= item.open_passage_href %>"
                    class="btn-secondary btn-sm review-preview-trigger"
                    data-review-preview-trigger="1"
                    data-review-preview-url="<%= item.preview_passage_href %>"
                    data-review-preview-title="<%= item.claim_title %>"
                    data-review-preview-document="<%= item.document_title || ('Document #' + item.document_id) %>"><%= item.open_passage_label %></a>
                <% } %>
              </div>
            </div>

            <div class="review-extraction-evidence">
              <div class="review-extraction-section-label">Evidence to review</div>
              <% if (item.evidence_blocks && item.evidence_blocks.length) { %>
                <% item.evidence_blocks.forEach(function(block) { %>
                  <div class="review-evidence-block">
                    <p class="review-evidence-block-label"><%= block.label %></p>
                    <blockquote class="graph-citation-quote"><%= block.text %></blockquote>
                  </div>
                <% }) %>
              <% } else { %>
                <p class="graph-empty-state graph-empty-state--compact">No passage text was captured for this citation.</p>
              <% } %>
              <% if (item.review_notes && item.review_notes.length) { %>
                <% item.review_notes.forEach(function(note) { %>
                  <p class="review-evidence-note <%= note.tone ? ('review-evidence-note--' + note.tone) : '' %>"><%= note.text %></p>
                <% }) %>
              <% } %>
            </div>

            <div class="review-extraction-footer">
              <div class="review-extraction-meta">
                <span class="review-extraction-section-label">Provenance</span>
                <% if (item.document_id) { %>
                  <span class="review-meta-item">Document <%= item.document_title || ('#' + item.document_id) %></span>
                <% } %>
                <span class="review-meta-item">Transcript #<%= item.transcript_id %></span>
                <% if (item.created_at) { %>
                  <span class="review-meta-item">Queued <%= new Date(item.created_at).toLocaleString() %></span>
                <% } %>
                <% if (item.method_label) { %>
                  <span class="review-meta-item"><%= item.method_label %></span>
                <% } %>
                <% if (item.confidence_label) { %>
                  <span class="review-meta-item"><%= item.confidence_label %></span>
                <% } %>
              </div>

              <div class="review-extraction-actions" data-review-action-rail>
                <div class="review-extraction-decisions">
                  <% if (item.approval_status !== 'approved') { %>
                    <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/confirm" class="inline-form" data-review-action-form="1" data-review-action="approve">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= approvalStatus %>">
                      <input type="hidden" name="kind" value="<%= reviewKind || 'all' %>">
                      <input type="hidden" name="page" value="<%= currentPage %>">
                      <button type="submit" class="btn-primary btn-sm" data-review-action-button>Approve</button>
                    </form>
                  <% } %>
                  <% if (item.approval_status !== 'rejected') { %>
                    <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/reject" class="inline-form" data-review-confirm-message="Reject this evidence claim?" data-review-action-form="1" data-review-action="reject">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= approvalStatus %>">
                      <input type="hidden" name="kind" value="<%= reviewKind || 'all' %>">
                      <input type="hidden" name="page" value="<%= currentPage %>">
                      <button type="submit" class="btn-secondary btn-sm" data-review-action-button>Reject</button>
                    </form>
                  <% } %>
                </div>
                <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/delete" class="inline-form" data-review-confirm-message="Delete this evidence permanently?" data-review-action-form="1" data-review-action="delete">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= approvalStatus %>">
                  <input type="hidden" name="kind" value="<%= reviewKind || 'all' %>">
                  <input type="hidden" name="page" value="<%= currentPage %>">
                  <button type="submit" class="btn-danger btn-sm" data-review-action-button>Delete evidence</button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
      <p class="graph-empty-state graph-empty-state--compact review-empty-inline is-hidden" data-review-inline-empty>
        No more citations remain in this page view. Use status tabs or pagination to continue triage.
      </p>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="<%= reviewHref(approvalStatus, currentPage - 1, reviewKind) %>" class="pagination-btn">&lsaquo; Prev</a>
          <% } else { %>
            <span class="pagination-btn pagination-btn--disabled">&lsaquo; Prev</span>
          <% } %>
          <span class="pagination-info">
            Page <%= currentPage %> of <%= totalPages %>
            <span class="muted">(<%= totalCount %> citations)</span>
          </span>
          <% if (currentPage < totalPages) { %>
            <a href="<%= reviewHref(approvalStatus, currentPage + 1, reviewKind) %>" class="pagination-btn">Next &rsaquo;</a>
          <% } else { %>
            <span class="pagination-btn pagination-btn--disabled">Next &rsaquo;</span>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </section>
</div>

<div class="modal-overlay is-hidden" id="review-preview-modal" role="dialog" aria-modal="true" aria-labelledby="review-preview-modal-title">
  <div class="modal-dialog review-preview-modal-dialog">
    <div class="modal-header">
      <div class="review-preview-modal-heading">
        <p class="kg-panel-eyebrow">Passage Preview</p>
        <h3 id="review-preview-modal-title">Document preview</h3>
      </div>
      <button type="button" class="modal-close" id="review-preview-modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body review-preview-modal-body">
      <div class="review-preview-meta" id="review-preview-meta"></div>
      <div class="review-preview-layout">
        <section class="review-preview-panel">
          <div class="review-preview-panel-header">
            <h4>Original document</h4>
            <span class="review-preview-page-label" id="review-preview-page-label"></span>
          </div>
          <div class="review-preview-image-wrap" id="review-preview-image-wrap">
            <p class="muted">Loading image preview…</p>
          </div>
        </section>
        <section class="review-preview-panel">
          <div class="review-preview-panel-header">
            <h4>Transcript context</h4>
            <span class="review-preview-transcript-label" id="review-preview-transcript-label"></span>
          </div>
          <div class="review-preview-transcript" id="review-preview-transcript">
            <p class="muted">Loading transcript preview…</p>
          </div>
          <p class="review-preview-passage-note" id="review-preview-passage-note"></p>
        </section>
      </div>
      <div class="review-preview-footer">
        <a href="#" class="btn-secondary btn-sm" id="review-preview-document-link" target="_blank" rel="noopener">Open full document</a>
      </div>
    </div>
  </div>
</div>

<script src="/js/review-extractions.js"></script>
<%- include('../partials/footer') %>
