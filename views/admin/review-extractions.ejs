<%- include('../partials/header', { pageTitle: 'Review Extractions', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Review Extractions</h1>
    <p class="subtitle">Approve, reject, or remove extracted evidence before it becomes visible in the knowledge graph.</p>
    <% if (graphNotice) { %><p class="export-context-note"><%= graphNotice %></p><% } %>
  </div>

  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'review-extractions' }) %>

  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (typeof confirmed !== 'undefined' && confirmed) { %><div class="alert alert-success">Citation approved.</div><% } %>
  <% if (typeof rejected !== 'undefined' && rejected) { %><div class="alert alert-success">Citation rejected.</div><% } %>
  <% if (typeof deleted !== 'undefined' && deleted) { %><div class="alert alert-success">Citation deleted.</div><% } %>

  <%
    function reviewHref(targetStatus, targetPage) {
      var params = [];
      if (targetStatus && targetStatus !== 'pending') params.push('status=' + encodeURIComponent(targetStatus));
      if (targetPage && targetPage > 1) params.push('page=' + encodeURIComponent(targetPage));
      return '/admin/knowledge/review-extractions' + (params.length ? '?' + params.join('&') : '');
    }
  %>

  <div class="knowledge-toolbar review-extractions-toolbar">
    <div class="review-status-tabs" role="tablist" aria-label="Extraction review status">
      <a href="<%= reviewHref('pending', 1) %>" class="review-status-tab <%= approvalStatus === 'pending' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'pending' ? 'true' : 'false' %>">
        Pending <span class="review-status-count"><%= statusCounts.pending || 0 %></span>
      </a>
      <a href="<%= reviewHref('approved', 1) %>" class="review-status-tab <%= approvalStatus === 'approved' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'approved' ? 'true' : 'false' %>">
        Approved <span class="review-status-count"><%= statusCounts.approved || 0 %></span>
      </a>
      <a href="<%= reviewHref('rejected', 1) %>" class="review-status-tab <%= approvalStatus === 'rejected' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'rejected' ? 'true' : 'false' %>">
        Rejected <span class="review-status-count"><%= statusCounts.rejected || 0 %></span>
      </a>
      <a href="<%= reviewHref('all', 1) %>" class="review-status-tab <%= approvalStatus === 'all' ? 'active' : '' %>" aria-selected="<%= approvalStatus === 'all' ? 'true' : 'false' %>">
        All <span class="review-status-count"><%= totalCount %></span>
      </a>
    </div>
    <div class="knowledge-toolbar-actions">
      <a href="/admin/knowledge/entities/merge" class="btn-secondary btn-sm">Merge Entities</a>
    </div>
  </div>

  <section class="settings-section review-extractions-panel">
    <div class="review-extractions-panel-header">
      <div>
        <p class="kg-panel-eyebrow">Queue</p>
        <h2>
          <% if (approvalStatus === 'approved') { %>
            Approved evidence
          <% } else if (approvalStatus === 'rejected') { %>
            Rejected evidence
          <% } else if (approvalStatus === 'all') { %>
            All evidence states
          <% } else { %>
            Pending review
          <% } %>
        </h2>
        <p class="subtitle">
          Showing <%= reviewItems.length %> of <%= totalCount %> citation<%= totalCount === 1 ? '' : 's' %>.
          <% if (approvalStatus === 'pending') { %>
            Approval makes pending evidence eligible to appear in the visible knowledge graph.
          <% } else if (approvalStatus === 'approved') { %>
            Already-visible evidence can still be revisited or removed here.
          <% } else if (approvalStatus === 'rejected') { %>
            Rejected evidence stays hidden from the graph until it is approved.
          <% } else { %>
            Use the status tabs to narrow the queue when you are triaging specific states.
          <% } %>
        </p>
      </div>
    </div>

    <% if (reviewItems.length === 0) { %>
      <div class="empty-state">
        <% if (approvalStatus === 'pending') { %>
          <p>No extraction evidence is waiting for review right now.</p>
          <p class="muted">New low-confidence extractions will appear here automatically, while high-confidence evidence is auto-approved.</p>
          <p><a href="/admin/knowledge">Return to Knowledge overview</a> or <a href="/admin/jobs?type=extraction">check extraction jobs</a>.</p>
        <% } else if (approvalStatus === 'approved') { %>
          <p>No approved evidence is available in this view.</p>
          <p class="muted">Approved citations become visible in the knowledge graph and can still be managed from entity pages.</p>
        <% } else if (approvalStatus === 'rejected') { %>
          <p>No rejected evidence is recorded right now.</p>
          <p class="muted">Rejected citations remain hidden from the graph until they are manually approved.</p>
        <% } else { %>
          <p>No extraction evidence has been recorded yet.</p>
          <p class="muted">Run knowledge extraction from the Knowledge overview to begin building the review queue.</p>
        <% } %>
      </div>
    <% } else { %>
      <div class="review-extraction-list">
        <% reviewItems.forEach(function(item) { %>
          <article class="review-extraction-card">
            <div class="review-extraction-card-header">
              <div class="review-extraction-title-group">
                <p class="kg-panel-eyebrow"><%= item.kind_label %></p>
                <h3><%= item.claim_title %></h3>
                <p class="review-extraction-context"><strong>Claim</strong> <%= item.claim_explainer %></p>
                <% if (item.claim_detail) { %>
                  <p class="review-extraction-detail"><%= item.claim_detail %></p>
                <% } %>
                <% if (item.claim_meta) { %>
                  <p class="review-extraction-meta-line"><%= item.claim_meta %></p>
                <% } %>
              </div>
              <div class="review-extraction-summary">
                <span class="status-badge <%= item.status_class %>"><%= item.status_label %></span>
                <% if (item.confidence_label) { %>
                  <span class="review-confidence"><%= item.confidence_label %></span>
                <% } %>
                <% if (item.method_label) { %>
                  <span class="review-method-note"><%= item.method_label %></span>
                <% } %>
                <% if (item.open_passage_href) { %>
                  <a href="<%= item.open_passage_href %>" class="btn-secondary btn-sm"><%= item.open_passage_label %></a>
                <% } %>
              </div>
            </div>

            <div class="review-extraction-evidence">
              <div class="review-extraction-section-label">Evidence</div>
              <% if (item.passage_text) { %>
                <blockquote class="graph-citation-quote"><%= item.passage_text %></blockquote>
              <% } else { %>
                <p class="graph-empty-state graph-empty-state--compact">No passage text was captured for this citation.</p>
              <% } %>
            </div>

            <div class="review-extraction-footer">
              <div class="review-extraction-meta">
                <span class="review-extraction-section-label">Provenance</span>
                <% if (item.document_id) { %>
                  <span class="review-meta-item">Document <%= item.document_title || ('#' + item.document_id) %></span>
                <% } %>
                <span class="review-meta-item">Transcript #<%= item.transcript_id %></span>
                <% if (item.created_at) { %>
                  <span class="review-meta-item">Queued <%= new Date(item.created_at).toLocaleString() %></span>
                <% } %>
                <% if (item.method_label) { %>
                  <span class="review-meta-item"><%= item.method_label %></span>
                <% } %>
                <% if (item.confidence_label) { %>
                  <span class="review-meta-item"><%= item.confidence_label %></span>
                <% } %>
              </div>

              <div class="review-extraction-actions">
                <div class="review-extraction-decisions">
                  <% if (item.approval_status !== 'approved') { %>
                    <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/confirm" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= approvalStatus %>">
                      <input type="hidden" name="page" value="<%= currentPage %>">
                      <button type="submit" class="btn-primary btn-sm">Approve</button>
                    </form>
                  <% } %>
                  <% if (item.approval_status !== 'rejected') { %>
                    <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/reject" class="inline-form" data-confirm-message="Reject this evidence claim?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="status" value="<%= approvalStatus %>">
                      <input type="hidden" name="page" value="<%= currentPage %>">
                      <button type="submit" class="btn-secondary btn-sm">Reject</button>
                    </form>
                  <% } %>
                </div>
                <form method="POST" action="/admin/knowledge/review-extractions/<%= item.id %>/delete" class="inline-form" data-confirm-message="Delete this evidence permanently?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="status" value="<%= approvalStatus %>">
                  <input type="hidden" name="page" value="<%= currentPage %>">
                  <button type="submit" class="btn-danger btn-sm">Delete evidence</button>
                </form>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %>
            <a href="<%= reviewHref(approvalStatus, currentPage - 1) %>" class="pagination-btn">&lsaquo; Prev</a>
          <% } else { %>
            <span class="pagination-btn pagination-btn--disabled">&lsaquo; Prev</span>
          <% } %>
          <span class="pagination-info">
            Page <%= currentPage %> of <%= totalPages %>
            <span class="muted">(<%= totalCount %> citations)</span>
          </span>
          <% if (currentPage < totalPages) { %>
            <a href="<%= reviewHref(approvalStatus, currentPage + 1) %>" class="pagination-btn">Next &rsaquo;</a>
          <% } else { %>
            <span class="pagination-btn pagination-btn--disabled">Next &rsaquo;</span>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
