<%- include('../partials/header', { pageTitle: 'Admin Dashboard', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Dashboard</h1>
    <p class="subtitle">Jump into any part of the admin workspace from here.</p>
  </div>

  <div class="admin-stats">
    <div class="stat-card">
      <div class="stat-value"><%= docCount %></div>
      <div class="stat-label">Documents</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= collectionCount %></div>
      <div class="stat-label">Collections</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= userCount %></div>
      <div class="stat-label">Users</div>
    </div>
    <% if (pendingCount > 0) { %>
      <a href="/admin/users" class="stat-card stat-card-alert">
        <div class="stat-value"><%= pendingCount %></div>
        <div class="stat-label">Pending Approval</div>
      </a>
    <% } %>
  </div>

  <div class="admin-actions">
    <h2>Admin Sections</h2>
    <div class="action-cards">
      <a href="/admin/import" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        </div>
        <div class="action-title">Import Document</div>
        <div class="action-description">Upload and transcribe a new historical document using AI</div>
      </a>
      <a href="/admin/documents" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="action-title">Documents</div>
        <div class="action-description">View, manage, and delete imported documents</div>
      </a>
      <a href="/admin/collections" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="action-title">Collections</div>
        <div class="action-description">Create and manage document collections</div>
      </a>
      <a href="/admin/users" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="action-title">Users</div>
        <div class="action-description">Approve accounts, set roles, and manage collection access</div>
      </a>
      <a href="/admin/jobs" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 15"/><path d="M7 3 4 6"/><path d="M17 3 20 6"/></svg>
        </div>
        <div class="action-title">Jobs</div>
        <div class="action-description">Monitor background imports and transcription runs</div>
      </a>
      <a href="/admin/logging" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12"/><path d="M8 10h8"/><path d="M8 14h8"/><path d="M8 18h5"/></svg>
        </div>
        <div class="action-title">Logging</div>
        <div class="action-description">Configure log levels, monitor slow requests, and review operational events</div>
      </a>
      <a href="/admin/knowledge" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M8 12h6"/><path d="M16.5 7.5 8 11"/><path d="M16.5 16.5 8 13"/></svg>
        </div>
        <div class="action-title">Knowledge</div>
        <div class="action-description">Re-run graph extraction, inspect entities, and review knowledge evidence</div>
      </a>
      <a href="/admin/analytics-settings" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V5"/><path d="M10 19V10"/><path d="M16 19V7"/><path d="M22 19V13"/></svg>
        </div>
        <div class="action-title">Analytics</div>
        <div class="action-description">Configure analytics schedules and run collection analytics on demand</div>
      </a>
      <a href="/admin/llm-settings" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </div>
        <div class="action-title">LLM Settings</div>
        <div class="action-description">Configure AI providers, models, and API keys</div>
      </a>
      <a href="/admin/application-settings" class="action-card">
        <div class="action-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V5.8A1.8 1.8 0 0 1 5.8 4H18"/><path d="M18 20H7.2A2.2 2.2 0 0 1 5 17.8 2.2 2.2 0 0 1 7.2 15.6H18Z"/><path d="M9 8h6"/><path d="M9 11h4"/></svg>
        </div>
        <div class="action-title">Application Settings</div>
        <div class="action-description">Set the site name, header logo, and public policy pages</div>
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
