<%- include('../partials/header', { pageTitle: 'Generic Authority Terms', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authority-generic-terms' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Authorities', href: '/admin/knowledge/authorities' },
    { label: 'Generic terms' }
  ] }) %>

  <div class="admin-header entity-header">
    <h1>Generic Authority Terms</h1>
    <p class="entity-meta">
      <span>Curate bare entity names that should not be linked to conceptual authority records.</span>
    </p>
  </div>

  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <% if (saved) { %>
    <div class="alert alert-success">Generic authority terms saved.</div>
  <% } %>

  <div class="filter-tabs">
    <a href="<%= genericTermsPath({ status: 'suggested' }) %>" class="filter-tab <%= status === 'suggested' ? 'active' : '' %>">Suggested</a>
    <a href="<%= genericTermsPath({ status: 'active' }) %>" class="filter-tab <%= status === 'active' ? 'active' : '' %>">Active</a>
    <a href="<%= genericTermsPath({ status: 'disabled' }) %>" class="filter-tab <%= status === 'disabled' ? 'active' : '' %>">Disabled</a>
    <a href="<%= genericTermsPath({ status: 'rejected' }) %>" class="filter-tab <%= status === 'rejected' ? 'active' : '' %>">Rejected</a>
    <a href="<%= genericTermsPath({ status: 'all' }) %>" class="filter-tab <%= status === 'all' ? 'active' : '' %>">All</a>
  </div>

  <div class="knowledge-admin-grid authority-generic-controls">
    <section class="knowledge-task-card">
      <h2>Add Active Term</h2>
      <p class="muted">Use this for bare labels that should suppress exact-name authority suggestions as soon as they are saved.</p>
      <form method="POST" action="/admin/knowledge/authorities/generic-terms" class="edit-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="edit-field">
          <label for="generic-term">Term</label>
          <input id="generic-term" name="term" type="text" placeholder="High School" required>
        </div>
        <div class="edit-field">
          <label for="generic-entity-type">Entity type</label>
          <select id="generic-entity-type" name="entity_type">
            <option value="">All types</option>
            <% ['person', 'place', 'event', 'organization', 'topic', 'artifact', 'claim', 'role'].forEach(function(type) { %>
              <option value="<%= type %>"><%= type %></option>
            <% }) %>
          </select>
        </div>
        <div class="edit-field">
          <label for="generic-notes">Notes</label>
          <textarea id="generic-notes" name="notes" rows="2" placeholder="Why this bare label should be treated as generic"></textarea>
        </div>
        <div class="edit-actions">
          <button type="submit" class="btn-primary btn-sm">Add Active Term</button>
        </div>
      </form>
    </section>

    <section class="knowledge-task-card">
      <h2>Suggestion Rules</h2>
      <p class="muted">Control when repeated review signals are allowed to create suggested terms for curator approval.</p>
      <form method="POST" action="/admin/knowledge/authorities/generic-terms/settings" class="edit-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="status" value="<%= status %>">
        <label class="checkbox-label authority-generic-learning-toggle">
          <input type="checkbox" name="authority_generic_learning_enabled" <%= settings.authority_generic_learning_enabled !== '0' ? 'checked' : '' %>>
          <span>Learn suggested generic terms from extraction and review patterns</span>
        </label>
        <div class="edit-field">
          <label for="generic-min-rejections">Minimum rejected links</label>
          <input id="generic-min-rejections" name="authority_generic_learning_min_rejections" type="number" min="1" value="<%= settings.authority_generic_learning_min_rejections || '3' %>">
        </div>
        <div class="edit-field">
          <label for="generic-min-seen">Minimum seen count</label>
          <input id="generic-min-seen" name="authority_generic_learning_min_seen" type="number" min="1" value="<%= settings.authority_generic_learning_min_seen || '5' %>">
        </div>
        <div class="edit-actions">
          <button type="submit" class="btn-secondary btn-sm">Save Learning Rules</button>
        </div>
      </form>
    </section>
  </div>

  <section class="settings-section knowledge-overview-section">
    <div class="knowledge-overview-header">
      <div>
        <p class="knowledge-section-label">Terms</p>
        <h2><%= status === 'all' ? 'All' : status.charAt(0).toUpperCase() + status.slice(1) %> Terms</h2>
      </div>
    </div>

    <% if (!terms.length) { %>
      <div class="empty-state">
        <p>No generic terms were found for this filter. Add an active term manually, or review learned suggestions when they appear.</p>
      </div>
    <% } else { %>
      <div class="workflows-table-wrap">
        <table class="workflows-table">
          <thead>
            <tr>
              <th scope="col">Term</th>
              <th scope="col">Type</th>
              <th scope="col">Status</th>
              <th scope="col">Source</th>
              <th scope="col">Signals</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% terms.forEach(function(term) { %>
              <tr>
                <td>
                  <strong><%= term.term %></strong>
                  <% if (term.notes) { %>
                    <div class="muted"><%= term.notes %></div>
                  <% } %>
                </td>
                <td><%= term.entity_type || 'All types' %></td>
                <td><span class="status-badge <%= term.status === 'active' ? 'status-done' : term.status === 'rejected' ? 'status-failed' : term.status === 'disabled' ? 'status-trace' : 'status-queued' %>"><%= term.status %></span></td>
                <td><%= term.source %></td>
                <td>
                  <span class="muted"><%= term.seen_count || 0 %> seen, <%= term.rejected_link_count || 0 %> rejected, <%= term.approved_link_count || 0 %> approved</span>
                </td>
                <td>
                  <div class="table-actions">
                    <% if (term.status !== 'active') { %>
                      <form method="POST" action="/admin/knowledge/authorities/generic-terms/<%= term.id %>/approve" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="<%= status %>">
                        <button type="submit" class="btn-primary btn-sm">Approve</button>
                      </form>
                    <% } %>
                    <% if (term.status === 'suggested') { %>
                      <form method="POST" action="/admin/knowledge/authorities/generic-terms/<%= term.id %>/reject" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="<%= status %>">
                        <button type="submit" class="btn-secondary btn-sm">Reject</button>
                      </form>
                    <% } %>
                    <% if (term.status === 'active') { %>
                      <form method="POST" action="/admin/knowledge/authorities/generic-terms/<%= term.id %>/disable" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="status" value="<%= status %>">
                        <button type="submit" class="btn-secondary btn-sm">Disable</button>
                      </form>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
