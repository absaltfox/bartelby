<%- include('../partials/header', { pageTitle: 'Merge Authority', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authorities' }) %>

  <%- include('../partials/breadcrumbs', { crumbs: [
    { label: 'Admin', href: '/admin' },
    { label: 'Knowledge', href: '/admin/knowledge' },
    { label: 'Authorities', href: '/admin/knowledge/authorities' },
    { label: sourceAuthority.canonical_name, href: '/admin/knowledge/authorities/' + sourceAuthority.id },
    { label: 'Merge' }
  ] }) %>

  <div class="admin-header entity-header">
    <h1>Merge authority</h1>
    <p class="entity-meta">
      <span class="entity-meta__label">Source</span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span class="entity-type-badge entity-type-<%= sourceAuthority.authority_type %>"><%= sourceAuthority.authority_type %></span>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <a href="/admin/knowledge/authorities/<%= sourceAuthority.id %>"><%= sourceAuthority.canonical_name %></a>
      <span class="entity-meta__sep" aria-hidden="true">·</span>
      <span class="entity-meta__id">id <%= sourceAuthority.id %></span>
    </p>
  </div>

  <% if (errorMessage) { %>
    <div class="flash flash-error"><%= errorMessage %></div>
  <% } %>

  <section class="graph-shell-card knowledge-card">
    <div class="graph-sidebar-header">
      <div class="entity-detail__card-title">
        <p class="kg-panel-eyebrow">Target</p>
        <h2>Choose the authority to keep</h2>
        <p class="entity-detail__section-meta">
          Members, aliases, citations, and relationships from
          <strong><%= sourceAuthority.canonical_name %></strong>
          will be re-parented onto the target. The source authority is
          then deleted. This action cannot be automatically undone.
        </p>
      </div>
    </div>
    <div class="graph-sidebar-body">
      <form
        method="POST"
        action="/admin/knowledge/authorities/<%= sourceAuthority.id %>/merge"
        class="edit-form authority-picker-form"
        data-authority-picker-form
        data-authority-type="<%= sourceAuthority.authority_type %>"
        data-confirm-message="Merge <%= sourceAuthority.canonical_name %> into the selected target? This cannot be undone."
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="target_authority_id" value="" data-authority-id required>

        <div class="edit-field">
          <label for="authority-merge-search">Target authority</label>
          <input
            type="search"
            id="authority-merge-search"
            class="admin-search-input"
            placeholder="Search by canonical name or alias..."
            autocomplete="off"
            spellcheck="false"
            data-authority-search
          >
        </div>

        <div class="knowledge-document-selection" data-authority-selected hidden></div>
        <div class="knowledge-document-results" data-authority-results hidden></div>

        <section class="workspace-danger" aria-labelledby="merge-authority-danger-label">
          <div>
            <p class="workspace-danger-title" id="merge-authority-danger-label">Danger zone</p>
            <p class="workspace-danger-note">
              Merging is irreversible. Once confirmed, the source authority
              cannot be restored.
            </p>
          </div>
          <div>
            <%# Intentional `disabled`: teaches the curator that a target must be chosen. %>
            <%# Per docs/ui-template-standards.md § Hide unavailable actions (Exceptions). %>
            <button type="submit" class="btn-danger" data-authority-picker-submit disabled>Merge authority</button>
          </div>
        </section>
      </form>
    </div>
  </section>
</div>

<script src="/js/authority-picker.js"></script>
<%- include('../partials/footer') %>
