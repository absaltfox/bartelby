<%- include('../partials/header', { pageTitle: 'Authority Suggestions', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authority-suggestions' }) %>

  <div class="admin-header">
    <h1>Authority Suggestions</h1>
    <p class="subtitle">Review medium-confidence authority links before they affect authority-backed graph focus.</p>
  </div>

  <div class="filter-tabs">
    <a href="/admin/knowledge/authorities/suggestions?status=pending" class="filter-tab <%= status === 'pending' ? 'active' : '' %>">Pending</a>
    <a href="/admin/knowledge/authorities/suggestions?status=approved" class="filter-tab <%= status === 'approved' ? 'active' : '' %>">Approved</a>
    <a href="/admin/knowledge/authorities/suggestions?status=rejected" class="filter-tab <%= status === 'rejected' ? 'active' : '' %>">Rejected</a>
    <a href="/admin/knowledge/authorities/suggestions?status=all" class="filter-tab <%= status === 'all' ? 'active' : '' %>">All</a>
  </div>

  <% if (!suggestions.length) { %>
    <div class="empty-state">
      <p>No authority suggestions were found for this filter.</p>
    </div>
  <% } else { %>
    <div class="knowledge-citation-list">
      <% suggestions.forEach(function(suggestion) { %>
        <article class="knowledge-citation-card">
          <div class="knowledge-citation-card-header">
            <div>
              <strong><a href="/admin/knowledge/entities/<%= suggestion.entity_id %>"><%= suggestion.entity_name %></a></strong>
              <div class="graph-muted">
                <span class="entity-type-badge entity-type-<%= suggestion.entity_type %>"><%= suggestion.entity_type %></span>
                <span class="status-badge <%= suggestion.status === 'approved' ? 'status-done' : suggestion.status === 'rejected' ? 'status-failed' : 'status-running' %>"><%= suggestion.status %></span>
                <% if (suggestion.confidence != null) { %>
                  <span>Confidence <%= Math.round(Number(suggestion.confidence) * 100) %>%</span>
                <% } %>
                <% if (suggestion.match_method) { %>
                  <span><%= suggestion.match_method %></span>
                <% } %>
              </div>
            </div>
          </div>
          <p>Suggested authority: <strong><a href="/admin/knowledge/authorities/<%= suggestion.suggested_authority_id %>"><%= suggestion.suggested_authority_name %></a></strong></p>
          <% if (suggestion.status === 'pending') { %>
            <div class="job-actions">
              <form method="POST" action="/admin/knowledge/entities/<%= suggestion.entity_id %>/authority-suggestions/<%= suggestion.id %>/approve" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-primary btn-sm">Approve</button>
              </form>
              <form method="POST" action="/admin/knowledge/entities/<%= suggestion.entity_id %>/authority-suggestions/<%= suggestion.id %>/reject" class="inline-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn-secondary btn-sm">Reject</button>
              </form>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
