<%- include('../partials/header', { pageTitle: 'Authority Suggestions', query: '' }) %>

<div class="admin-page admin-page--workspace workflows-page">
  <%- include('../partials/admin-nav') %>
  <%- include('../partials/knowledge-nav', { activeKnowledgePage: activeKnowledgePage || 'authority-suggestions' }) %>

  <div class="admin-header">
    <h1>Authority Suggestions</h1>
    <p class="subtitle">Review medium-confidence authority links before they affect authority-backed graph focus.</p>
  </div>

  <div class="filter-tabs">
    <a href="<%= suggestionsPath({ status: 'pending' }) %>" class="filter-tab <%= status === 'pending' && matchMethodFilter.length === 0 ? 'active' : '' %>">Pending</a>
    <a href="<%= suggestionsPath({ status: 'approved' }) %>" class="filter-tab <%= status === 'approved' ? 'active' : '' %>">Approved</a>
    <a href="<%= suggestionsPath({ status: 'rejected' }) %>" class="filter-tab <%= status === 'rejected' ? 'active' : '' %>">Rejected</a>
    <a href="<%= suggestionsPath({ status: 'all' }) %>" class="filter-tab <%= status === 'all' ? 'active' : '' %>">All</a>
  </div>

  <% if (status === 'pending') { %>
    <div class="filter-chips">
      <% knownMatchMethods.forEach(function(method) { %>
        <% var isActive = matchMethodFilter.indexOf(method) !== -1; %>
        <% var next = isActive
          ? matchMethodFilter.filter(function(m) { return m !== method; })
          : matchMethodFilter.concat(method); %>
        <a href="<%= suggestionsPath({ status: 'pending', matchMethod: next.length > 0 ? next.join(',') : null }) %>"
           class="filter-tab <%= isActive ? 'active' : '' %>">
          <%= method %>
        </a>
      <% }); %>
      <% if (matchMethodFilter.length > 0) { %>
        <a href="<%= suggestionsPath({ status: 'pending' }) %>" class="filter-tab">clear</a>
      <% } %>
    </div>
  <% } %>

  <% if (status === 'pending') { %>
    <div class="bulk-toolbar bulk-toolbar--sticky suggestions-bulk-controls authority-suggestion-bulk-bar">
      <label class="bulk-toolbar-select-all suggestions-select-all authority-suggestion-select-all">
        <input type="checkbox" id="suggestions-select-all">
        <span>Select all on page</span>
      </label>
      <% if (matchMethodFilter.length === 0) { %>
        <button type="button" id="suggestions-select-exact" class="btn-secondary btn-sm">Select exact names on page</button>
      <% } %>
      <div id="suggestions-bulk-actions" class="bulk-toolbar-actions bulk-actions is-hidden">
        <span id="suggestions-bulk-count" class="bulk-toolbar-count">0 selected</span>
        <button type="button" id="suggestions-bulk-approve" class="btn-primary btn-sm">Approve selected</button>
        <button type="button" id="suggestions-bulk-reject"  class="btn-secondary btn-sm">Reject selected</button>
        <button type="button" id="suggestions-bulk-clear"   class="btn-link btn-sm">Clear</button>
      </div>
    </div>
  <% } %>

  <div id="suggestions-list" class="knowledge-citation-list">
    <%
      // U3.1/U3.4: when decisionUnits is provided (pending view), iterate it
      // to render disambiguation groups + single-suggestion cards together.
      // Non-pending views fall back to the flat suggestions array.
      // Per docs/reviews/2026-05-31-entity-extraction-historian-lens.md U3.1, U3.4.
      const useDecisionUnits = Array.isArray(decisionUnits) && decisionUnits.length > 0;
      const disambiguationGroupCount = useDecisionUnits
        ? decisionUnits.filter(u => u.type === 'group').length
        : 0;
    %>
    <% if (!suggestions.length && !useDecisionUnits) { %>
      <div class="empty-state" data-empty-state>
        <p>No authority suggestions were found for this filter.</p>
      </div>
    <% } %>

    <%
      // Task 9: full disambiguation card UI.
      // Per docs/reviews/2026-05-31-entity-extraction-historian-lens.md U3.2.
      //
      // For 'single' units, use the decorated suggestion from the displaySuggestions
      // array (passed as `suggestions`), which has source_context_pending, labels, etc.
      // Build a lookup by id so the single branch can use the decorated version.
      const singleDecoratedById = {};
      (suggestions || []).forEach(function(s) { singleDecoratedById[s.id] = s; });
    %>
    <% if (useDecisionUnits) { %>
      <% decisionUnits.forEach(function(unit) { %>
        <% if (unit.type === 'group') { %>
          <article class="knowledge-citation-card authority-suggestion-card authority-disambiguation-group disambiguation-card"
                   data-entity-id="<%= unit.entityId %>"
                   data-disambiguation-group="1">
            <div class="authority-suggestion-card-header">
              <div class="authority-suggestion-title-group">
                <span class="authority-suggestion-kicker">Disambiguation required</span>
                <h2><a href="/admin/knowledge/entities/<%= unit.entityId %>"><%= unit.entity.canonical_name %></a></h2>
                <div class="authority-suggestion-meta">
                  <span class="entity-type-badge entity-type-<%= unit.entity.entity_type %>"><%= unit.entity.entity_type %></span>
                  <span class="status-badge status-running">pending</span>
                  <span class="authority-suggestion-meta-note"><%= unit.candidates.length %> candidate authorities</span>
                </div>
              </div>
            </div>
            <div class="authority-suggestion-context">
              <form class="disambiguation-form">
                <% unit.candidates.forEach(function(candidate, idx) { %>
                  <label class="disambiguation-option">
                    <input type="radio" name="authorityId-<%= unit.entityId %>" value="<%= candidate.suggested_authority_id %>" <%= idx === 0 ? 'checked' : '' %> />
                    <span class="candidate-name"><%= candidate.suggested_authority_name %></span>
                    <span class="muted">confidence <%= (candidate.confidence != null ? candidate.confidence : 0).toFixed(3) %> via <%= candidate.match_method %></span>
                  </label>
                <% }) %>
                <div class="disambiguation-actions authority-suggestion-card-footer">
                  <button type="button" class="btn-primary btn-sm disambiguation-approve-btn">Approve selected (cascade-rejects siblings)</button>
                  <button type="button" class="btn-secondary btn-sm disambiguation-new-authority-btn">Reject all + create new authority</button>
                  <span class="inline-error" hidden></span>
                </div>
              </form>
            </div>
          </article>
        <% } else if (unit.type === 'single') { %>
          <%
            // Re-use the single-suggestion card markup inline (inlined rather than
            // extracted to a partial because this is the only surface rendering it
            // server-side; the JS renderCard() function serves load-more appends).
            // Use the decorated version from the suggestions array (has source_context_pending,
            // confidence_label, match_method_label, etc.) to match the non-grouped rendering path.
            var suggestion = singleDecoratedById[unit.suggestion.id] || unit.suggestion;
          %>
          <article class="knowledge-citation-card authority-suggestion-card"
                   data-suggestion-id="<%= suggestion.id %>"
                   data-entity-id="<%= suggestion.entity_id %>"
                   data-exact-name-match="<%= suggestion.exact_name_match ? '1' : '0' %>"
                   data-context-pending="<%= suggestion.source_context_pending ? '1' : '0' %>">
            <div class="authority-suggestion-card-header authority-suggestion-card-header--selectable">
              <input type="checkbox" class="suggestion-cb authority-suggestion-checkbox" value="<%= suggestion.id %>">
              <div class="authority-suggestion-title-group">
                <span class="authority-suggestion-kicker">Entity under review</span>
                <h2><a href="/admin/knowledge/entities/<%= suggestion.entity_id %>"><%= suggestion.entity_name %></a></h2>
                <div class="authority-suggestion-meta">
                  <span class="entity-type-badge entity-type-<%= suggestion.entity_type %>"><%= suggestion.entity_type %></span>
                  <span class="status-badge status-running"><%= suggestion.status %></span>
                  <% if (suggestion.confidence_label) { %>
                    <span class="authority-suggestion-meta-note"><%= suggestion.confidence_label %></span>
                  <% } %>
                  <% if (suggestion.exact_name_match) { %>
                    <span class="authority-suggestion-signal">Exact name</span>
                  <% } %>
                  <% if (suggestion.match_method_label) { %>
                    <span class="authority-suggestion-meta-note"><%= suggestion.match_method_label %></span>
                  <% } %>
                  <% if (suggestion.current_authority_label) { %>
                    <span class="authority-suggestion-meta-note"><%= suggestion.current_authority_label %></span>
                  <% } %>
                </div>
              </div>
            </div>

            <div class="authority-suggestion-context">
              <section class="authority-suggestion-context-section" aria-label="Evidence context">
                <span class="authority-suggestion-section-label">Evidence</span>
                <p class="authority-suggestion-document" data-context-document <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                  <% if (suggestion.source_context_pending) { %>
                    <span class="sr-only">Loading document context...</span>
                    <span class="skeleton-stack" aria-hidden="true">
                      <span class="skeleton-line skeleton-line--short"></span>
                    </span>
                  <% } else { %>
                    <%= suggestion.source_document_label %>
                  <% } %>
                </p>
                <div data-context-evidence <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                  <% if (suggestion.source_evidence_excerpt) { %>
                    <blockquote class="authority-suggestion-evidence"><%= suggestion.source_evidence_excerpt %></blockquote>
                  <% } else if (suggestion.source_context_pending) { %>
                    <span class="sr-only">Loading approved citation evidence...</span>
                    <span class="skeleton-stack" aria-hidden="true">
                      <span class="skeleton-line skeleton-line--long"></span>
                      <span class="skeleton-line skeleton-line--medium"></span>
                    </span>
                  <% } else { %>
                    <p class="authority-suggestion-empty">No approved citation evidence is available yet.</p>
                  <% } %>
                </div>
              </section>

              <section class="authority-suggestion-context-section" aria-label="Suggested authority context">
                <span class="authority-suggestion-section-label">Suggested authority</span>
                <p class="authority-suggestion-authority">
                  <a href="/admin/knowledge/authorities/<%= suggestion.suggested_authority_id %>"><%= suggestion.suggested_authority_name %></a>
                </p>
                <p class="authority-suggestion-empty" data-context-stats <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                  <% if (suggestion.source_context_pending) { %>
                    <span class="sr-only">Loading authority stats...</span>
                    <span class="skeleton-stack" aria-hidden="true">
                      <span class="skeleton-line skeleton-line--compact"></span>
                    </span>
                  <% } else { %>
                    <%= suggestion.suggested_authority_stats_label %>
                  <% } %>
                </p>
              </section>
            </div>

            <div class="authority-suggestion-card-footer">
              <button type="button" class="btn-primary btn-sm"   data-action="approve" data-suggestion-id="<%= suggestion.id %>">Approve</button>
              <button type="button" class="btn-secondary btn-sm" data-action="reject"  data-suggestion-id="<%= suggestion.id %>">Reject</button>
              <span class="inline-error" hidden></span>
            </div>
          </article>
        <% } %>
      <% }) %>
    <% } else { %>
      <% suggestions.forEach(function(suggestion) { %>
        <article class="knowledge-citation-card authority-suggestion-card"
                 data-suggestion-id="<%= suggestion.id %>"
                 data-entity-id="<%= suggestion.entity_id %>"
                 data-exact-name-match="<%= suggestion.exact_name_match ? '1' : '0' %>"
                 data-context-pending="<%= suggestion.source_context_pending ? '1' : '0' %>">
          <div class="authority-suggestion-card-header <%= status === 'pending' ? 'authority-suggestion-card-header--selectable' : '' %>">
            <% if (status === 'pending') { %>
              <input type="checkbox" class="suggestion-cb authority-suggestion-checkbox" value="<%= suggestion.id %>">
            <% } %>
            <div class="authority-suggestion-title-group">
              <span class="authority-suggestion-kicker">Entity under review</span>
              <h2><a href="/admin/knowledge/entities/<%= suggestion.entity_id %>"><%= suggestion.entity_name %></a></h2>
              <div class="authority-suggestion-meta">
                <span class="entity-type-badge entity-type-<%= suggestion.entity_type %>"><%= suggestion.entity_type %></span>
                <span class="status-badge <%= suggestion.status === 'approved' ? 'status-done' : suggestion.status === 'rejected' ? 'status-failed' : 'status-running' %>"><%= suggestion.status %></span>
                <% if (suggestion.confidence_label) { %>
                  <span class="authority-suggestion-meta-note"><%= suggestion.confidence_label %></span>
                <% } %>
                <% if (suggestion.exact_name_match) { %>
                  <span class="authority-suggestion-signal">Exact name</span>
                <% } %>
                <% if (suggestion.match_method_label) { %>
                  <span class="authority-suggestion-meta-note"><%= suggestion.match_method_label %></span>
                <% } %>
                <% if (suggestion.current_authority_label) { %>
                  <span class="authority-suggestion-meta-note"><%= suggestion.current_authority_label %></span>
                <% } %>
              </div>
            </div>
          </div>

          <div class="authority-suggestion-context">
            <section class="authority-suggestion-context-section" aria-label="Evidence context">
              <span class="authority-suggestion-section-label">Evidence</span>
              <p class="authority-suggestion-document" data-context-document <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                <% if (suggestion.source_context_pending) { %>
                  <span class="sr-only">Loading document context...</span>
                  <span class="skeleton-stack" aria-hidden="true">
                    <span class="skeleton-line skeleton-line--short"></span>
                  </span>
                <% } else { %>
                  <%= suggestion.source_document_label %>
                <% } %>
              </p>
              <div data-context-evidence <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                <% if (suggestion.source_evidence_excerpt) { %>
                  <blockquote class="authority-suggestion-evidence"><%= suggestion.source_evidence_excerpt %></blockquote>
                <% } else if (suggestion.source_context_pending) { %>
                  <span class="sr-only">Loading approved citation evidence...</span>
                  <span class="skeleton-stack" aria-hidden="true">
                    <span class="skeleton-line skeleton-line--long"></span>
                    <span class="skeleton-line skeleton-line--medium"></span>
                  </span>
                <% } else { %>
                  <p class="authority-suggestion-empty">No approved citation evidence is available yet.</p>
                <% } %>
              </div>
            </section>

            <section class="authority-suggestion-context-section" aria-label="Suggested authority context">
              <span class="authority-suggestion-section-label">Suggested authority</span>
              <p class="authority-suggestion-authority">
                <a href="/admin/knowledge/authorities/<%= suggestion.suggested_authority_id %>"><%= suggestion.suggested_authority_name %></a>
              </p>
              <p class="authority-suggestion-empty" data-context-stats <% if (suggestion.source_context_pending) { %>aria-busy="true"<% } %>>
                <% if (suggestion.source_context_pending) { %>
                  <span class="sr-only">Loading authority stats...</span>
                  <span class="skeleton-stack" aria-hidden="true">
                    <span class="skeleton-line skeleton-line--compact"></span>
                  </span>
                <% } else { %>
                  <%= suggestion.suggested_authority_stats_label %>
                <% } %>
              </p>
            </section>
          </div>

          <% if (suggestion.status === 'pending') { %>
            <div class="authority-suggestion-card-footer">
              <button type="button" class="btn-primary btn-sm"   data-action="approve" data-suggestion-id="<%= suggestion.id %>">Approve</button>
              <button type="button" class="btn-secondary btn-sm" data-action="reject"  data-suggestion-id="<%= suggestion.id %>">Reject</button>
              <span class="inline-error" hidden></span>
            </div>
          <% } %>
        </article>
      <% }) %>
    <% } %>
  </div>

  <% if (nextCursor) { %>
    <div id="suggestions-load-more"
         data-before-created-at="<%= nextCursor.beforeCreatedAt %>"
         data-before-id="<%= nextCursor.beforeId %>"
         <% if (nextCursor.beforeExactNameMatch != null) { %>data-before-exact-name-match="<%= nextCursor.beforeExactNameMatch %>"<% } %>>
      <button type="button" class="btn-secondary">Load more</button>
    </div>
  <% } %>

  <div id="suggestions-toast" class="toast" role="status" aria-live="polite" hidden></div>
</div>

<script type="application/json" id="suggestions-bootstrap">
  <%- JSON.stringify({ status: status, matchMethodFilter: matchMethodFilter, pageSize: pageSize }) %>
</script>
<script src="/js/admin-authority-suggestions.js"></script>

<%- include('../partials/footer') %>
