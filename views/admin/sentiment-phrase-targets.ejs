<%- include('../partials/header', { pageTitle: 'Phrase Targets', query: '' }) %>

<div class="admin-page admin-page--workspace">
  <%- include('../partials/admin-nav') %>

  <div class="admin-header">
    <h1>Phrase Targets</h1>
    <p class="subtitle">Aggregated sentiment-annotation phrase targets that aren't yet modeled as entities. Promote real entities, suppress non-entity phrases.</p>
  </div>

  <%- include('../partials/knowledge-nav', { activeKnowledgePage }) %>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (saved) { %><div class="alert alert-success">Update applied.</div><% } %>

  <div class="filter-tabs">
    <a href="/admin/knowledge/sentiment/phrase-targets?tab=active"
       class="filter-tab <%= tab === 'active' ? 'active' : '' %>">Active (<%= tab === 'active' ? aggregated.length : '…' %>)</a>
    <a href="/admin/knowledge/sentiment/phrase-targets?tab=suppressed"
       class="filter-tab <%= tab === 'suppressed' ? 'active' : '' %>">Suppressed (<%= tab === 'suppressed' ? suppressed.length : '…' %>)</a>
  </div>

  <% if (tab === 'active') { %>
    <section class="settings-section">
      <form method="GET" action="/admin/knowledge/sentiment/phrase-targets" class="knowledge-toolbar knowledge-toolbar--spaced">
        <input type="hidden" name="tab" value="active">
        <div class="edit-field">
          <label for="phrase-q">Search</label>
          <input type="search" id="phrase-q" name="q" value="<%= q || '' %>" placeholder="Phrase text">
        </div>
        <div class="edit-field">
          <label for="phrase-collection">Collection</label>
          <select id="phrase-collection" name="collectionId">
            <option value="">All collections</option>
            <% (collections || []).forEach(function(c) { %>
              <option value="<%= c.id %>" <%= String(collectionId || '') === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="edit-field">
          <label for="phrase-polarity">Polarity</label>
          <select id="phrase-polarity" name="polarity">
            <option value="">All</option>
            <% ['positive', 'negative', 'neutral', 'mixed'].forEach(function(p) { %>
              <option value="<%= p %>" <%= polarity === p ? 'selected' : '' %>><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div class="edit-field">
          <label for="phrase-min-frequency">Min frequency</label>
          <input type="number" id="phrase-min-frequency" name="minFrequency" min="1" value="<%= minFrequency %>">
        </div>
        <div class="edit-actions">
          <button type="submit" class="btn-secondary btn-sm">Filter</button>
        </div>
      </form>

      <% if (!aggregated.length) { %>
        <div class="empty-state">
          <p>No active phrase targets right now.</p>
          <p class="muted">Either every phrase has been promoted or suppressed, or sentiment extraction hasn't produced phrase-target annotations yet.</p>
        </div>
      <% } else { %>
      <div class="workflows-table-wrap">
        <table class="workflows-table">
          <thead>
            <tr>
              <th scope="col">Phrase</th>
              <th scope="col">Frequency</th>
              <th scope="col">Polarity (+ / – / ~ / mixed)</th>
              <th scope="col">Samples</th>
              <th scope="col">Suggested type</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% aggregated.forEach(function(p) { %>
              <tr>
                <td><code><%= p.phraseDisplay %></code></td>
                <td><%= p.frequency %></td>
                <td>
                  <span title="positive"><%= p.polarity.positive %></span> /
                  <span title="negative"><%= p.polarity.negative %></span> /
                  <span title="neutral"><%= p.polarity.neutral %></span> /
                  <span title="mixed"><%= p.polarity.mixed %></span>
                </td>
                <td>
                  <% if (p.samples.length) { %>
                    <details>
                      <summary><%= p.samples.length %> sample<%= p.samples.length === 1 ? '' : 's' %></summary>
                      <ul class="muted">
                        <% p.samples.forEach(function(s) { %>
                          <li><%= (s.evidence_excerpt || '').slice(0, 120) %><%= (s.evidence_excerpt || '').length > 120 ? '…' : '' %></li>
                        <% }) %>
                      </ul>
                    </details>
                  <% } %>
                </td>
                <td><span class="status-badge status-trace"><%= p.suggestedType %></span></td>
                <td class="col-actions">
                  <div class="table-actions">
                    <details class="toolbar-details">
                      <summary class="btn-primary btn-sm">Promote to entity</summary>
                      <div class="toolbar-details-menu">
                        <form method="POST" action="/admin/knowledge/sentiment/phrase-targets/promote" class="edit-form" style="padding: 12px;">
	                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
	                          <input type="hidden" name="phrase" value="<%= p.phraseDisplay %>">
	                          <input type="hidden" name="phrase_normalized" value="<%= p.phraseNormalized %>">
	                          <input type="hidden" name="collectionId" value="<%= collectionId || '' %>">
	                          <input type="hidden" name="polarity" value="<%= polarity || '' %>">
                          <div class="edit-field">
                            <label>Entity type</label>
                            <select name="entity_type">
                              <% ['person', 'place', 'event', 'organization', 'topic', 'artifact', 'claim', 'role'].forEach(function(t) { %>
                                <option value="<%= t %>" <%= t === p.suggestedType ? 'selected' : '' %>><%= t %></option>
                              <% }) %>
                            </select>
                          </div>
                          <div class="edit-field">
                            <label>Canonical name</label>
                            <input type="text" name="canonical_name" required value="<%= p.phraseDisplay %>">
                          </div>
                          <div class="edit-actions">
                            <button type="submit" class="btn-primary btn-sm">Create entity + re-target <%= p.frequency %> annotation<%= p.frequency === 1 ? '' : 's' %></button>
                          </div>
                        </form>
                        <form method="POST" action="/admin/knowledge/sentiment/phrase-targets/promote-existing" class="edit-form" style="padding: 12px;">
	                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
	                          <input type="hidden" name="phrase" value="<%= p.phraseDisplay %>">
	                          <input type="hidden" name="phrase_normalized" value="<%= p.phraseNormalized %>">
	                          <input type="hidden" name="collectionId" value="<%= collectionId || '' %>">
	                          <input type="hidden" name="polarity" value="<%= polarity || '' %>">
                          <div class="edit-field">
                            <label for="tp-existing-<%= p.phraseNormalized.replace(/[^a-z0-9_-]/gi, '-') %>-search">Existing entity</label>
                            <%- include('../partials/typeahead-picker', {
                              name: 'entity_id',
                              searchUrl: '/admin/knowledge/entities/api/search',
                              placeholder: 'Search entities by canonical name...',
                              selectedId: null,
                              selectedLabel: '',
                              required: true,
                              id: 'tp-existing-' + p.phraseNormalized.replace(/[^a-z0-9_-]/gi, '-')
                            }) %>
                          </div>
                          <div class="edit-actions">
                            <button type="submit" class="btn-secondary btn-sm">Re-target to existing entity</button>
                          </div>
                        </form>
                      </div>
                    </details>
                    <form method="POST" action="/admin/knowledge/sentiment/phrase-targets/suppressions" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="phrase" value="<%= p.phraseDisplay %>">
                      <button type="submit" class="btn-secondary btn-sm">Suppress</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%
        function phrasePageHref(targetPage) {
          var params = new URLSearchParams();
          params.set('tab', 'active');
          if (q) params.set('q', q);
          if (collectionId) params.set('collectionId', collectionId);
          if (polarity) params.set('polarity', polarity);
          if (minFrequency && minFrequency !== 1) params.set('minFrequency', minFrequency);
          params.set('page', targetPage);
          return '/admin/knowledge/sentiment/phrase-targets?' + params.toString();
        }
      %>
      <% if (totalPages > 1) { %>
        <nav class="pagination">
          <% if (page > 1) { %><a class="btn-secondary btn-sm" href="<%= phrasePageHref(page - 1) %>">Previous</a><% } %>
          <span class="muted">Page <%= page %> of <%= totalPages %> · <%= totalCount %> phrases</span>
          <% if (page < totalPages) { %><a class="btn-secondary btn-sm" href="<%= phrasePageHref(page + 1) %>">Next</a><% } %>
        </nav>
      <% } %>
      <% } %>
    </section>
  <% } else { %>
    <section class="settings-section">
      <% if (!suppressed.length) { %>
        <div class="empty-state">
          <p>No suppressed phrases.</p>
          <p class="muted">Suppress a phrase from the Active tab when you've decided it's not entity-worthy.</p>
        </div>
      <% } else { %>
      <div class="workflows-table-wrap">
        <table class="workflows-table">
          <thead>
            <tr>
              <th scope="col">Phrase</th>
              <th scope="col">Notes</th>
              <th scope="col">Suppressed at</th>
              <th scope="col" class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% suppressed.forEach(function(s) { %>
              <tr>
                <td><code><%= s.target_phrase_display %></code></td>
                <td><%= s.notes || '' %></td>
                <td><%= s.created_at %></td>
                <td class="col-actions">
                  <div class="table-actions">
                    <form method="POST" action="/admin/knowledge/sentiment/phrase-targets/suppressions/<%= s.id %>/delete" class="inline-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn-danger btn-sm">Remove suppression</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
  <% } %>
</div>

<script src="/js/typeahead-picker.js"></script>
<%- include('../partials/footer') %>
