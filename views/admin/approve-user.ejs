<%- include('../partials/header', { pageTitle: pageTitle, query: '' }) %>

<div class="admin-page admin-page--workspace">
  <div class="admin-header">
    <a href="/admin/users" class="back-link">&larr; Back to Users</a>
    <h1><%= editMode ? 'Edit Access' : 'Approve Account' %></h1>
    <p class="subtitle">
      <% if (editMode) { %>
        Update role and collection access for <strong><%= approveUser.username %></strong>
      <% } else { %>
        Review and approve the account request from <strong><%= approveUser.username %></strong>
        <% if (approveUser.email) { %><span class="muted"> &lt;<%= approveUser.email %>&gt;</span><% } %>
      <% } %>
    </p>
  </div>

  <div class="settings-section">
    <form method="POST" action="/admin/users/<%= approveUser.id %>/<%= editMode ? 'access' : 'approve' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <h2>Role</h2>
      <div class="role-choice">
        <label class="role-option">
          <input type="radio" name="role" value="user"
            <%= (!editMode || approveUser.role !== 'admin') ? 'checked' : '' %>>
          <span class="role-option-label">
            <strong>User</strong>
            <small>Can view documents, read transcripts, and add annotations.</small>
          </span>
        </label>
        <label class="role-option">
          <input type="radio" name="role" value="admin"
            <%= (editMode && approveUser.role === 'admin') ? 'checked' : '' %>>
          <span class="role-option-label">
            <strong>Admin</strong>
            <small>Full access: import documents, manage settings, approve users.</small>
          </span>
        </label>
      </div>

      <h2 class="admin-heading-spacer">Collection Access</h2>

      <label class="role-option access-all-option role-option--panel role-option--panel-spaced">
        <input type="checkbox" name="can_use_system_api_keys" value="1"
          <%= (editMode ? (approveUser.can_use_system_api_keys || approveUser.role === 'admin') : approveUser.role === 'admin') ? 'checked' : '' %>>
        <span class="role-option-label">
          <strong>Can use system AI API keys</strong>
          <small>Allows this account to run AI transcriptions using provider keys configured globally in Admin Settings.</small>
        </span>
      </label>

      <% if (allCollections.length === 0) { %>
        <p class="field-hint field-hint--mb-md">
          No collections exist yet. <a href="/admin/collections">Create collections first</a>, then return to set access.
          Granting "All collections" will give access to everything including future collections.
        </p>
      <% } %>

      <label class="role-option access-all-option role-option--panel role-option--panel-spaced">
        <input type="checkbox" name="access_all" value="1" id="access-all-cb"
          <%= (editMode && approveUser.access_all) ? 'checked' : '' %>>
        <span class="role-option-label">
          <strong>All collections</strong>
          <small>Grants <em>view-only</em> access to every current and future collection. Use per-collection roles below for Editor or Manager access.</small>
        </span>
      </label>

      <% if (allCollections.length > 0) { %>
        <div id="collection-list" class="collection-access-list">
          <p class="field-hint field-hint--mt-md field-hint--mb-sm">Or select specific collections and set their role:</p>
          <% allCollections.forEach(function(c) { %>
            <%
              const isGranted = editMode && grantedIds && grantedIds.includes(c.id);
              const grantedRole = (typeof grantedRoles !== 'undefined' && grantedRoles && grantedRoles[c.id]) ? grantedRoles[c.id] : 'viewer';
            %>
            <label class="collection-access-item collection-access-item--panel">
              <input type="checkbox" name="collections" value="<%= c.id %>" <%= isGranted ? 'checked' : '' %>>
              <span class="collection-access-item__label">
                <strong><%= c.name %></strong>
                <% if (c.description) { %><small class="muted"> — <%= c.description %></small><% } %>
                <small class="muted"> (<%= c.document_count %> doc<%= c.document_count !== 1 ? 's' : '' %>)</small>
              </span>
              <select name="collection_role_<%= c.id %>" class="collection-access-role-select">
                <option value="viewer" <%= grantedRole === 'viewer' ? 'selected' : '' %>>Viewer</option>
                <option value="editor" <%= grantedRole === 'editor' ? 'selected' : '' %>>Editor</option>
                <option value="manager" <%= grantedRole === 'manager' ? 'selected' : '' %>>Manager</option>
              </select>
            </label>
          <% }) %>
        </div>
      <% } %>

      <div class="form-actions form-actions--mt-lg">
        <a href="/admin/users" class="btn-secondary">Cancel</a>
        <button type="submit" class="btn-primary">
          <%= editMode ? 'Save Changes' : 'Approve Account' %>
        </button>
        <% if (!editMode) { %>
          <button type="submit" form="reject-form" class="btn-danger ml-auto">
            Reject Request
          </button>
        <% } %>
      </div>
    </form>

    <% if (!editMode) { %>
      <form id="reject-form" class="is-hidden" method="POST" action="/admin/users/<%= approveUser.id %>/reject"
            data-confirm-message="Reject <%= approveUser.username %>&apos;s account request?">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      </form>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
